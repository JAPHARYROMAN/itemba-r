# API Configuration
# Server-side internal URL — used by Next.js route handlers (proxy + auth).
# MUST include the API prefix (e.g. /api/v1). Talks directly to the backend
# (over Docker bridge in production, localhost in dev).
BACKEND_INTERNAL_URL=http://localhost:3001/api/v1

# Browser-public URL — only used by client-side code that needs an absolute
# backend URL. Most browser calls go through the /api/backend/* proxy and do
# NOT need this. Keep this aligned with BACKEND_INTERNAL_URL in dev.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WEBSITE_URL=https://itembagrouptz.com
# ITEMBA OS desktop shell. Off unless exactly "true"; restart `next dev` after changing.
NEXT_PUBLIC_ITEMBA_OS_ENABLED=true
# Auth cookie Max-Age in seconds. 315360000 (ten years) is also the built-in
# default and what the production and staging examples use. Lower it for
# shorter-lived cookies.
AUTH_COOKIE_MAX_AGE_SECONDS=315360000

# Independent Fuel Grid application. Server-only runtime configuration.
# Leave FUELGRID_APP_URL empty and the launcher shows "not configured". Set it to
# the Fuel Grid app URL to enable the launcher; FUELGRID_HEALTH_URL is only needed
# when the health endpoint differs (it falls back to the app URL).
FUELGRID_APP_URL=
FUELGRID_HEALTH_URL=

# App
NEXT_PUBLIC_APP_NAME=ITEMBA-R
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_PERFORMANCE_DASHBOARD=true
NEXT_PUBLIC_ENABLE_DATA_ISOLATION=true
