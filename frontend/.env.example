# API Configuration
# Server-side internal URL — used by Next.js route handlers (proxy + auth).
# MUST include the API prefix (e.g. /api/v1). Talks directly to the backend
# (over Docker bridge in production, localhost in dev).
BACKEND_INTERNAL_URL=http://localhost:3001/api/v1

# Browser-public URL — only used by client-side code that needs an absolute
# backend URL. Most browser calls go through the /api/backend/* proxy and do
# NOT need this. Keep this aligned with BACKEND_INTERNAL_URL in dev.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WEBSITE_URL=https://itembagrouptz.com

# App
NEXT_PUBLIC_APP_NAME=ITEMBA-R
NEXT_PUBLIC_APP_VERSION=1.0.0

# Feature Flags
NEXT_PUBLIC_ENABLE_PERFORMANCE_DASHBOARD=true
NEXT_PUBLIC_ENABLE_DATA_ISOLATION=true
