# =================================================================
# ITEMBA-R Frontend — Production Environment Variables
# Copy to .env.production.local and fill in real values
# NEVER commit .env.production.local to version control
# =================================================================

# Server-side internal URL — Next.js route handlers (proxy + auth) call this
# directly over the Docker bridge. MUST include the API prefix (e.g. /api/v1).
BACKEND_INTERNAL_URL=http://backend:3001/api/v1

# Browser-public URL — only used by client-side code that needs an absolute
# backend URL. Most browser traffic goes through the /api/backend/* proxy.
NEXT_PUBLIC_API_URL=https://api.itemba-r.co.tz/api/v1

# Application metadata
NEXT_PUBLIC_APP_NAME=ITEMBA-R
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_COMPANY_NAME=Itemba Group

# Feature flags
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_MOBILE_APP=false
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Telemetry (disable Next.js telemetry in production)
NEXT_TELEMETRY_DISABLED=1
