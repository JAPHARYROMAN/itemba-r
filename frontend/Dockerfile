# Dependencies
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

# Builder
FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG BACKEND_INTERNAL_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WEBSITE_URL
ARG NEXT_PUBLIC_ITEMBA_OS_ENABLED=false
ARG AUTH_COOKIE_MAX_AGE_SECONDS
# Short commit for the version shown in the POS settings; the context has no .git.
ARG APP_BUILD_SHA
ENV NEXT_TELEMETRY_DISABLED=1
ENV APP_BUILD_SHA=$APP_BUILD_SHA
ENV BACKEND_INTERNAL_URL=$BACKEND_INTERNAL_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WEBSITE_URL=$NEXT_PUBLIC_WEBSITE_URL
ENV NEXT_PUBLIC_ITEMBA_OS_ENABLED=$NEXT_PUBLIC_ITEMBA_OS_ENABLED
ENV AUTH_COOKIE_MAX_AGE_SECONDS=$AUTH_COOKIE_MAX_AGE_SECONDS
RUN test -n "$BACKEND_INTERNAL_URL" \
  && test -n "$NEXT_PUBLIC_API_URL" \
  && test -n "$NEXT_PUBLIC_WEBSITE_URL" \
  && mkdir -p public \
  && npm run build

# Runner
FROM node:22-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ARG BACKEND_INTERNAL_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_WEBSITE_URL
ARG NEXT_PUBLIC_ITEMBA_OS_ENABLED=false
ARG AUTH_COOKIE_MAX_AGE_SECONDS
ENV BACKEND_INTERNAL_URL=$BACKEND_INTERNAL_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_WEBSITE_URL=$NEXT_PUBLIC_WEBSITE_URL
ENV NEXT_PUBLIC_ITEMBA_OS_ENABLED=$NEXT_PUBLIC_ITEMBA_OS_ENABLED
ENV AUTH_COOKIE_MAX_AGE_SECONDS=$AUTH_COOKIE_MAX_AGE_SECONDS
RUN groupadd --system --gid 1001 nodejs && useradd --system --uid 1001 --gid nodejs nextjs
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
