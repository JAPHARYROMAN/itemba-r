<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <AssemblyName>Itemba.Msaidizi.Installer.Hardening</AssemblyName>
    <RootNamespace>Itemba.Msaidizi.Installer.Hardening</RootNamespace>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)..\..\..\locks\hardening.packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Itemba.Msaidizi.Installer.Hardening.Tests" />
    <EmbeddedResource Include="..\..\config\service\appsettings.json"
                      LogicalName="Itemba.Msaidizi.InstallerDefaults.service.appsettings.json" />
    <EmbeddedResource Include="..\..\config\agent\appsettings.json"
                      LogicalName="Itemba.Msaidizi.InstallerDefaults.agent.appsettings.json" />
    <EmbeddedResource Include="..\..\config\update\appsettings.json"
                      LogicalName="Itemba.Msaidizi.InstallerDefaults.update.appsettings.json" />
    <EmbeddedResource Include="..\..\config\recovery\appsettings.json"
                      LogicalName="Itemba.Msaidizi.InstallerDefaults.recovery.appsettings.json" />
    <EmbeddedResource Include="..\..\config\audit-signer\appsettings.json"
                      LogicalName="Itemba.Msaidizi.InstallerDefaults.audit-signer.appsettings.json" />
    <EmbeddedResource Include="..\..\config\egress-supervisor\appsettings.json"
                      LogicalName="Itemba.Msaidizi.InstallerDefaults.egress-supervisor.appsettings.json" />
    <EmbeddedResource Include="..\..\config\privileged-command-supervisor\appsettings.json"
                      LogicalName="Itemba.Msaidizi.InstallerDefaults.privileged-command-supervisor.appsettings.json" />
  </ItemGroup>
</Project>
