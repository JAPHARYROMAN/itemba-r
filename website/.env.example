# Runtime: read per request, pass at `docker run -e` (DEPLOY.md §1).
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=info@itembagrouptz.com
ENQUIRY_EMAIL_FROM=Itemba Group Website <website@itembagrouptz.com>
# Where enquiries.jsonl is appended: the container's data volume
# (Dockerfile: VOLUME /app/data), which is also the default there
# (process.cwd()/data). For `npm run dev`, leave it unset to write ./data.
ENQUIRY_STORAGE_DIR=/app/data

# Build time: inlined into the build, pass as `docker build --build-arg`.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
GOOGLE_SITE_VERIFICATION=
