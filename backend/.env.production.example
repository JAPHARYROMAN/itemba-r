# =================================================================
# ITEMBA-R Backend — Production Environment Variables
# Copy this file to .env.production and fill in real values
# NEVER commit .env.production to version control
# =================================================================

# Application
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# ---------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------
DATABASE_URL=postgresql://itemba_user:STRONG_PASSWORD_HERE@db-host:5432/itemba_r_prod?schema=public&sslmode=require
POSTGRES_USER=itemba_user
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=itemba_r_prod

# ---------------------------------------------------------------
# JWT Authentication
# IMPORTANT: Use 64+ character random strings. Generate with:
#   openssl rand -hex 32
# ---------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING_DO_NOT_USE_THIS_DEFAULT
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING_DO_NOT_USE_DEFAULT
JWT_ACCESS_EXPIRES_IN=never
JWT_REFRESH_EXPIRES_IN=never
REFRESH_TOKEN_PEPPER=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
COOKIE_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
TWO_FACTOR_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
# P1-04: dedicated field-level encryption key for EncryptionService.
# MUST be distinct from JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, and
# TWO_FACTOR_ENCRYPTION_KEY — env validation refuses to boot otherwise.
APP_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING_FOR_FIELD_ENC

# P0-06: BackgroundJob worker activation. Production should be true so
# DATA_EXPORT / BACKUP_RUN / NOTIFICATION_DISPATCH jobs are actually executed.
JOB_WORKER_ENABLED=true

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Account lockout
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
ALLOW_PUBLIC_REGISTRATION=false

# ---------------------------------------------------------------
# CORS
# ---------------------------------------------------------------
FRONTEND_URL=https://app.itembagrouptz.com
APP_URL=https://app.itembagrouptz.com
CORS_ORIGIN=https://app.itembagrouptz.com,https://itembagrouptz.com,https://www.itembagrouptz.com

# ---------------------------------------------------------------
# SMTP Email
# ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@itembagrouptz.com
SMTP_PASS=YOUR_SMTP_APP_PASSWORD
SMTP_FROM="ITEMBA-R System <info@itembagrouptz.com>"

# ---------------------------------------------------------------
# Redis Cache
# ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE
REDIS_TTL=300

# ---------------------------------------------------------------
# Frontend / Docker Compose
# ---------------------------------------------------------------
BACKEND_INTERNAL_URL=http://backend:3001/api/v1
NEXT_PUBLIC_API_URL=https://api.itembagrouptz.com/api/v1
NEXT_PUBLIC_WEBSITE_URL=https://itembagrouptz.com

# ---------------------------------------------------------------
# File Storage
# ---------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage
EXPORTS_DIR=/app/exports
# For S3-compatible object storage (uncomment when ready):
# STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=YOUR_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET
# AWS_REGION=af-south-1
# AWS_S3_BUCKET=itemba-r-files-prod
# AWS_S3_ENDPOINT=https://s3.af-south-1.amazonaws.com

# ---------------------------------------------------------------
# Africa's Talking (SMS/USSD)
# ---------------------------------------------------------------
AT_API_KEY=YOUR_AT_API_KEY
AT_USERNAME=YOUR_AT_USERNAME
AT_SENDER_ID=ITEMBA-R
AT_ENVIRONMENT=production

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
LOG_LEVEL=warn
LOG_FILE_PATH=/app/logs
LOG_MAX_FILES=30d
LOG_MAX_SIZE=20m

# ---------------------------------------------------------------
# Backup
# ---------------------------------------------------------------
BACKUP_STORAGE_PATH=/app/backups
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPT=true
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_KEY

# ---------------------------------------------------------------
# System
# ---------------------------------------------------------------
SUPPORT_EMAIL=support@itembagrouptz.com
ADMIN_EMAIL=admin@itembagrouptz.com
SYSTEM_NAME=ITEMBA-R
COMPANY_GROUP_NAME=Itemba Group

# ---------------------------------------------------------------
# Msaidizi model and durable autonomy (all authority flags default OFF)
# ---------------------------------------------------------------
MSAIDIZI_ENABLED=false
ANTHROPIC_API_KEY=REPLACE_WITH_SECRET_STORE_REFERENCE
MSAIDIZI_WRITE_MODE=read-only
MSAIDIZI_MODEL=claude-opus-5
# Not yet called by any pre-filter, but attested: the signed provider contract
# must cover this model ID as well as MSAIDIZI_MODEL.
MSAIDIZI_CLASSIFIER_MODEL=claude-haiku-4-5
MSAIDIZI_EFFORT=medium
MSAIDIZI_MAX_WRITES_PER_RUN=10
MSAIDIZI_MAX_TOOL_CALLS=40
MSAIDIZI_MAX_TOKENS=32000
MSAIDIZI_INVOKE_TIMEOUT_MS=30000
# Attempts for one provider turn, retries included. Only failures that decided
# nothing are retried; a refusal or validation error is a settled answer.
MSAIDIZI_MODEL_MAX_ATTEMPTS=3
MSAIDIZI_MODEL_RETRY_BASE_DELAY_MS=500
MSAIDIZI_MODEL_RETRY_MAX_DELAY_MS=8000
MSAIDIZI_TOOL_SEARCH=false
MSAIDIZI_AUTONOMY_ENABLED=false
MSAIDIZI_TASK_WORKER_ENABLED=false
MSAIDIZI_AUTOPILOT_ENABLED=false
MSAIDIZI_HOST_EXECUTION_ENABLED=false
MSAIDIZI_GLOBAL_KILL_SWITCH=false
MSAIDIZI_AUTONOMY_PRINCIPAL_KEY=global-msaidizi
# Empty means the global service principal can plan but cannot execute ERP
# operations. A `*` grant must be an explicit deployment-owner decision.
MSAIDIZI_AUTONOMY_GRANTS=
MSAIDIZI_TASK_TOKEN_TTL_SECONDS=120
MSAIDIZI_TASK_DISPATCH_INTERVAL_MS=2000
MSAIDIZI_AUTONOMY_MAX_WALL_SECONDS=7200
MSAIDIZI_AUTONOMY_MAX_MODEL_TURNS=200
MSAIDIZI_AUTONOMY_MAX_TOOL_ATTEMPTS=500
MSAIDIZI_AUTONOMY_MAX_MUTATIONS=100
MSAIDIZI_AUTONOMY_MAX_LOCAL_BYTES=5368709120
MSAIDIZI_AUTONOMY_MAX_EGRESS_BYTES=262144000
MSAIDIZI_AUTONOMY_MAX_MODEL_COST_USD=20
MSAIDIZI_ADAPTIVE_REASONING_ENABLED=false
MSAIDIZI_ADAPTIVE_REASONING_MAX_INPUT_BYTES=65536
MSAIDIZI_ADAPTIVE_REASONING_MAX_OUTPUT_TOKENS=2048
MSAIDIZI_MODEL_INPUT_USD_PER_MILLION_TOKENS=30
MSAIDIZI_MODEL_OUTPUT_USD_PER_MILLION_TOKENS=150
# Conservative cache rates: the task ledger charges all input/cache units at
# the highest configured input-side rate to prevent cache-premium undercount.
MSAIDIZI_MODEL_CACHE_READ_USD_PER_MILLION_TOKENS=30
MSAIDIZI_MODEL_CACHE_CREATION_USD_PER_MILLION_TOKENS=37.5
# Proposal generation spends model budget before a task exists. Keep this
# rolling per-user/company quota deployment-owned; zero turns or cost denies all
# proposal-model calls without affecting manually authored plans.
MSAIDIZI_PROPOSAL_MAX_INPUT_TOKENS_PER_TURN=200000
MSAIDIZI_PROPOSAL_QUOTA_WINDOW_SECONDS=3600
MSAIDIZI_PROPOSAL_MAX_MODEL_TURNS_PER_WINDOW=200
MSAIDIZI_PROPOSAL_MAX_COST_USD_PER_WINDOW=20
MSAIDIZI_PROPOSAL_RECEIPT_TTL_SECONDS=86400
MSAIDIZI_PROPOSAL_RESERVATION_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------
# Msaidizi Windows device broker (all execution flags default OFF)
# ---------------------------------------------------------------
MSAIDIZI_DEVICE_PAIRING_ENABLED=false
MSAIDIZI_DEVICE_CHANNEL_ENABLED=false
MSAIDIZI_DIRECT_MTLS_ENABLED=false
MSAIDIZI_DIRECT_MTLS_PORT=3443
MSAIDIZI_DIRECT_MTLS_BIND_ADDRESS=0.0.0.0
MSAIDIZI_SUPERVISOR_ENROLLMENT_ENABLED=false
MSAIDIZI_UPDATE_SUPERVISOR_ENABLED=false
MSAIDIZI_UPDATE_AUTOMATIC_ROLLOUT_ENABLED=false
MSAIDIZI_UPDATE_AUTOMATIC_MAX_RING=-1
MSAIDIZI_UPDATE_ROLLOUT_SWEEP_SECONDS=15
MSAIDIZI_RECOVERY_SUPERVISOR_ENABLED=false
MSAIDIZI_AUDIT_SIGNER_ENABLED=false
MSAIDIZI_AUDIT_SIGNER_KILL_SWITCH=false
MSAIDIZI_UPDATE_EVALUATOR_ENABLED=false
# Operator-owned, external, read-only registry. Never place evaluator private
# keys in this service, its database, image, repository, or environment.
MSAIDIZI_EVALUATOR_KEY_ALLOWLIST_PATH=/run/secrets/msaidizi-evaluator-keys.json
MSAIDIZI_EVALUATOR_KEY_ALLOWLIST_SHA256=REPLACE_WITH_LOWERCASE_REGISTRY_SHA256
MSAIDIZI_EVALUATOR_MAX_CLOCK_SKEW_SECONDS=60
MSAIDIZI_EVALUATOR_MAX_ATTESTATION_AGE_SECONDS=86400
MSAIDIZI_EVALUATOR_MTLS_ENABLED=false
MSAIDIZI_EVALUATOR_MTLS_PORT=3444
# Direct process bind; Compose uses the separate container and host values.
MSAIDIZI_EVALUATOR_MTLS_BIND_ADDRESS=127.0.0.1
MSAIDIZI_EVALUATOR_MTLS_CONTAINER_BIND_ADDRESS=0.0.0.0
MSAIDIZI_EVALUATOR_MTLS_HOST_BIND_ADDRESS=127.0.0.1
MSAIDIZI_EVALUATOR_MTLS_SERVER_KEY_PATH=/run/secrets/msaidizi-evaluator-server-key.pem
MSAIDIZI_EVALUATOR_MTLS_SERVER_CERT_PATH=/run/secrets/msaidizi-evaluator-server-cert.pem
MSAIDIZI_EVALUATOR_MTLS_CLIENT_CA_PATH=/run/secrets/msaidizi-evaluator-client-ca.pem
MSAIDIZI_EVALUATOR_CLIENT_CERT_SHA256=REPLACE_WITH_LOWERCASE_LEAF_CERT_SHA256
MSAIDIZI_EVALUATOR_CLIENT_SPKI_SHA256=REPLACE_WITH_LOWERCASE_DER_SPKI_SHA256
# Required before enabling Msaidizi, durable reasoning, Autopilot, or host
# execution. Files are operator-owned, immutable, outside the application tree.
# The signed evidence binds https://api.anthropic.com and a legal document via
# urn:sha256:<document digest> and the opaque secret-manager version/key ID
# selecting ANTHROPIC_API_KEY. Rotate that ID whenever the secret changes.
# Anthropic SDK routing/auth/header/log/profile environment overrides are
# rejected; only ANTHROPIC_API_KEY supplies auth.
MSAIDIZI_PROVIDER_CONTRACT_ATTESTATION_PATH=/run/msaidizi-provider-contract/attestation.json
MSAIDIZI_PROVIDER_CONTRACT_PUBLIC_KEY_PATH=/run/msaidizi-provider-contract/public.pem
MSAIDIZI_PROVIDER_CONTRACT_KEY_ID=REPLACE_WITH_PINNED_PROVIDER_CONTRACT_KEY_ID
MSAIDIZI_PROVIDER_CONTRACT_ATTESTATION_SHA256=REPLACE_WITH_LOWERCASE_ATTESTATION_SHA256
MSAIDIZI_PROVIDER_CONTRACT_SIGNER_SPKI_SHA256=REPLACE_WITH_LOWERCASE_DER_SPKI_SHA256
MSAIDIZI_PROVIDER_ACCOUNT_ID=REPLACE_WITH_EXACT_ANTHROPIC_ACCOUNT_OR_ORGANIZATION_ID
MSAIDIZI_PROVIDER_CREDENTIAL_KEY_ID=REPLACE_WITH_SECRET_MANAGER_VERSION_OR_KEY_ID
MSAIDIZI_DEVICE_PAIRING_PEPPER=REPLACE_WITH_A_RANDOM_PAIRING_PEPPER_FROM_SECRET_STORE
MSAIDIZI_DEVICE_LEASE_PEPPER=REPLACE_WITH_A_DIFFERENT_RANDOM_LEASE_PEPPER_FROM_SECRET_STORE
MSAIDIZI_SUPERVISOR_ENROLLMENT_PEPPER=REPLACE_WITH_A_THIRD_RANDOM_ENROLLMENT_PEPPER_FROM_SECRET_STORE
MSAIDIZI_ACTION_SIGNING_KEY_PATH=/run/secrets/msaidizi-action-es256.pem
MSAIDIZI_ACTION_SIGNING_KEY_ID=REPLACE_WITH_WINDOWS_TRUSTED_CERTIFICATE_KEY_ID
MSAIDIZI_UPDATE_SIGNING_KEY_PATH=/run/secrets/msaidizi-update-es256.pem
MSAIDIZI_UPDATE_SIGNING_KEY_ID=REPLACE_WITH_PINNED_BOOTSTRAP_KEY_ID
MSAIDIZI_RECOVERY_SIGNING_KEY_PATH=/run/secrets/msaidizi-recovery-es256.pem
MSAIDIZI_RECOVERY_SIGNING_KEY_ID=REPLACE_WITH_PINNED_RECOVERY_KEY_ID
MSAIDIZI_AUDIT_SIGNER_KEY_ID=REPLACE_WITH_PINNED_AUDIT_SIGNER_KEY_ID
MSAIDIZI_AUDIT_SIGNER_CLIENT_CERT_SHA256=REPLACE_WITH_LOWERCASE_CERT_SHA256
MSAIDIZI_AUDIT_SIGNER_CLIENT_SPKI_SHA256=REPLACE_WITH_LOWERCASE_SPKI_SHA256
MSAIDIZI_AUDIT_SIGNER_MAX_SEGMENT_EVENTS=256
MSAIDIZI_AUDIT_SIGNER_CHECKPOINT_TTL_SECONDS=300
MSAIDIZI_AUDIT_SIGNER_MAX_CLOCK_SKEW_SECONDS=30
MSAIDIZI_DIRECT_MTLS_SERVER_KEY_PATH=/run/secrets/msaidizi-device-server-key.pem
MSAIDIZI_DIRECT_MTLS_SERVER_CERT_PATH=/run/secrets/msaidizi-device-server-cert.pem
MSAIDIZI_DIRECT_MTLS_CLIENT_CA_PATH=/run/secrets/msaidizi-device-client-ca.pem
MSAIDIZI_ACTION_TOKEN_ISSUER=itemba-msaidizi-broker
MSAIDIZI_ACTION_TOKEN_AUDIENCE=itemba-windows-companion
MSAIDIZI_ACTION_TOKEN_SUBJECT=msaidizi-global
MSAIDIZI_ACTION_TOKEN_TTL_SECONDS=120
MSAIDIZI_DEVICE_PAIRING_TTL_SECONDS=300
MSAIDIZI_SUPERVISOR_ENROLLMENT_TTL_SECONDS=300
MSAIDIZI_DEVICE_LEASE_TTL_SECONDS=90
MSAIDIZI_DEVICE_REDELIVERY_SECONDS=15
MSAIDIZI_UPDATE_MANIFEST_TTL_SECONDS=600
MSAIDIZI_UPDATE_REDELIVERY_SECONDS=30
MSAIDIZI_UPDATE_HEALTH_TIMEOUT_SECONDS=600
MSAIDIZI_UPDATE_MIN_HEALTHY_SOAK_SECONDS=300
MSAIDIZI_UPDATE_RING_0_MIN_DWELL_SECONDS=86400
MSAIDIZI_UPDATE_RING_5_MIN_DWELL_SECONDS=86400
MSAIDIZI_UPDATE_RING_25_MIN_DWELL_SECONDS=172800
MSAIDIZI_UPDATE_RING_100_MIN_DWELL_SECONDS=259200
MSAIDIZI_RECOVERY_MANIFEST_TTL_SECONDS=600
MSAIDIZI_RECOVERY_REDELIVERY_SECONDS=30

# Generate 32 random bytes, Base64 encode them, and inject the value through
# the deployment secret store. The artifact root must be a persistent volume.
MSAIDIZI_ARTIFACT_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_SECRET
MSAIDIZI_ARTIFACT_ROOT=/app/storage/msaidizi-artifacts

# Signed, disposable-database CRUD execution evidence. Keep the signing private
# key in CI only; production receives the artifact and public verification key.
# MSAIDIZI_CRUD_EVIDENCE_PATH=/run/msaidizi/crud-evidence.json
# MSAIDIZI_CRUD_EVIDENCE_PUBLIC_KEY_PATH=/run/secrets/msaidizi-crud-evidence-public.pem
# MSAIDIZI_CRUD_EVIDENCE_KEY_ID=msaidizi-crud-evidence-2026-01
# MSAIDIZI_CRUD_EVIDENCE_APPLICATION_BUILD_DIGEST=COPY_FROM_ACCEPTED_ARTIFACT_PROVENANCE
# MSAIDIZI_CRUD_EVIDENCE_PRISMA_SCHEMA_MIGRATION_DIGEST=REPLACE_WITH_LOWERCASE_SHA256
MSAIDIZI_CRUD_EVIDENCE_MAX_AGE_HOURS=168

# Required as one exact set when any autonomous switch is enabled in
# production. The protected ring-promotion workflow generates these values;
# ordinary human-user Msaidizi chat does not require them.
# MSAIDIZI_PRODUCTION_PROMOTION_INVENTORY_PATH=/run/msaidizi/promotion-inventory.json
# MSAIDIZI_PRODUCTION_ACCEPTED_INVENTORY_SHA256=COPY_FROM_PROTECTED_PROMOTION
# MSAIDIZI_PRODUCTION_ACCEPTED_EVIDENCE_SHA256=COPY_FROM_PROTECTED_PROMOTION
# MSAIDIZI_PRODUCTION_ACCEPTED_IMAGE_DIGEST=sha256:COPY_FROM_PROTECTED_PROMOTION
# MSAIDIZI_DEPLOYED_BACKEND_IMAGE_REFERENCE=ghcr.io/owner/repository-backend@sha256:COPY_FROM_PROTECTED_PROMOTION
# MSAIDIZI_DEPLOYED_SOURCE_COMMIT=COPY_FROM_SIGNED_PROMOTION_INVENTORY
# MSAIDIZI_DEPLOYED_SOURCE_REPOSITORY=owner/repository
