# =================================================================
# ITEMBA-R Backend — Production Environment Variables
# Copy this file to .env.production and fill in real values
# NEVER commit .env.production to version control
# =================================================================

# Application
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1

# ---------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------
DATABASE_URL=postgresql://itemba_user:STRONG_PASSWORD_HERE@db-host:5432/itemba_r_prod?schema=public&sslmode=require
POSTGRES_USER=itemba_user
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_DB=itemba_r_prod

# ---------------------------------------------------------------
# JWT Authentication
# IMPORTANT: Use 64+ character random strings. Generate with:
#   openssl rand -hex 32
# ---------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_STRING_DO_NOT_USE_THIS_DEFAULT
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING_DO_NOT_USE_DEFAULT
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_PEPPER=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING

# ---------------------------------------------------------------
# Security
# ---------------------------------------------------------------
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
COOKIE_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
TWO_FACTOR_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_RANDOM_STRING
# P1-04: dedicated field-level encryption key for EncryptionService.
# MUST be distinct from JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, and
# TWO_FACTOR_ENCRYPTION_KEY — env validation refuses to boot otherwise.
APP_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING_FOR_FIELD_ENC

# P0-06: BackgroundJob worker activation. Production should be true so
# DATA_EXPORT / BACKUP_RUN / NOTIFICATION_DISPATCH jobs are actually executed.
JOB_WORKER_ENABLED=true

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Account lockout
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
ALLOW_PUBLIC_REGISTRATION=false

# ---------------------------------------------------------------
# CORS
# ---------------------------------------------------------------
FRONTEND_URL=https://app.itemba-r.co.tz
CORS_ORIGIN=https://app.itemba-r.co.tz

# ---------------------------------------------------------------
# SMTP Email
# ---------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@itemba-r.co.tz
SMTP_PASS=YOUR_SMTP_APP_PASSWORD
SMTP_FROM="ITEMBA-R System <noreply@itemba-r.co.tz>"

# ---------------------------------------------------------------
# Redis Cache
# ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE
REDIS_TTL=300

# ---------------------------------------------------------------
# Frontend / Docker Compose
# ---------------------------------------------------------------
BACKEND_INTERNAL_URL=http://backend:3001/api/v1
NEXT_PUBLIC_API_URL=https://api.itemba-r.co.tz/api/v1

# ---------------------------------------------------------------
# File Storage
# ---------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage
# For S3-compatible object storage (uncomment when ready):
# STORAGE_DRIVER=s3
# AWS_ACCESS_KEY_ID=YOUR_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET
# AWS_REGION=af-south-1
# AWS_S3_BUCKET=itemba-r-files-prod
# AWS_S3_ENDPOINT=https://s3.af-south-1.amazonaws.com

# ---------------------------------------------------------------
# Africa's Talking (SMS/USSD)
# ---------------------------------------------------------------
AT_API_KEY=YOUR_AT_API_KEY
AT_USERNAME=YOUR_AT_USERNAME
AT_SENDER_ID=ITEMBA-R
AT_ENVIRONMENT=production

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------
LOG_LEVEL=warn
LOG_FILE_PATH=/app/logs
LOG_MAX_FILES=30d
LOG_MAX_SIZE=20m

# ---------------------------------------------------------------
# Backup
# ---------------------------------------------------------------
BACKUP_STORAGE_PATH=/app/backups
BACKUP_RETENTION_DAYS=90
BACKUP_ENCRYPT=true
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_KEY

# ---------------------------------------------------------------
# System
# ---------------------------------------------------------------
SUPPORT_EMAIL=support@itemba-r.co.tz
ADMIN_EMAIL=admin@itemba-r.co.tz
SYSTEM_NAME=ITEMBA-R
COMPANY_GROUP_NAME=Itemba Group
