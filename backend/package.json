{
  "name": "itemba-r-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ITEMBA-R Backend API (NestJS + Prisma + PostgreSQL)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "node scripts/check-format-baseline.mjs",
    "test": "node --max-old-space-size=8192 node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watch",
    "test:debug": "node --max-old-space-size=8192 node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "test:e2e": "jest --config ./test/jest-e2e.json --detectOpenHandles",
    "test:e2e:ci": "node scripts/run-e2e-ci.mjs",
    "evidence:crud": "node scripts/run-crud-evidence.mjs",
    "test:evidence-runner": "node --test scripts/run-crud-evidence.test.mjs",
    "test:evidence-release": "node --test scripts/crud-evidence-release.test.mjs",
    "test:evidence-promotion": "node --test scripts/msaidizi-ring-promotion.test.mjs",
    "inspect:evidence-promotion-candidate": "node scripts/inspect-msaidizi-ring-promotion-candidate.mjs",
    "test:msaidizi-task-event-integrity": "node scripts/test-msaidizi-task-event-integrity.mjs",
    "test:msaidizi-proposal-usage-integrity": "node scripts/test-msaidizi-proposal-usage-integrity.mjs",
    "test:msaidizi-host-journal-evidence-integrity": "node scripts/test-msaidizi-host-journal-evidence-integrity.mjs",
    "test:msaidizi-plan-immutability": "node scripts/test-msaidizi-plan-immutability.mjs",
    "test:msaidizi-device-journal-reconciliation": "node --test scripts/msaidizi-device-journal-reconciliation.test.mjs",
    "test:msaidizi-egress-migration": "prisma db execute --schema=../database/prisma/schema.prisma --file=../database/prisma/migrations/20260825260000_msaidizi_host_action_egress_reservations/regression.sql",
    "test:msaidizi-input-provenance-migration": "prisma db execute --schema=../database/prisma/schema.prisma --file=../database/prisma/migrations/20260828120000_msaidizi_typed_input_provenance/regression.sql",
    "test:msaidizi-egress-route-migration": "prisma db execute --schema=../database/prisma/schema.prisma --file=../database/prisma/migrations/20260828130000_msaidizi_egress_route_attestation/regression.sql",
    "test:msaidizi-update-rollout-migration": "prisma db execute --schema=../database/prisma/schema.prisma --file=../database/prisma/migrations/20260827030000_msaidizi_update_rollout_progression/regression.sql",
    "test:msaidizi-wall-time-migration": "prisma db execute --schema=../database/prisma/schema.prisma --file=../database/prisma/migrations/20260828090000_msaidizi_task_wall_time_accounting/regression.sql",
    "test:msaidizi-update-evaluation-migration": "prisma db execute --schema=../database/prisma/schema.prisma --file=../database/prisma/migrations/20260828100000_msaidizi_autonomous_update_evaluation/regression.sql",
    "test:ci": "node --max-old-space-size=8192 node_modules/jest/bin/jest.js --runInBand --ci --reporters=default --reporters=summary",
    "prisma:generate": "prisma generate --schema=../database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=../database/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=../database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=../database/prisma/schema.prisma",
    "prisma:reset": "prisma migrate reset --schema=../database/prisma/schema.prisma",
    "db:seed": "cross-env NODE_PATH=./node_modules ts-node --project tsconfig.json --transpile-only ../database/seeds/seed.ts",
    "attestation:create": "ts-node --transpile-only scripts/create-provider-contract-attestation.ts"
  },
  "prisma": {
    "schema": "../database/prisma/schema.prisma",
    "seed": "cross-env NODE_PATH=./node_modules ts-node --project tsconfig.json --transpile-only ../database/seeds/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.2.1",
    "@otplib/preset-default": "^12.0.1",
    "@prisma/client": "^5.22.0",
    "@types/qrcode": "^1.5.6",
    "argon2": "^0.41.1",
    "cache-manager": "^7.2.8",
    "cache-manager-ioredis-yet": "^2.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "nodemailer": "^8.0.7",
    "otplib": "^13.4.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.4.0",
    "@typescript-eslint/parser": "^8.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@prisma-svc/(.*)$": "<rootDir>/prisma/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
