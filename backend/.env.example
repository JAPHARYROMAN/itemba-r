# Database
DATABASE_URL=postgresql://itemba_user:your_password@localhost:5433/itemba_r

# JWT
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=never
JWT_REFRESH_EXPIRES_IN=never

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# 2FA / Field-level encryption (32+ chars). Required outside development.
TWO_FACTOR_ENCRYPTION_KEY=dev-only-2fa-key-32-chars-minimum-please-rotate
APP_ENCRYPTION_KEY=dev-only-app-encryption-key-32-chars-minimum-please-rotate
REFRESH_TOKEN_PEPPER=dev-only-refresh-pepper-32-chars-minimum-please-rotate

# BackgroundJob worker — set true to actually process queued jobs.
JOB_WORKER_ENABLED=false

# File Storage (local development)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Backward-compatible alias still supported by the documents service:
# LOCAL_STORAGE_PATH=./storage

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ITEMBA-R System <noreply@itemba-r.com>"

# External integration smoke tests
EXTERNAL_SMOKE_REQUIRE=
EXTERNAL_SMOKE_EMAIL_TO=
EXTERNAL_SMOKE_SEND_EMAIL=false
EXTERNAL_SMOKE_HTTP_TARGETS=

# SMS (optional - Africa's Talking)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=ITEMBA-R

# External Payments (optional)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
TIGOPESA_USERNAME=
TIGOPESA_PASSWORD=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Performance
SLOW_QUERY_THRESHOLD_MS=1000
PERFORMANCE_TRACE_ENABLED=true
MAX_PAGE_SIZE=100
DEFAULT_PAGE_SIZE=20

# Security
BCRYPT_ROUNDS=12
THROTTLE_TTL=60
THROTTLE_LIMIT=100
SESSION_TIMEOUT_MINUTES=60

# Backup
BACKUP_ENABLED=false
BACKUP_STORAGE_PATH=./backups
# Optional explicit override; BACKUP_STORAGE_PATH is used when this is unset.
# BACKUPS_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# Msaidizi — agent layer
# Off by default. Deploying the code must not, on its own, put an agent in
# front of anyone's data; both the flag and a key are required.
MSAIDIZI_ENABLED=false
ANTHROPIC_API_KEY=
# read-only | amber | red — the highest reversibility tier the agent may invoke.
# read-only emits no write tools at all, so "must not write" is enforced by the
# absence of the capability rather than by instruction.
MSAIDIZI_WRITE_MODE=read-only
MSAIDIZI_MODEL=claude-opus-5
MSAIDIZI_CLASSIFIER_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max. Mostly tool orchestration rather than deep
# reasoning, so medium is the starting point; raise if answers are shallow.
MSAIDIZI_EFFORT=medium
# Per-run ceilings. A permission that allows an action does not allow it fifty
# times; these are the loop backstop the permission system cannot express.
MSAIDIZI_MAX_WRITES_PER_SESSION=10
MSAIDIZI_MAX_TOOL_CALLS=40
MSAIDIZI_MAX_TOKENS=32000
MSAIDIZI_INVOKE_TIMEOUT_MS=30000
# The agent calls the API as a client. Defaults to this instance; set explicitly
# behind a proxy or when the container cannot reach itself on PORT.
# MSAIDIZI_LOOPBACK_URL=http://127.0.0.1:3001/api/v1
