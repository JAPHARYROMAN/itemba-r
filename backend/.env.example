# ITEMBA-R backend: local development settings.
#
# Copy this file to backend/.env. It works as-is against the database started by
# `docker compose up -d postgres` (see docker-compose.yml). Every value below is a
# local-development placeholder, so replace the secrets before any shared or
# hosted use. src/config/env.validation.ts holds the boot-time checks (required
# values and the staging/production rules) but is not a complete variable list.
# backend/.env.production.example and docker-compose.production.yml cover
# production; docker-compose.staging.yml and .env.staging.example cover staging.

# Database: matches the throwaway credentials in docker-compose.yml (host port 5433).
# This is your development database. Do not run `npm run test:e2e:ci` against it:
# the e2e suites create and delete rows. Export DATABASE_URL for a separate,
# migrated, unseeded database first.
DATABASE_URL=postgresql://itemba:itemba_dev_password@localhost:5433/itemba_r?schema=public

# JWT (minimum 32 characters each; use different values)
JWT_ACCESS_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_at_least_64_chars
JWT_ACCESS_EXPIRES_IN=never
JWT_REFRESH_EXPIRES_IN=never

# Server
PORT=3001
NODE_ENV=development
# Where the web app runs in development (frontend/package.json serves on 3009).
FRONTEND_URL=http://localhost:3009
# Comma-separated browser origins allowed by CORS. The web app reaches the API
# through its own same-origin proxy, so this rarely matters locally.
CORS_ORIGIN=http://localhost:3009
# API_PREFIX=api/v1

# Field-level encryption and token keys. APP_ENCRYPTION_KEY and
# TWO_FACTOR_ENCRYPTION_KEY must be 32+ characters (enforced); REFRESH_TOKEN_PEPPER
# has no enforced length, so use 32+ anyway.
# APP_ENCRYPTION_KEY is required in EVERY environment: the API refuses to boot
# without it. TWO_FACTOR_ENCRYPTION_KEY is needed as soon as any user enables
# two-factor sign-in, and is required in staging and production, as is
# REFRESH_TOKEN_PEPPER (in development it falls back to JWT_REFRESH_SECRET).
TWO_FACTOR_ENCRYPTION_KEY=dev-only-2fa-key-32-chars-minimum-please-rotate
APP_ENCRYPTION_KEY=dev-only-app-encryption-key-32-chars-minimum-please-rotate
REFRESH_TOKEN_PEPPER=dev-only-refresh-pepper-32-chars-minimum-please-rotate
# Optional salt for deriving the encryption key. Changing it re-keys everything
# that is already encrypted, so set it only on a fresh install.
# APP_ENCRYPTION_SALT=

# BackgroundJob worker: set true to actually process queued jobs (data exports,
# backups and restore tests). It also enqueues due scheduled backups.
JOB_WORKER_ENABLED=false
# Automation passes that run inside the worker (overdue reminders, low-stock
# alerts, scheduled-report emails). Needs JOB_WORKER_ENABLED=true as well.
AUTOMATION_DISPATCH_ENABLED=false
# 0 (the default) means use the built-in timeout and stale-job window.
# JOB_WORKER_DEFAULT_TIMEOUT_SECONDS=0
# JOB_WORKER_STALE_AFTER_SECONDS=0

# Tax: copy tax from confirmed sales and purchase orders and approved expenses
# into the tax ledger that the filing reports read. Off by default.
TAX_AUTO_APPLY=false

# File storage (local disk is the only supported driver)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
# Backward-compatible aliases still supported by the documents service:
# LOCAL_STORAGE_PATH=./storage
# STORAGE_PATH=./storage
# Required in staging and production; included in full-system backups when set.
# EXPORTS_DIR=./exports
# Optional path to a PNG logo used on generated documents.
# ITEMBA_DEFAULT_LOGO_PATH=

# SMTP email (optional). Leave these commented out in development: with
# SMTP_HOST unset the API skips email sending and logs a short preview of
# password-reset tokens instead. In staging and production, SMTP_HOST,
# SMTP_USER, SMTP_PASS and SMTP_FROM must be set together or not at all.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ITEMBA-R System <noreply@example.com>"

# External integration smoke tests
EXTERNAL_SMOKE_REQUIRE=
EXTERNAL_SMOKE_EMAIL_TO=
EXTERNAL_SMOKE_SEND_EMAIL=false
EXTERNAL_SMOKE_HTTP_TARGETS=

# Reserved for future integrations: no backend code reads the SMS and
# mobile-money names below yet (there are no SMS or mobile-money adapters). Only
# scripts/smoke-external-integrations.mjs checks them, and it fails if just one
# credential of a pair is set. The production compose file forwards them so the
# names are already in place.
# SMS (Africa's Talking)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=ITEMBA-R

# External payments
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
TIGOPESA_USERNAME=
TIGOPESA_PASSWORD=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Security
ALLOW_PUBLIC_REGISTRATION=false
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# Password expiry window in days (default 90); 0 disables expiry.
# PASSWORD_ROTATION_DAYS=90

# Backup
BACKUP_STORAGE_PATH=./backups
# Optional explicit override; BACKUP_STORAGE_PATH is used when this is unset.
# BACKUPS_DIR=./backups

# Redis (optional). Unset means a single-process permission cache, which is fine
# for one API instance. Uncomment to use the Redis container started by
# `docker compose up -d` (staging and production require REDIS_PASSWORD, and
# their compose files point the API at Redis).
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TTL=300
# Alternative for the permission cache only (the HTTP cache still needs REDIS_HOST):
# REDIS_URL=redis://localhost:6379

# Msaidizi — agent layer
# Off by default. Deploying the code must not, on its own, put an agent in
# front of anyone's data; both the flag and a key are required.
MSAIDIZI_ENABLED=false
ANTHROPIC_API_KEY=
# read-only | amber | red — the highest reversibility tier the agent may invoke.
# read-only emits no write tools at all, so "must not write" is enforced by the
# absence of the capability rather than by instruction.
MSAIDIZI_WRITE_MODE=read-only
MSAIDIZI_MODEL=claude-opus-5
# No pre-filter calls this model yet — narrowing is deterministic and lexical.
# It is still required: the signed provider contract is attested against BOTH
# model IDs, so changing this without a contract naming the new model fails
# attestation and stops the agent.
MSAIDIZI_CLASSIFIER_MODEL=claude-haiku-4-5
# low | medium | high | xhigh | max. Mostly tool orchestration rather than deep
# reasoning, so medium is the starting point; raise if answers are shallow.
MSAIDIZI_EFFORT=medium
# Per-run ceilings. A permission that allows an action does not allow it fifty
# times; these are the loop backstop the permission system cannot express.
# "Run" means ONE HTTP request, not one conversation: the counter behind the
# write ceiling is a local of the run loop, so a conversation of ten turns may
# write ten times this many. MSAIDIZI_MAX_WRITES_PER_RUN is the name that says
# so and it wins when both are set; MSAIDIZI_MAX_WRITES_PER_SESSION is still
# read, so a deployment that already set the old spelling keeps its ceiling.
#
# Only the accurate name is set here, deliberately. Shipping both would re-arm
# the hazard the compose file was written to avoid: since PER_RUN wins, an
# operator who copies this file and then lowers PER_SESSION alone would change
# nothing, and would have no way to tell from the file that their edit was
# inert. The old name is left commented so it is discoverable without being
# active.
MSAIDIZI_MAX_WRITES_PER_RUN=10
# MSAIDIZI_MAX_WRITES_PER_SESSION=10   # legacy spelling; read only when PER_RUN is unset
MSAIDIZI_MAX_TOOL_CALLS=40
MSAIDIZI_MAX_TOKENS=32000
MSAIDIZI_INVOKE_TIMEOUT_MS=30000
# Attempts for ONE provider turn, retries included; 1 disables retry. Only
# failures that carry no decision are retried (429, 5xx, dropped connections) —
# never a refusal, a validation error, or a cancelled request. Without this a
# single transient failure ends a run that may already have committed writes.
MSAIDIZI_MODEL_MAX_ATTEMPTS=3
MSAIDIZI_MODEL_RETRY_BASE_DELAY_MS=500
# Ceiling on any one wait, including a provider-requested retry-after.
MSAIDIZI_MODEL_RETRY_MAX_DELAY_MS=8000
# The agent calls the API as a client. Defaults to this instance; set explicitly
# behind a proxy or when the container cannot reach itself on PORT.
# MSAIDIZI_LOOPBACK_URL=http://127.0.0.1:3001/api/v1

# Optional signed loopback CRUD evidence. These five values are all-or-none;
# evidence is rejected when it is absent, stale, unsigned, or bound to another
# capability manifest, fixture contract, application build, or Prisma migration
# set. Generate it only with `npm run evidence:crud` against the runner-created
# disposable PostgreSQL schema.
# MSAIDIZI_CRUD_EVIDENCE_PATH=/run/msaidizi/crud-evidence.json
# MSAIDIZI_CRUD_EVIDENCE_PUBLIC_KEY_PATH=/run/secrets/msaidizi-crud-evidence-public.pem
# MSAIDIZI_CRUD_EVIDENCE_KEY_ID=msaidizi-crud-evidence-2026-01
# MSAIDIZI_CRUD_EVIDENCE_APPLICATION_BUILD_DIGEST=COPY_FROM_ACCEPTED_ARTIFACT_PROVENANCE
# MSAIDIZI_CRUD_EVIDENCE_PRISMA_SCHEMA_MIGRATION_DIGEST=REPLACE_WITH_LOWERCASE_SHA256
MSAIDIZI_CRUD_EVIDENCE_MAX_AGE_HOURS=168

# Declare a BM25 tool-search tool and defer the bulk of the registry, instead of
# sending a lexically narrowed slice. Off by default so both paths can be run
# against the same questions before either is trusted.
#
# Grants no authority: search selects from the set already filtered by
# permission and write mode, so what the agent can REACH is unchanged — only how
# much of it the model can see at once. It also makes the tool block stable
# across turns, which is what lets the prompt cache work at all: tools render
# before the system block, and today's per-request narrowing changes the bytes
# ahead of the cache breakpoint on every call.
MSAIDIZI_TOOL_SEARCH=false

# Durable autonomous tasks — independently gated and OFF by default.
# Enabling MSAIDIZI_AUTONOMY_ENABLED exposes planning/task APIs; actual step
# dispatch also requires both task-worker flags. `MSAIDIZI_GLOBAL_KILL_SWITCH`
# stops new task JWTs and new dispatches even when every other flag is enabled.
MSAIDIZI_AUTONOMY_ENABLED=false
MSAIDIZI_TASK_WORKER_ENABLED=false
MSAIDIZI_AUTOPILOT_ENABLED=false
MSAIDIZI_HOST_EXECUTION_ENABLED=false
MSAIDIZI_GLOBAL_KILL_SWITCH=false
MSAIDIZI_DEVICE_PAIRING_ENABLED=false
MSAIDIZI_DEVICE_CHANNEL_ENABLED=false
MSAIDIZI_DIRECT_MTLS_ENABLED=false
MSAIDIZI_DIRECT_MTLS_PORT=3443
MSAIDIZI_DIRECT_MTLS_BIND_ADDRESS=0.0.0.0
MSAIDIZI_SUPERVISOR_ENROLLMENT_ENABLED=false
MSAIDIZI_UPDATE_SUPERVISOR_ENABLED=false
# Requires update supervisor + autonomy + Autopilot. The deployment coordinator
# may arm an evaluated candidate only from its exact active persisted mandate;
# this external ceiling remains outside candidate/model control.
MSAIDIZI_UPDATE_AUTOMATIC_ROLLOUT_ENABLED=false
MSAIDIZI_UPDATE_AUTOMATIC_MAX_RING=-1
MSAIDIZI_UPDATE_ROLLOUT_SWEEP_SECONDS=15
MSAIDIZI_RECOVERY_SUPERVISOR_ENABLED=false
MSAIDIZI_AUDIT_SIGNER_ENABLED=false
MSAIDIZI_AUDIT_SIGNER_KILL_SWITCH=false
# Signed evaluator remains OFF until an operator mounts an external, read-only
# allowlist plus P-256 public keys. The SHA-256 pin anchors the allowlist itself;
# each pinned allowlist entry also carries the SPKI SHA-256 of its public key.
MSAIDIZI_UPDATE_EVALUATOR_ENABLED=false
MSAIDIZI_EVALUATOR_KEY_ALLOWLIST_PATH=/run/secrets/msaidizi-evaluator-keys.json
MSAIDIZI_EVALUATOR_KEY_ALLOWLIST_SHA256=
MSAIDIZI_EVALUATOR_MAX_CLOCK_SKEW_SECONDS=60
MSAIDIZI_EVALUATOR_MAX_ATTESTATION_AGE_SECONDS=86400
# Verifier traffic never uses the ordinary API/device listener. The dedicated
# listener requires an authorized client chain and both exact leaf/SPKI pins.
MSAIDIZI_EVALUATOR_MTLS_ENABLED=false
MSAIDIZI_EVALUATOR_MTLS_PORT=3444
# Bare-metal listener bind. Compose overrides this with the container bind while
# publishing only on the independently configured loopback host bind.
MSAIDIZI_EVALUATOR_MTLS_BIND_ADDRESS=127.0.0.1
MSAIDIZI_EVALUATOR_MTLS_CONTAINER_BIND_ADDRESS=0.0.0.0
MSAIDIZI_EVALUATOR_MTLS_HOST_BIND_ADDRESS=127.0.0.1
MSAIDIZI_EVALUATOR_MTLS_SERVER_KEY_PATH=/run/secrets/msaidizi-evaluator-server-key.pem
MSAIDIZI_EVALUATOR_MTLS_SERVER_CERT_PATH=/run/secrets/msaidizi-evaluator-server-cert.pem
MSAIDIZI_EVALUATOR_MTLS_CLIENT_CA_PATH=/run/secrets/msaidizi-evaluator-client-ca.pem
MSAIDIZI_EVALUATOR_CLIENT_CERT_SHA256=
MSAIDIZI_EVALUATOR_CLIENT_SPKI_SHA256=
# Required before enabling Msaidizi, durable reasoning, Autopilot, or host
# execution. Both files must be immutable operator-owned regular files outside
# the application tree. The signed claims bind Anthropic account + exact model
# IDs, the exact https://api.anthropic.com origin, the opaque secret-manager
# version/key ID selecting ANTHROPIC_API_KEY, a content-addressed legal document,
# all cloud-visible data classes, zero training, zero retention and expiry.
# Rotate the credential key ID whenever the secret changes. ANTHROPIC_BASE_URL,
# ANTHROPIC_AUTH_TOKEN, ANTHROPIC_CUSTOM_HEADERS,
# ANTHROPIC_LOG, ANTHROPIC_PROFILE and ANTHROPIC_WEBHOOK_SIGNING_KEY are
# deliberately forbidden whenever this boundary is configured.
#
# Leave the two PATH lines below commented out unless you are enabling Msaidizi:
# setting ANY provider-contract value makes the backend require ALL seven
# MSAIDIZI_PROVIDER_* / MSAIDIZI_PROVIDER_CONTRACT_* values (well-formed) at boot,
# even while MSAIDIZI_ENABLED=false. The signed attestation file itself is
# verified once Msaidizi (or another gated Msaidizi feature) is enabled.
# MSAIDIZI_PROVIDER_CONTRACT_ATTESTATION_PATH=/run/msaidizi-provider-contract/attestation.json
# MSAIDIZI_PROVIDER_CONTRACT_PUBLIC_KEY_PATH=/run/msaidizi-provider-contract/public.pem
MSAIDIZI_PROVIDER_CONTRACT_KEY_ID=
MSAIDIZI_PROVIDER_CONTRACT_ATTESTATION_SHA256=
MSAIDIZI_PROVIDER_CONTRACT_SIGNER_SPKI_SHA256=
MSAIDIZI_PROVIDER_ACCOUNT_ID=
MSAIDIZI_PROVIDER_CREDENTIAL_KEY_ID=
# Set these only through the deployment secret store when the corresponding
# channel is enabled. The signing key must be a P-256 PEM file at an absolute,
# supervisor-owned path; the private key is never stored in Itemba's database.
# MSAIDIZI_DEVICE_PAIRING_PEPPER=<32+ random characters>
# MSAIDIZI_DEVICE_LEASE_PEPPER=<different 32+ random characters>
# MSAIDIZI_SUPERVISOR_ENROLLMENT_PEPPER=<third, different 32+ random characters>
# MSAIDIZI_ACTION_SIGNING_KEY_PATH=/run/secrets/msaidizi-action-es256.pem
# MSAIDIZI_ACTION_SIGNING_KEY_ID=msaidizi-action-2026-01
# MSAIDIZI_UPDATE_SIGNING_KEY_PATH=/run/secrets/msaidizi-update-es256.pem
# MSAIDIZI_UPDATE_SIGNING_KEY_ID=msaidizi-bootstrap-2026-01
# MSAIDIZI_RECOVERY_SIGNING_KEY_PATH=/run/secrets/msaidizi-recovery-es256.pem
# MSAIDIZI_RECOVERY_SIGNING_KEY_ID=msaidizi-recovery-2026-01
# MSAIDIZI_AUDIT_SIGNER_KEY_ID=msaidizi-audit-signer-2026-01
# MSAIDIZI_AUDIT_SIGNER_CLIENT_CERT_SHA256=<lowercase SHA-256 of signer certificate DER>
# MSAIDIZI_AUDIT_SIGNER_CLIENT_SPKI_SHA256=<lowercase SHA-256 of signer SPKI DER>
MSAIDIZI_AUDIT_SIGNER_MAX_SEGMENT_EVENTS=256
MSAIDIZI_AUDIT_SIGNER_CHECKPOINT_TTL_SECONDS=300
MSAIDIZI_AUDIT_SIGNER_MAX_CLOCK_SKEW_SECONDS=30
# MSAIDIZI_DIRECT_MTLS_SERVER_KEY_PATH=/run/secrets/msaidizi-device-server-key.pem
# MSAIDIZI_DIRECT_MTLS_SERVER_CERT_PATH=/run/secrets/msaidizi-device-server-cert.pem
# MSAIDIZI_DIRECT_MTLS_CLIENT_CA_PATH=/run/secrets/msaidizi-device-client-ca.pem
MSAIDIZI_ACTION_TOKEN_ISSUER=itemba-msaidizi-broker
MSAIDIZI_ACTION_TOKEN_AUDIENCE=itemba-windows-companion
MSAIDIZI_ACTION_TOKEN_SUBJECT=msaidizi-global
MSAIDIZI_ACTION_TOKEN_TTL_SECONDS=120
MSAIDIZI_DEVICE_PAIRING_TTL_SECONDS=300
MSAIDIZI_SUPERVISOR_ENROLLMENT_TTL_SECONDS=300
MSAIDIZI_DEVICE_LEASE_TTL_SECONDS=90
MSAIDIZI_DEVICE_REDELIVERY_SECONDS=15
MSAIDIZI_UPDATE_MANIFEST_TTL_SECONDS=600
MSAIDIZI_UPDATE_REDELIVERY_SECONDS=30
MSAIDIZI_UPDATE_HEALTH_TIMEOUT_SECONDS=600
MSAIDIZI_UPDATE_MIN_HEALTHY_SOAK_SECONDS=300
MSAIDIZI_UPDATE_RING_0_MIN_DWELL_SECONDS=86400
MSAIDIZI_UPDATE_RING_5_MIN_DWELL_SECONDS=86400
MSAIDIZI_UPDATE_RING_25_MIN_DWELL_SECONDS=172800
MSAIDIZI_UPDATE_RING_100_MIN_DWELL_SECONDS=259200
MSAIDIZI_RECOVERY_MANIFEST_TTL_SECONDS=600
MSAIDIZI_RECOVERY_REDELIVERY_SECONDS=30
MSAIDIZI_AUTONOMY_PRINCIPAL_KEY=global-msaidizi
# Explicit comma-separated permission ceiling. Empty means the service
# principal can plan but cannot execute ERP endpoints. `*` must be a deliberate
# deployment choice and is still narrowed to the exact task step by its JWT.
MSAIDIZI_AUTONOMY_GRANTS=
MSAIDIZI_TASK_TOKEN_TTL_SECONDS=120
MSAIDIZI_TASK_DISPATCH_INTERVAL_MS=2000
MSAIDIZI_AUTONOMY_MAX_WALL_SECONDS=7200
MSAIDIZI_AUTONOMY_MAX_MODEL_TURNS=200
MSAIDIZI_AUTONOMY_MAX_TOOL_ATTEMPTS=500
MSAIDIZI_AUTONOMY_MAX_MUTATIONS=100
MSAIDIZI_AUTONOMY_MAX_LOCAL_BYTES=5368709120
MSAIDIZI_AUTONOMY_MAX_EGRESS_BYTES=262144000
MSAIDIZI_AUTONOMY_MAX_MODEL_COST_USD=20
# Adaptive planner/executor/critic loop. Keep disabled until a deployment owner
# has configured a metered provider and deliberately enabled durable reasoning.
MSAIDIZI_ADAPTIVE_REASONING_ENABLED=false
MSAIDIZI_ADAPTIVE_REASONING_MAX_INPUT_BYTES=65536
MSAIDIZI_ADAPTIVE_REASONING_MAX_OUTPUT_TOKENS=2048
MSAIDIZI_MODEL_INPUT_USD_PER_MILLION_TOKENS=30
MSAIDIZI_MODEL_OUTPUT_USD_PER_MILLION_TOKENS=150
# Itemba applies the maximum of direct/cache rates to every input unit so the
# hard ledger is conservative even when cache creation carries a premium.
MSAIDIZI_MODEL_CACHE_READ_USD_PER_MILLION_TOKENS=30
MSAIDIZI_MODEL_CACHE_CREATION_USD_PER_MILLION_TOKENS=37.5
# Proposal calls precede task creation, so they use a separate rolling quota.
# Reservations are serialized per initiating user/company and abandoned
# receipts continue to count for the full window.
MSAIDIZI_PROPOSAL_MAX_INPUT_TOKENS_PER_TURN=200000
MSAIDIZI_PROPOSAL_QUOTA_WINDOW_SECONDS=3600
MSAIDIZI_PROPOSAL_MAX_MODEL_TURNS_PER_WINDOW=200
MSAIDIZI_PROPOSAL_MAX_COST_USD_PER_WINDOW=20
MSAIDIZI_PROPOSAL_RECEIPT_TTL_SECONDS=86400
MSAIDIZI_PROPOSAL_RESERVATION_TIMEOUT_SECONDS=300
# Required for artifact upload/download. Generate 32 random bytes and encode
# them as base64; keep the value in the deployment secret store, never Git.
MSAIDIZI_ARTIFACT_ENCRYPTION_KEY=
# Must be a persistent volume in production. User-supplied names are never used
# in storage paths; every object is AES-256-GCM encrypted at rest.
MSAIDIZI_ARTIFACT_ROOT=./storage/msaidizi-artifacts

# Conversation storage and retention (defaults shown; uncomment to change).
# Resume state includes retrieved business records; it is encrypted with
# APP_ENCRYPTION_KEY and expires after the TTL below.
# MSAIDIZI_RESUME_TTL_HOURS=24
# MSAIDIZI_RESUME_MAX_BYTES=1048576
# MSAIDIZI_CONVERSATION_RETENTION_DAYS=90
# MSAIDIZI_DELETED_GRACE_HOURS=24
# MSAIDIZI_SWEEP_BATCH_SIZE=200

# Production release-gate values (MSAIDIZI_DEPLOYED_*, MSAIDIZI_PRODUCTION_*) are
# set by the protected ring-promotion tooling (deploy/relaunch/), not by hand;
# see backend/.env.production.example.

# Party linkage — one cash book (decision D3). When true, every ERP supplier payment,
# customer collection, expense payment and refund also writes a Cash Desk movement through
# the connected Cash Desk account (CashDeskAccount.erpCashAccountId) and refuses ERP cash
# accounts without one. Run `node backend/scripts/cash-book-preflight.cjs` and connect the
# gaps (Cash Desk → Accounts) before enabling.
CASH_BOOK_UNIFIED=false
