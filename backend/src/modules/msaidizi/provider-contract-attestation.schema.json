{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itemba.local/schemas/msaidizi-provider-contract-attestation-v2.json",
  "title": "Msaidizi provider-contract attestation v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims", "contract", "keyId", "signatureAlgorithm", "signatureBase64"],
  "properties": {
    "contract": { "const": "msaidizi-provider-contract-attestation/v2" },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiAccountId",
        "apiCredentialKeyId",
        "apiOrigin",
        "attestationId",
        "contractDocumentSha256",
        "coveredDataClasses",
        "effectiveAt",
        "expiresAt",
        "immutableLegalReference",
        "issuedAt",
        "permittedModelIds",
        "provider",
        "providerRetentionSeconds",
        "zeroTraining"
      ],
      "properties": {
        "attestationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "provider": { "const": "anthropic" },
        "apiOrigin": { "const": "https://api.anthropic.com" },
        "apiAccountId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:@/-]{1,256}$"
        },
        "apiCredentialKeyId": {
          "type": "string",
          "$comment": "Opaque operator-controlled secret-manager version/key identifier; never credential material.",
          "pattern": "^[A-Za-z0-9._:@/-]{1,256}$"
        },
        "permittedModelIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "$comment": "The runtime additionally requires ordinal lexical order.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:@/-]{1,200}$"
          }
        },
        "coveredDataClasses": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "audio" },
            { "const": "browser_sessions" },
            { "const": "business_records" },
            { "const": "clipboard" },
            { "const": "credentials" },
            { "const": "documents" },
            { "const": "email" },
            { "const": "financial_data" },
            { "const": "personal_data" },
            { "const": "screenshots" }
          ],
          "items": false
        },
        "zeroTraining": { "const": true },
        "providerRetentionSeconds": { "const": 0 },
        "contractDocumentSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "immutableLegalReference": {
          "type": "string",
          "$comment": "The runtime requires the digest suffix to equal contractDocumentSha256.",
          "pattern": "^urn:sha256:[a-f0-9]{64}$"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "effectiveAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$"
        }
      }
    },
    "keyId": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "signatureAlgorithm": { "const": "ES256" },
    "signatureBase64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    }
  }
}
