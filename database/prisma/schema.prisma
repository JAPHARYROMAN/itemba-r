  postingRule AccountingPostingRule @relation(fields: [postingRuleId], references: [id], onDelete: Cascade)
  account     ChartOfAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([postingRuleId, lineOrder])
  @@map("accounting_posting_rule_lines")
}

model PostingRun {
  id               String            @id @default(uuid())
