  testedById        String
  startedAt         DateTime?
  completedAt       DateTime?
  resultSummary     String?
  issuesFound       String?
  correctiveActions String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  backupRun BackupRun? @relation(fields: [backupRunId], references: [id], onDelete: SetNull)
  testedBy  User       @relation("RestoreTestTestedBy", fields: [testedById], references: [id])

  @@index([backupRunId, status, testDate])
  @@map("restore_tests")
}

