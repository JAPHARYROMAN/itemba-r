// ─── Models ───────────────────────────────────────────────────────────────────

model Department {
  id                     String           @id @default(uuid())
  departmentCode         String
  companyId              String
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  name                   String
  description            String?
  managerId              String?
  status                 DepartmentStatus @default(ACTIVE)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division             Division?             @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  licensedBusinessUnit LicensedBusinessUnit? @relation(fields: [licensedBusinessUnitId], references: [id], onDelete: SetNull)
  manager              User?                 @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: SetNull)
  positions            Position[]
  employees            Employee[]
  employeeAssignments  EmployeeAssignment[]

  @@unique([companyId, departmentCode])
  @@map("departments")
}

model Position {
  id            String         @id @default(uuid())
  positionCode  String
  companyId     String
  departmentId  String?
  title         String
  positionType  PositionType   @default(OTHER)
  description   String?
  defaultSalary Decimal?       @db.Decimal(18, 2)
  currency      String?
  status        PositionStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department  Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees   Employee[]
  assignments EmployeeAssignment[]

  @@unique([companyId, positionCode])
  @@map("positions")
}

model Employee {
  id                        String               @id @default(uuid())
  employeeCode              String
  companyId                 String
  divisionId                String?
  branchId                  String?
  licensedBusinessUnitId    String?
  departmentId              String?
  positionId                String?
  userId                    String?              @unique
  firstName                 String
  middleName                String?
  lastName                  String
  fullName                  String
  gender                    Gender               @default(NOT_SPECIFIED)
  dateOfBirth               DateTime?
  nationality               String?
  phone                     String?
  email                     String?
  address                   String?
  identificationType        String?
  identificationNumber      String?
  // ── Tanzania-specific identity ─────────────────────────────────────────
  /// National Identification Authority number — 20-digit format for citizens.
  nidaNumber                String?
  /// Passport number for non-citizen employees.
  passportNumber            String?
  /// Issuing country for the passport (ISO-3166 alpha-2 or country name).
  passportCountry           String?
  /// Voter ID — accepted by some KYC flows in lieu of NIDA.
  votersIdNumber            String?
  // ── Tax & statutory ────────────────────────────────────────────────────
  tin                       String?
  nssfNumber                String?
  nhifNumber                String?
  /// PSSSF (Public Service Social Security Fund) registration — alternative to NSSF for public-sector.
  pssfNumber                String?
  /// Workers Compensation Fund employee registration (where issued).
  wcfRegistrationNumber     String?
  /// HESLB graduate-loan account number.
  heslbNumber               String?
  /// True when the employee is an active HESLB borrower; toggles 15% deduction.
  heslbBorrower             Boolean              @default(false)
  /// PAYE residency status — non-residents are taxed at a flat 15% (Tanzania).
  taxResidencyStatus        EmployeeTaxResidency @default(RESIDENT)
  /// Disability status. PWD-certified employees get a PAYE relief of TZS 180,000/year.
  disabilityStatus          DisabilityStatus     @default(NONE)
  disabilityCertificateNo   String?
  /// Tax-relevant dependents count (used by some employer-policy allowances).
  dependents                Int                  @default(0)
  /// Determines which PAYE band table applies — Mainland or Zanzibar.
  payrollRegion             HolidayRegion        @default(MAINLAND)
  /// Default sales-commission rate when this employee is the salesperson on
  /// a SalesOrder. Stored as decimal (0.05 = 5%). When set, confirming an
  /// order auto-creates a DRAFT SalesCommission for review. Null → no
  /// auto-commission for this employee (manual creation still works).
  defaultCommissionRate     Decimal?             @db.Decimal(8, 4)
  // ── Payment ────────────────────────────────────────────────────────────
  bankName                  String?
  bankAccountName           String?
  bankAccountNumber         String?
  /// Legacy single-account field. New code should use the MobileMoneyAccount table.
  mobileMoneyNumber         String?
  emergencyContactName      String?
  emergencyContactPhone     String?
  employmentType            EmploymentType       @default(FULL_TIME)
  employmentStatus          EmploymentStatus     @default(ACTIVE)
  hireDate                  DateTime?
  terminationDate           DateTime?
  pendingTerminationDate    DateTime?
  terminationRequestedById  String?
  terminationRequestedAt    DateTime?
  terminationReason         String?
  terminationHrApprovedById String?
  terminationHrApprovedAt   DateTime?
  terminationGmApprovedById String?
  terminationGmApprovedAt   DateTime?
  baseSalary                Decimal              @default(0) @db.Decimal(18, 2)
  salaryCurrency            String               @default("TZS")
  paymentFrequency          HRPaymentFrequency   @default(MONTHLY)
  notes                     String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  deletedAt                 DateTime?

  company              Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division             Division?               @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)
  licensedBusinessUnit LicensedBusinessUnit?   @relation(fields: [licensedBusinessUnitId], references: [id], onDelete: SetNull)
  department           Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position             Position?               @relation(fields: [positionId], references: [id], onDelete: SetNull)
  user                 User?                   @relation("EmployeeUser", fields: [userId], references: [id], onDelete: SetNull)
  assignments          EmployeeAssignment[]
  contracts            EmploymentContract[]
  shiftSchedules       ShiftSchedule[]
  attendance           AttendanceRecord[]
  leaveRequests        LeaveRequest[]
  leaveBalances        LeaveBalance[]
  allowances           EmployeeAllowance[]
  deductions           EmployeeDeduction[]
  payrollEntries       PayrollEntry[]
  salaryPayments       SalaryPayment[]
  salaryAdvances       SalaryAdvance[]
  performanceRecords   PerformanceRecord[]
  hrDocuments          HRDocument[]
  fuelShiftAttendances FuelShiftAttendant[]    @relation("ShiftAttendantEmployee")
  mobileMoneyAccounts  MobileMoneyAccount[]
  medicalExamRecords   MedicalExamRecord[]
  employmentDisputes   EmploymentDispute[]     @relation("DisputeEmployee")
  disciplinaryActions  DisciplinaryAction[]    @relation("DisciplinaryEmployee")
  costAllocations      ProjectCostAllocation[] @relation("EmployeeCostAllocations")
  salesOrders          SalesOrder[]            @relation("SalesOrderSalesperson")
  salesCommissions     SalesCommission[]       @relation("EmployeeSalesCommissions")
  driverProfiles       DriverProfile[]         @relation("DriverEmployee")

  @@unique([companyId, employeeCode])
  @@unique([nidaNumber])
  @@index([companyId, employmentStatus])
  @@index([companyId, departmentId, positionId])
  @@map("employees")
}

/// Mobile-money disbursement account for an employee. An employee may have
/// multiple accounts (e.g. M-Pesa primary, Airtel Money fallback); exactly one
/// must be flagged `isPrimary` when payroll is set to disburse via mobile money.
///
/// `msisdn` should be stored in E.164 format (e.g. +255712345678) — the
/// provider APIs (M-Pesa B2C, Tigo Pesa) all accept that shape.
model MobileMoneyAccount {
  id          String                   @id @default(uuid())
  employeeId  String
  provider    MobileMoneyProvider
  msisdn      String
  accountName String?
  isPrimary   Boolean                  @default(false)
  status      MobileMoneyAccountStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, provider, msisdn])
  @@index([employeeId, isPrimary])
  @@index([provider])
  @@map("mobile_money_accounts")
}

model EmployeeAssignment {
  id                         String                @id @default(uuid())
  employeeId                 String
  companyId                  String
  divisionId                 String?
  branchId                   String?
  licensedBusinessUnitId     String?
  departmentId               String?
  positionId                 String?
  assignmentContextType      AssignmentContextType @default(COMPANY)
  assignmentContextId        String?
  startDate                  DateTime
  endDate                    DateTime?
  isPrimary                  Boolean               @default(false)
  status                     AssignmentStatus      @default(ACTIVE)
  approvalStatus             String                @default("APPROVED")
  transferRequestedById      String?
  transferRequestedAt        DateTime?
  sourceDivisionApprovedById String?
  sourceDivisionApprovedAt   DateTime?
  targetDivisionApprovedById String?
  targetDivisionApprovedAt   DateTime?
  companyGmApprovedById      String?
  companyGmApprovedAt        DateTime?
  groupHrApprovedById        String?
  groupHrApprovedAt          DateTime?
  groupCfoApprovedById       String?
  groupCfoApprovedAt         DateTime?
  notes                      String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  deletedAt                  DateTime?

  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division             Division?             @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  licensedBusinessUnit LicensedBusinessUnit? @relation(fields: [licensedBusinessUnitId], references: [id], onDelete: SetNull)
  department           Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position             Position?             @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([employeeId, status])
  @@index([divisionId, status])
  @@index([branchId, status])
  @@index([companyId, approvalStatus])
  @@index([startDate])
  @@map("employee_assignments")
}

model EmploymentContract {
  id               String                   @id @default(uuid())
  contractCode     String
  companyId        String
  employeeId       String
  contractId       String?
  contractType     EmploymentContractType   @default(PERMANENT)
  startDate        DateTime
  endDate          DateTime?
  salaryAmount     Decimal                  @db.Decimal(18, 2)
  currency         String                   @default("TZS")
  paymentFrequency HRPaymentFrequency       @default(MONTHLY)
  probationEndDate DateTime?
  terms            String?
  status           EmploymentContractStatus @default(DRAFT)
  approvedById     String?
  approvedAt       DateTime?
  documentId       String?
  createdById      String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy  User     @relation("EmploymentContractCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("EmploymentContractApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([companyId, contractCode])
  @@map("employment_contracts")
}

model WorkShift {
  id                     String    @id @default(uuid())
  shiftCode              String
  companyId              String
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  name                   String
  shiftType              ShiftType @default(DAY)
  startTime              String
  endTime                String
  breakMinutes           Int       @default(0)
  expectedHours          Decimal?  @db.Decimal(5, 2)
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division             Division?             @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  licensedBusinessUnit LicensedBusinessUnit? @relation(fields: [licensedBusinessUnitId], references: [id], onDelete: SetNull)
  schedules            ShiftSchedule[]

  @@unique([companyId, shiftCode])
  @@index([companyId, isActive])
  @@map("work_shifts")
}

model ShiftSchedule {
  id                     String                 @id @default(uuid())
  scheduleNumber         String
  companyId              String
  employeeId             String
  workShiftId            String
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  scheduleDate           DateTime
  assignmentContextType  AssignmentContextType?
  assignmentContextId    String?
  status                 ShiftScheduleStatus    @default(SCHEDULED)
  createdById            String
  notes                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deletedAt              DateTime?

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee             Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workShift            WorkShift             @relation(fields: [workShiftId], references: [id], onDelete: Restrict)
  division             Division?             @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  licensedBusinessUnit LicensedBusinessUnit? @relation(fields: [licensedBusinessUnitId], references: [id], onDelete: SetNull)
  createdBy            User                  @relation("ShiftScheduleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  attendanceRecords    AttendanceRecord[]

  @@unique([companyId, scheduleNumber])
  @@index([employeeId, scheduleDate])
  @@index([companyId, scheduleDate])
  @@index([workShiftId])
  @@map("shift_schedules")
}

model AttendanceRecord {
  id                String           @id @default(uuid())
  attendanceNumber  String
  companyId         String
  divisionId        String?
  branchId          String?
  employeeId        String
  shiftScheduleId   String?
  attendanceDate    DateTime
  clockInTime       DateTime?
  clockOutTime      DateTime?
  totalHours        Decimal          @default(0) @db.Decimal(5, 2)
  overtimeHours     Decimal          @default(0) @db.Decimal(5, 2)
  lateMinutes       Int              @default(0)
  earlyLeaveMinutes Int              @default(0)
  attendanceStatus  AttendanceStatus @default(PRESENT)
  source            AttendanceSource @default(MANUAL)
  approvedById      String?
  approvedAt        DateTime?
  createdById       String
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division      Division?      @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shiftSchedule ShiftSchedule? @relation(fields: [shiftScheduleId], references: [id], onDelete: SetNull)
  createdBy     User           @relation("AttendanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy    User?          @relation("AttendanceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([companyId, attendanceNumber])
  @@index([employeeId])
  @@index([attendanceDate])
  @@index([companyId, attendanceDate])
  @@index([divisionId, attendanceDate])
  @@index([branchId, attendanceDate])
  @@map("attendance_records")
}

model LeaveType {
  id                  String    @id @default(uuid())
  companyId           String
  name                String
  code                String
