model IntegrationProvider {
  id               String                    @id @default(uuid())
  providerCode     String                    @unique
  name             String
  providerType     IntegrationProviderType
  description      String?
  baseUrl          String?
  documentationUrl String?
  status           IntegrationProviderStatus @default(ACTIVE)
  supportsWebhooks Boolean                   @default(false)
  supportsSandbox  Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deletedAt        DateTime?

  connections      IntegrationConnection[]
  events           IntegrationEvent[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  externalPayments ExternalPayment[]
  externalMessages ExternalMessage[]
  mappings         IntegrationMapping[]

  @@index([providerCode, status, providerType])
  @@map("integration_providers")
}

model IntegrationConnection {
  id                     String                           @id @default(uuid())
  connectionCode         String                           @unique
  companyId              String?
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  providerId             String
  connectionName         String
  environment            IntegrationConnectionEnvironment @default(SANDBOX)
  status                 IntegrationConnectionStatus      @default(PENDING_SETUP)
  credentialsEncrypted   Json?
  publicConfig           Json?
  privateConfigEncrypted Json?
  lastTestedAt           DateTime?
  lastSuccessAt          DateTime?
  lastErrorAt            DateTime?
  lastErrorMessage       String?
  createdById            String
  createdAt              DateTime                         @default(now())
  updatedAt              DateTime                         @updatedAt
  deletedAt              DateTime?

  provider         IntegrationProvider  @relation(fields: [providerId], references: [id], onDelete: Restrict)
  company          Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy        User                 @relation("IntegrationConnectionCreatedBy", fields: [createdById], references: [id])
  events           IntegrationEvent[]
  webhookEndpoints WebhookEndpoint[]
  webhookEvents    WebhookEvent[]
  externalPayments ExternalPayment[]
  externalMessages ExternalMessage[]
  mappings         IntegrationMapping[]

  @@index([companyId, providerId, status, environment])
  @@map("integration_connections")
}

model IntegrationEvent {
  id              String                    @id @default(uuid())
  eventNumber     String                    @unique
  companyId       String?
  providerId      String?
  connectionId    String?
  eventType       IntegrationEventType      @default(OTHER)
  direction       IntegrationEventDirection @default(OUTBOUND)
  entityType      String?
  entityId        String?
  status          IntegrationEventStatus    @default(PENDING)
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  correlationId   String?
  idempotencyKey  String?
  createdById     String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  company    Company?               @relation(fields: [companyId], references: [id], onDelete: SetNull)
  provider   IntegrationProvider?   @relation(fields: [providerId], references: [id], onDelete: SetNull)
  connection IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  createdBy  User?                  @relation("IntegrationEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, providerId, connectionId, eventType, status, direction, createdAt])
  @@map("integration_events")
}

model WebhookEndpoint {
