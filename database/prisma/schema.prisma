  direction            TaxTransactionDirection  @default(OUTPUT)
  status               TaxTransactionStatus     @default(DRAFT)
  journalEntryId       String?
  createdById          String
  postedById           String?
  postedAt             DateTime?
  notes                String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  taxType   TaxType  @relation(fields: [taxTypeId], references: [id], onDelete: Restrict)
  taxCode   TaxCode? @relation(fields: [taxCodeId], references: [id], onDelete: SetNull)
