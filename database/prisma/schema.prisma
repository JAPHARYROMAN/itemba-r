model SecurityPolicy {
  id           String             @id @default(uuid())
  policyCode   String             @unique
  companyId    String?
  name         String
  policyType   SecurityPolicyType
  settings     Json
  isActive     Boolean            @default(true)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy  User     @relation("SecurityPolicyCreatedBy", fields: [createdById], references: [id])
  approvedBy User?    @relation("SecurityPolicyApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([companyId, policyType, isActive])
  @@map("security_policies")
}

model UserSecurityProfile {
  id                       String            @id @default(uuid())
  userId                   String            @unique
  passwordChangedAt        DateTime?
  passwordExpiresAt        DateTime?
  failedLoginAttempts      Int               @default(0)
  lockedUntil              DateTime?
  lastLoginAt              DateTime?
  lastLoginIp              String?
  lastLoginUserAgent       String?
  lastFailedLoginAt        DateTime?
  lastFailedLoginIp        String?
  twoFactorEnabled         Boolean           @default(false)
  twoFactorMethod          TwoFactorMethod   @default(NONE)
  twoFactorSecretEncrypted String?
  backupCodesHash          Json?
  forcePasswordChange      Boolean           @default(false)
  forceTwoFactorSetup      Boolean           @default(false)
  securityRiskLevel        SecurityRiskLevel @default(LOW)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  user User @relation("UserSecurityProfile", fields: [userId], references: [id])

  @@index([userId, twoFactorEnabled, securityRiskLevel])
  @@map("user_security_profiles")
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation("PasswordHistory", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("password_history")
}

model SecurityEvent {
  id              String                @id @default(uuid())
  eventNumber     String                @unique
  companyId       String?
  userId          String?
  apiClientId     String?
  deviceId        String?
  eventType       SecurityEventType     @default(OTHER)
  severity        SecurityEventSeverity @default(LOW)
  ipAddress       String?
  userAgent       String?
  locationSummary String?
  description     String?
  metadata        Json?
  status          SecurityEventStatus   @default(OPEN)
  reviewedById    String?
  reviewedAt      DateTime?
  resolvedById    String?
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user       User?    @relation("SecurityEventUser", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User?    @relation("SecurityEventReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolvedBy User?    @relation("SecurityEventResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([companyId, userId, eventType, severity, status, createdAt])
  @@index([userId, eventType, createdAt])
  @@index([companyId, severity, status, createdAt])
  @@map("security_events")
}

model ActiveSession {
  id             String              @id @default(uuid())
  sessionCode    String              @unique
  userId         String
  companyId      String?
  deviceId       String?
  sessionType    ActiveSessionType   @default(WEB)
  ipAddress      String?
  userAgent      String?
  deviceSummary  String?
  startedAt      DateTime            @default(now())
  lastActivityAt DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
