model TaxAuthority {
  id            String             @id @default(uuid())
  authorityCode String             @unique
  name          String
  country       String
  region        String?
  authorityType TaxAuthorityType   @default(TAX)
  website       String?
  contactEmail  String?
  contactPhone  String?
  address       String?
  status        TaxAuthorityStatus @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  taxRegistrations CompanyTaxRegistration[]

  @@map("tax_authorities")
}

model CompanyTaxRegistration {
  id                 String                @id @default(uuid())
  registrationCode   String
  companyId          String
  authorityId        String?
  registrationType   TaxRegistrationType   @default(TIN)
  registrationNumber String
  registeredName     String?
  registrationDate   DateTime?
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  status             TaxRegistrationStatus @default(ACTIVE)
  documentId         String?
  notes              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  authority TaxAuthority? @relation(fields: [authorityId], references: [id], onDelete: SetNull)

  @@unique([companyId, registrationCode])
  @@index([registrationNumber])
  @@map("company_tax_registrations")
}

model TaxType {
  id                 String        @id @default(uuid())
  taxTypeCode        String        @unique
  name               String
  taxCategory        TaxCategory   @default(OTHER)
  description        String?
  isRecoverable      Boolean       @default(false)
  isWithholding      Boolean       @default(false)
  appliesToSales     Boolean       @default(false)
  appliesToPurchases Boolean       @default(false)
  appliesToPayroll   Boolean       @default(false)
  appliesToExpenses  Boolean       @default(false)
  status             TaxCodeStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  taxRates                TaxRate[]
  taxCodes                TaxCode[]
  taxTransactions         TaxTransaction[]
  taxFilingPeriods        TaxFilingPeriod[]
  taxReturns              TaxReturn[]
  statutoryDeductionRules StatutoryDeductionRule[]
  payrollStatutoryLines   PayrollStatutoryLine[]

  @@map("tax_types")
}

model TaxRate {
  id                String                   @id @default(uuid())
  taxTypeId         String
  companyId         String?
  rateName          String
  rate              Decimal                  @db.Decimal(10, 4)
  calculationMethod TaxRateCalculationMethod @default(PERCENTAGE)
  effectiveFrom     DateTime
  effectiveTo       DateTime?
  status            TaxRateStatus            @default(ACTIVE)
  createdById       String
  approvedById      String?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?

  taxType    TaxType @relation(fields: [taxTypeId], references: [id], onDelete: Restrict)
  createdBy  User    @relation("TaxRateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("TaxRateApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  taxCodes              TaxCode[]
  taxTransactions       TaxTransaction[]
  brackets              TaxRateBracket[]
  payrollStatutoryLines PayrollStatutoryLine[]

  @@map("tax_rates")
}

/// Tiered tax bracket for a TaxRate. Used by progressive taxes such as
/// Tanzanian PAYE where each monthly-income tier has its own marginal rate
/// and a fixed amount carried over from lower tiers.
///
/// For a row covering "TZS 760,001 – 1,000,000: TZS 68,000 + 25% on excess":
///   fromAmount = 760000, toAmount = 1000000
///   fixedAmount = 68000, marginalRate = 0.25
///
/// `toAmount = null` denotes the open-ended top tier ("above X").
model TaxRateBracket {
  id           String   @id @default(uuid())
  taxRateId    String
  tierOrder    Int
  fromAmount   Decimal  @db.Decimal(18, 2)
  toAmount     Decimal? @db.Decimal(18, 2)
  marginalRate Decimal  @db.Decimal(10, 6)
  fixedAmount  Decimal  @default(0) @db.Decimal(18, 2)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taxRate TaxRate @relation(fields: [taxRateId], references: [id], onDelete: Cascade)

  @@unique([taxRateId, tierOrder])
  @@index([taxRateId])
  @@map("tax_rate_brackets")
}

model TaxCode {
  id          String           @id @default(uuid())
  taxCode     String
  companyId   String?
  taxTypeId   String
  taxRateId   String?
  name        String
  description String?
  appliesTo   TaxCodeAppliesTo @default(GENERAL)
  accountId   String?
  isDefault   Boolean          @default(false)
  status      TaxCodeStatus    @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  taxType TaxType  @relation(fields: [taxTypeId], references: [id], onDelete: Restrict)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  taxTransactions TaxTransaction[]

  @@unique([taxCode, companyId])
  @@map("tax_codes")
}

