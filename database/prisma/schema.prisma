model PayrollRun {
  id                         String           @id @default(uuid())
  payrollRunNumber           String
  companyId                  String
  payrollPeriodId            String
  runDate                    DateTime
  payrollType                PayrollType      @default(REGULAR)
  status                     PayrollRunStatus @default(DRAFT)
  totalGrossPay              Decimal          @default(0) @db.Decimal(18, 2)
  totalAllowances            Decimal          @default(0) @db.Decimal(18, 2)
  totalDeductions            Decimal          @default(0) @db.Decimal(18, 2)
  totalNetPay                Decimal          @default(0) @db.Decimal(18, 2)
  expenseId                  String?
  payableId                  String?
  journalEntryId             String?
  /// FK to the company's chart-of-accounts entry that the net pay is debited
  /// from on payment (typically the bank account the disbursement files were
  /// uploaded to). Falls back to generic Bank (1010) if unset.
  disbursingChartOfAccountId String?
  /// FK to the payment-side journal entry created on `pay()`. Distinct from
  /// `journalEntryId` (the accrual entry on `approve()`).
  paymentJournalEntryId      String?
  createdById                String
  submittedById              String?
  submittedAt                DateTime?
  hrApprovedById             String?
  hrApprovedAt               DateTime?
  financeApprovedById        String?
  financeApprovedAt          DateTime?
  approvedById               String?
  approvedAt                 DateTime?
  paidById                   String?
  paidAt                     DateTime?
  notes                      String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  deletedAt                  DateTime?

  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollPeriod     PayrollPeriod           @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)
  createdBy         User                    @relation("PayrollRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  submittedBy       User?                   @relation("PayrollRunSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  hrApprovedBy      User?                   @relation("PayrollRunHrApprovedBy", fields: [hrApprovedById], references: [id], onDelete: SetNull)
  financeApprovedBy User?                   @relation("PayrollRunFinanceApprovedBy", fields: [financeApprovedById], references: [id], onDelete: SetNull)
  approvedBy        User?                   @relation("PayrollRunApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy            User?                   @relation("PayrollRunPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  entries           PayrollEntry[]
  salaryPayments    SalaryPayment[]
  costAllocations   ProjectCostAllocation[]

  @@unique([companyId, payrollRunNumber])
  @@index([companyId, status])
  @@map("payroll_runs")
}

model PayrollEntry {
  id              String             @id @default(uuid())
  payrollRunId    String
  companyId       String
  employeeId      String
  basePay         Decimal            @default(0) @db.Decimal(18, 2)
  attendancePay   Decimal            @default(0) @db.Decimal(18, 2)
  overtimePay     Decimal            @default(0) @db.Decimal(18, 2)
  totalAllowances Decimal            @default(0) @db.Decimal(18, 2)
  grossPay        Decimal            @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal            @default(0) @db.Decimal(18, 2)
  netPay          Decimal            @default(0) @db.Decimal(18, 2)
  daysWorked      Decimal?           @db.Decimal(5, 2)
  hoursWorked     Decimal?           @db.Decimal(7, 2)
  overtimeHours   Decimal?           @db.Decimal(5, 2)
  status          PayrollEntryStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  deletedAt       DateTime?

  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  payrollRun       PayrollRun              @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)
  employee         Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  allowances       PayrollEntryAllowance[]
  deductions       PayrollEntryDeduction[]
  statutoryLines   PayrollStatutoryLine[]
  salaryPayments   SalaryPayment[]
  costAllocations  ProjectCostAllocation[]
  salesCommissions SalesCommission[]       @relation("PayrollEntrySalesCommissions")

  @@unique([payrollRunId, employeeId])
  @@index([companyId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@index([companyId, status, createdAt])
  @@map("payroll_entries")
}

model PayrollEntryAllowance {
  id                String   @id @default(uuid())
  payrollEntryId    String
  allowanceTypeId   String
  description       String?
  amount            Decimal  @db.Decimal(18, 2)
  taxable           Boolean  @default(true)
  /// Optional FK to a SalesCommission — set when this allowance is paying
  /// out an APPROVED commission. Used by PayrollRunsService.pay() to flip
  /// the commission status to PAID without parsing descriptions.
  salesCommissionId String?
  createdAt         DateTime @default(now())

  payrollEntry    PayrollEntry     @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  allowanceType   AllowanceType    @relation(fields: [allowanceTypeId], references: [id], onDelete: Restrict)
  salesCommission SalesCommission? @relation("SalesCommissionPayout", fields: [salesCommissionId], references: [id], onDelete: SetNull)

  @@index([salesCommissionId])
  @@map("payroll_entry_allowances")
}

model PayrollEntryDeduction {
  id              String   @id @default(uuid())
  payrollEntryId  String
  deductionTypeId String
  description     String?
  amount          Decimal  @db.Decimal(18, 2)
  statutory       Boolean  @default(false)
  /// Optional FK to a SalaryAdvance — set when this deduction is part of an
  /// advance-recovery installment. Used by PayrollRunsService.pay() to update
  /// the advance's recoveredAmount cleanly without parsing descriptions.
  salaryAdvanceId String?
  createdAt       DateTime @default(now())

  payrollEntry  PayrollEntry   @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  deductionType DeductionType  @relation(fields: [deductionTypeId], references: [id], onDelete: Restrict)
  salaryAdvance SalaryAdvance? @relation("AdvanceRecoveryDeductions", fields: [salaryAdvanceId], references: [id], onDelete: SetNull)

  @@index([salaryAdvanceId])
  @@map("payroll_entry_deductions")
}

/// Per-employee, per-payroll-run breakdown of every statutory contribution
/// (PAYE, NSSF, PSSSF, WCF, SDL, NHIF, HESLB). Written by the payroll
/// calculation engine. Critical for filing monthly returns — operators can
/// regenerate any return month-on-month from these rows alone.
///
/// Each row links to:
///   - the TaxType it belongs to (so returns aggregate by type),
///   - optionally the StatutoryDeductionRule used (audit trail),
///   - optionally the TaxRate used (for tiered taxes like PAYE).
///
/// `basis` records what the calculation was applied to (gross / basic / etc.)
/// so the math is reproducible without reading code.
model PayrollStatutoryLine {
  id                       String                @id @default(uuid())
  payrollEntryId           String
  taxTypeId                String
  taxFilingPeriodId        String?
  statutoryDeductionRuleId String?
  taxRateId                String?
  basis                    PayrollStatutoryBasis @default(GROSS)
  basisAmount              Decimal               @db.Decimal(18, 2)
  employeeContribution     Decimal               @default(0) @db.Decimal(18, 2)
  employerContribution     Decimal               @default(0) @db.Decimal(18, 2)
  appliedRate              Decimal?              @db.Decimal(10, 6)
  /// Free-form per-row breakdown (e.g. PAYE bracket steps used) — JSON.
  calculationDetail        Json?
  notes                    String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  payrollEntry           PayrollEntry            @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  taxType                TaxType                 @relation(fields: [taxTypeId], references: [id], onDelete: Restrict)
  taxFilingPeriod        TaxFilingPeriod?        @relation(fields: [taxFilingPeriodId], references: [id], onDelete: SetNull)
  statutoryDeductionRule StatutoryDeductionRule? @relation(fields: [statutoryDeductionRuleId], references: [id], onDelete: SetNull)
  taxRate                TaxRate?                @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([payrollEntryId])
  @@index([taxTypeId])
  @@index([taxFilingPeriodId])
  @@map("payroll_statutory_lines")
}

enum PayrollStatutoryBasis {
  GROSS
  BASIC
  PENSIONABLE
  TAXABLE_INCOME
  CUSTOM
}

model SalaryPayment {
