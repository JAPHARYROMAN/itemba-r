  PROMOTIONAL
  CONTRACTOR
  INTERNAL_COMPANY
  OTHER
}

enum PriceListStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum CustomerPriceAgreementStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  CANCELLED
}

enum ProductBatchStatus {
  ACTIVE
  EXPIRED
  SOLD_OUT
  QUARANTINED
  DAMAGED
  DISPOSED
}

enum StockDamageType {
  BREAKAGE
  EXPIRED
  SPOILED
  LOST
  THEFT
  DAMAGED_PACKAGING
  OTHER
}

enum StockDamageStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
  CANCELLED
