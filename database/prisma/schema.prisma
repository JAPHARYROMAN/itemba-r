// GROUP-CONTROLLED SENSITIVE RECORDS
// All models below are OWNED by a Company (or the Group itself) but are
// accessible ONLY through GROUP-scoped permissions (Group Control layer).
// ───────────────────────────────────────────────────────────────────────────────

/// Bank accounts owned by a company or the group.
/// Requires group-control permission: bank-accounts.read / bank-accounts.write.
model BankAccount {
  id            String          @id @default(uuid())
  /// Null when this is a group-level account.
  companyId     String?
  divisionId    String?
  branchId      String?
  /// Set only when companyId is null (pure group-level account).
  groupId       String?
  bankName      String
  branchName    String?
  accountName   String
  accountNumber String
  accountType   BankAccountType @default(CURRENT)
  currency      CurrencyCode    @default(TZS)
  isActive      Boolean         @default(true)
  isPrimary     Boolean         @default(false)
  openedDate    DateTime?
  swiftCode     String?
  bankAddress   String?
  notes         String?
  createdById   String?
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division     Division?     @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  group        Group?        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  documents    Document[]    @relation("BankAccountDocuments")
  cashAccounts CashAccount[]

  @@unique([bankName, accountNumber])
  @@index([companyId])
  @@index([divisionId])
  @@index([branchId])
  @@index([groupId])
  @@map("bank_accounts")
}

/// Loans and financial obligations taken by the group or a specific company.
/// Covers bank loans, overdrafts, asset finance, mortgages, director loans,
/// inter-company loans, supplier credit, and institutional debt.
/// Requires group-control permission: loans.read / loans.manage.
model Loan {
  id                    String             @id @default(uuid())
  /// The type of financial obligation.
  obligationType        ObligationType     @default(BANK_LOAN)
  /// Whether this obligation belongs to the Group or a specific Company.
  borrowerLevel         BorrowerLevel      @default(COMPANY)
  /// Set when borrowerLevel = COMPANY.
  companyId             String?
  divisionId            String?
  branchId              String?
  /// Set when borrowerLevel = GROUP.
  groupId               String?
  loanReference         String?
  lenderName            String
  /// "Bank", "SACCO", "Individual", "Microfinance", "Director", etc.
  lenderType            String?
  lenderContact         String?
  principalAmount       Decimal            @db.Decimal(18, 2)
  currency              CurrencyCode       @default(TZS)
  /// Annual interest rate stored as a decimal fraction: 0.18 = 18%
  interestRate          Decimal            @db.Decimal(6, 4)
  disbursementDate      DateTime
  maturityDate          DateTime
  repaymentFrequency    RepaymentFrequency @default(MONTHLY)
  /// Scheduled repayment amount per period.
  repaymentAmount       Decimal?           @db.Decimal(18, 2)
  /// Current outstanding balance (updated after each repayment).
  outstandingBalance    Decimal            @db.Decimal(18, 2)
  status                LoanStatus         @default(ACTIVE)
  riskLevel             RiskLevel          @default(LOW)
  purpose               String?
  collateralDescription String?
  /// IDs of FixedAsset records used as collateral for this loan.
  linkedAssetIds        String[]           @default([])
  guarantorName         String?
  guarantorContact      String?
  guaranteeDetails      String?
  bankAccountId         String?
  notes                 String?
  createdById           String?
  approvedById          String?
  approvedAt            DateTime?
  deletedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  company    Company?        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division   Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch     Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  group      Group?          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  repayments LoanRepayment[]
  documents  Document[]      @relation("LoanDocuments")

  @@index([companyId])
  @@index([divisionId])
  @@index([branchId])
  @@index([groupId])
  @@index([status])
  @@index([obligationType])
  @@index([riskLevel])
  @@index([maturityDate])
  @@index([companyId, status, maturityDate])
  @@index([companyId, createdAt])
  @@map("loans")
}

/// Individual repayment record for a Loan.
model LoanRepayment {
  id               String       @id @default(uuid())
  loanId           String
  repaymentDate    DateTime
  amount           Decimal      @db.Decimal(18, 2)
  currency         CurrencyCode @default(TZS)
  /// Portion applied to principal.
  principal        Decimal?     @db.Decimal(18, 2)
  /// Portion applied to interest.
  interest         Decimal?     @db.Decimal(18, 2)
  /// Any penalty or late fees.
  penalties        Decimal?     @db.Decimal(18, 2)
  /// Remaining balance after this repayment.
  remainingBalance Decimal?     @db.Decimal(18, 2)
  paymentMethod    String?
  referenceNumber  String?
  notes            String?
  recordedById     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([repaymentDate])
  @@map("loan_repayments")
}

/// Debts owed by a company to creditors (trade payables, accruals, obligations).
model Debt {
  id              String       @id @default(uuid())
  companyId       String
  creditorName    String
  creditorContact String?
  amount          Decimal      @db.Decimal(18, 2)
  /// Amount already paid (for partial payments).
  amountPaid      Decimal      @default(0) @db.Decimal(18, 2)
  currency        CurrencyCode @default(TZS)
  dueDate         DateTime?
  description     String
  invoiceNumber   String?
  status          DebtStatus   @default(OUTSTANDING)
  riskLevel       RiskLevel    @default(LOW)
  notes           String?
  createdById     String?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documents Document[] @relation("DebtDocuments")

  @@index([companyId])
  @@index([status])
  @@index([dueDate])
  @@index([riskLevel])
  @@index([companyId, status, dueDate])
  @@index([companyId, createdAt])
  @@map("debts")
}

/// Legally binding contracts (supplier, customer, lease, employment, etc.).
model Contract {
  id                  String                 @id @default(uuid())
  /// Whether this contract belongs to the Group or a specific Company.
  owningLevel         ContractOwnershipLevel @default(COMPANY)
  /// Set when owningLevel = COMPANY.
  companyId           String?
  /// Set when owningLevel = GROUP.
  groupId             String?
  /// Optionally scoped to a division or branch.
  divisionId          String?
  branchId            String?
  title               String
  contractType        ContractType
  contractNumber      String?
  counterpartyName    String
  counterpartyContact String?
  counterpartyAddress String?
  startDate           DateTime
  endDate             DateTime?
  renewalDate         DateTime?
  renewalNoticeDate   DateTime?
  autoRenews          Boolean                @default(false)
  value               Decimal?               @db.Decimal(18, 2)
  currency            CurrencyCode           @default(TZS)
  paymentTerms        String?
  obligations         String?
  status              ContractStatus         @default(DRAFT)
  riskLevel           RiskLevel              @default(LOW)
  isSensitive         Boolean                @default(false)
  responsiblePersonId String?
  signatoryUserId     String?
  description         String?
  notes               String?
  createdById         String?
  deletedAt           DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  documents Document[] @relation("ContractDocuments")

  @@index([companyId])
  @@index([groupId])
  @@index([status])
  @@index([contractType])
  @@index([endDate])
  @@index([riskLevel])
  @@index([owningLevel])
  @@map("contracts")
}

/// Fixed / capital assets owned by the group or a company, optionally assigned to a division/branch.
/// Requires group-control permission: fixed-assets.read / fixed-assets.manage.
model FixedAsset {
  id               String                @id @default(uuid())
  /// Who legally owns this asset — the group or a specific company.
  ownershipLevel   AssetOwnershipLevel   @default(COMPANY)
  /// Set when ownershipLevel = COMPANY. Null for group-owned assets.
  companyId        String?
  /// Set when ownershipLevel = GROUP. Null for company-owned assets.
  groupId          String?
  /// Division this asset is assigned/deployed to.
  divisionId       String?
  /// Branch/site/farm this asset is physically assigned to.
  branchId         String?
  /// Asset code unique across the system (e.g. FA-2024-001).
  assetCode        String                @unique
  name             String
  category         FixedAssetCategory
  description      String?
  acquisitionDate  DateTime
  acquisitionCost  Decimal               @db.Decimal(18, 2)
  currency         CurrencyCode          @default(TZS)
  currentBookValue Decimal               @db.Decimal(18, 2)
  /// Annual depreciation rate as decimal fraction: 0.25 = 25%
  depreciationRate Decimal?              @db.Decimal(6, 4)
  usefulLifeYears  Int?
  residualValue    Decimal?              @db.Decimal(18, 2)
  serialNumber     String?
  make             String?
  model            String?
  /// Registration number for vehicles / trucks / plant.
  registrationNo   String?
  location         String?
  condition        AssetCondition?
  financingStatus  AssetFinancingStatus  @default(OWNED_OUTRIGHT)
  collateralStatus AssetCollateralStatus @default(NOT_COLLATERAL)
  insuranceStatus  AssetInsuranceStatus  @default(NOT_INSURED)
  status           FixedAssetStatus      @default(ACTIVE)
  disposalDate     DateTime?
  disposalValue    Decimal?              @db.Decimal(18, 2)
  notes            String?
  createdById      String?
  deletedAt        DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company   Company?   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  group     Group?     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  division  Division?  @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch    Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  documents Document[] @relation("FixedAssetDocuments")

  // Itemba (Milestone 7)
  vehicleAssets         Vehicle[]              @relation("VehicleFixedAsset")
  farmAssets            Farm[]                 @relation("FarmFixedAsset")
  equipmentUsages       EquipmentUsage[]
  depreciationSchedules DepreciationSchedule[]
  depreciationEntries   DepreciationEntry[]

  @@index([companyId])
  @@index([groupId])
  @@index([divisionId])
  @@index([branchId])
  @@index([category])
  @@index([status])
  @@index([collateralStatus])
  @@index([insuranceStatus])
  @@map("fixed_assets")
}

// ───────────────────────────────────────────────────────────────────────────────
// DOCUMENTS
// ───────────────────────────────────────────────────────────────────────────────

/// Stores metadata for every file in the system.
/// The binary is held in the storage driver (local filesystem → S3-compatible).
/// Linked to an owning entity via ownerType enum + ownerId string,
/// PLUS typed nullable FKs for entities that exist in this schema (referential integrity).
/// Future entity types (Employee, Supplier, Customer) use ownerType + ownerId only.
model Document {
  id             String            @id @default(uuid())
  documentCode   String?
  title          String
  description    String?
  category       DocumentCategory  @default(OTHER)
  ownerType      DocumentOwnerType
  ownerId        String
  fileName       String
  /// Unique path / key in the storage backend.
  storageKey     String            @unique
  mimeType       String
  fileSizeBytes  Int?
  /// When true, the document is treated as Group Control–sensitive.
  isConfidential Boolean           @default(false)
  status         DocumentStatus    @default(ACTIVE)
  expiryDate     DateTime?
  renewalDate    DateTime?
  version        Int               @default(1)
  tags           String[]          @default([])
  // Typed nullable FKs — referential integrity for known entities.
  groupId        String?
  companyId      String?
  divisionId     String?
  branchId       String?
  bankAccountId  String?
  loanId         String?
  debtId         String?
  contractId     String?
  fixedAssetId   String?
  uploadedById   String?
  deletedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  group                 Group?                 @relation("GroupDocuments", fields: [groupId], references: [id], onDelete: SetNull)
  company               Company?               @relation("CompanyDocuments", fields: [companyId], references: [id], onDelete: SetNull)
  division              Division?              @relation("DivisionDocuments", fields: [divisionId], references: [id], onDelete: SetNull)
  branch                Branch?                @relation("BranchDocuments", fields: [branchId], references: [id], onDelete: SetNull)
  bankAccount           BankAccount?           @relation("BankAccountDocuments", fields: [bankAccountId], references: [id], onDelete: SetNull)
  loan                  Loan?                  @relation("LoanDocuments", fields: [loanId], references: [id], onDelete: SetNull)
  debt                  Debt?                  @relation("DebtDocuments", fields: [debtId], references: [id], onDelete: SetNull)
  contract              Contract?              @relation("ContractDocuments", fields: [contractId], references: [id], onDelete: SetNull)
  fixedAsset            FixedAsset?            @relation("FixedAssetDocuments", fields: [fixedAssetId], references: [id], onDelete: SetNull)
  uploadedBy            User?                  @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  financialAttachments  FinancialAttachment[]
  operationsAttachments OperationsAttachment[]
  petroleumAttachments  PetroleumAttachment[]

  // Westsides (Milestone 6)
  westsidesAttachments WestsidesAttachment[]

  // HR (Milestone 9)
  hrDocuments HRDocument[] @relation("HRDocumentBacking")

  @@unique([companyId, documentCode])
  @@index([ownerType, ownerId])
  @@index([companyId])
  @@index([isConfidential])
  @@index([category])
  @@index([status])
  @@index([expiryDate])
  @@map("documents")
}

// ───────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ───────────────────────────────────────────────────────────────────────────────

/// Append-only audit trail — must NEVER be updated or deleted.
/// Covers: CREATE, UPDATE, DELETE, LOGIN, LOGOUT, APPROVE, EXPORT, VIEW_SENSITIVE.
model AuditLog {
  id         String        @id @default(uuid())
  action     String
  entityType String
  entityId   String?
  userId     String?
  companyId  String?
  /// Snapshot of the record BEFORE the change (null for CREATE / LOGIN).
  oldValue   Json?
  /// Snapshot of the record AFTER the change (null for DELETE / LOGOUT).
  newValue   Json?
  /// Additional context that does not fit old/new value.
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  severity   AuditSeverity @default(LOW)
  createdAt  DateTime      @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([companyId])
  @@index([action])
  @@index([severity])
  @@index([createdAt])
  @@index([companyId, entityType, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ───────────────────────────────────────────────────────────────────────────────
// AUTH — REFRESH TOKEN SESSIONS
// ───────────────────────────────────────────────────────────────────────────────

/// Tracks issued refresh tokens to support logout and session revocation.
/// The token value is stored as a peppered HMAC lookup hash — never in plain text.
model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique
  /// All tokens minted from the same login share a familyId. On suspected reuse
  /// of a revoked sibling, every token in the family is revoked at once.
  familyId      String?
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?
  revokedAt     DateTime?
  /// Why this token was revoked (e.g. ROTATION, REUSE_DETECTED, LOGOUT, PASSWORD_RESET).
  revokedReason String?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MILESTONE 3 — FINANCE FOUNDATION
// Multi-company accounting: COA, fiscal periods, journals, cash, expenses,
// AR, AP, inter-company, plus financial-attachment links to Documents Vault.
// ═══════════════════════════════════════════════════════════════════════════════

// ───────────────────────────────────────────────────────────────────────────────
// FINANCE ENUMS
// ───────────────────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
  COST_OF_GOODS_SOLD
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
  VOIDED
}

enum CashAccountType {
  CASH_ON_HAND
  BANK
  MOBILE_MONEY
  PETTY_CASH
  OTHER
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  REJECTED
  VOIDED
}

enum ReceivableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  WRITTEN_OFF
  CANCELLED
}

enum PayableStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  WRITTEN_OFF
  CANCELLED
}

enum InterCompanyTxType {
  LOAN
  SERVICE_CHARGE
  STOCK_TRANSFER
  ASSET_TRANSFER
  EXPENSE_ALLOCATION
  PAYMENT_ON_BEHALF
  INTERNAL_SALE
  INTERNAL_PURCHASE
  OTHER
}

enum InterCompanyTxStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

// ───────────────────────────────────────────────────────────────────────────────
// CHART OF ACCOUNTS / FISCAL PERIODS
// ───────────────────────────────────────────────────────────────────────────────

model ChartOfAccount {
  id              String      @id @default(uuid())
  companyId       String
  divisionId      String?
  branchId        String?
  accountCode     String
  accountName     String
  accountType     AccountType
  accountSubType  String?
  parentAccountId String?
  description     String?
  isSystemAccount Boolean     @default(false)
  isActive        Boolean     @default(true)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company              Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division             Division?                   @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  parentAccount        ChartOfAccount?             @relation("AccountHierarchy", fields: [parentAccountId], references: [id], onDelete: SetNull)
  childAccounts        ChartOfAccount[]            @relation("AccountHierarchy")
  journalLines         JournalEntryLine[]
  postingRuleLines     AccountingPostingRuleLine[]
  auditAdjustmentLines AuditAdjustmentLine[]       @relation("AuditAdjustmentLineAccount")

  @@unique([companyId, accountCode])
  @@unique([companyId, accountName])
  @@index([companyId])
  @@index([divisionId])
  @@index([branchId])
  @@index([accountType])
  @@map("chart_of_accounts")
}

model FiscalYear {
  id        String             @id @default(uuid())
  companyId String
  name      String
  startDate DateTime
  endDate   DateTime
  status    FiscalPeriodStatus @default(OPEN)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  periods          AccountingPeriod[]
  periodCloses     AccountingPeriodClose[]
  accountingLocks  AccountingLock[]
  procurementPlans ProcurementPlan[]
  auditAdjustments AuditAdjustment[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("fiscal_years")
}

model AccountingPeriod {
  id           String             @id @default(uuid())
  companyId    String
  fiscalYearId String
  name         String
  startDate    DateTime
  endDate      DateTime
  status       FiscalPeriodStatus @default(OPEN)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Switched from Cascade to Restrict: deleting a fiscal year must NOT
  // silently wipe accounting periods (and their journal entries cascade
  // graph). Fiscal years should be soft-deleted in practice.
  fiscalYear       FiscalYear              @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  journalEntries   JournalEntry[]
  periodCloses     AccountingPeriodClose[]
  accountingLocks  AccountingLock[]
  auditAdjustments AuditAdjustment[]

  @@unique([fiscalYearId, name])
  @@index([companyId])
  @@index([fiscalYearId])
  @@map("accounting_periods")
}

// ───────────────────────────────────────────────────────────────────────────────
// JOURNAL ENTRIES
// ───────────────────────────────────────────────────────────────────────────────

model JournalEntry {
  id                 String             @id @default(uuid())
  journalNumber      String
  companyId          String
  divisionId         String?
  branchId           String?
  accountingPeriodId String?
  transactionDate    DateTime
  description        String
  referenceType      String?
  referenceId        String?
  status             JournalEntryStatus @default(DRAFT)
  totalDebit         Decimal            @default(0) @db.Decimal(18, 2)
  totalCredit        Decimal            @default(0) @db.Decimal(18, 2)
  createdById        String
  postedById         String?
  postedAt           DateTime?
  reversedById       String?
  reversedAt         DateTime?
  reversalReason     String?
  reversalOfId       String?
  deletedAt          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  accountingPeriod  AccountingPeriod?         @relation(fields: [accountingPeriodId], references: [id], onDelete: SetNull)
  createdBy         User                      @relation("JournalEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  postedBy          User?                     @relation("JournalEntryPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reversedBy        User?                     @relation("JournalEntryReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  reversalOf        JournalEntry?             @relation("JournalEntryReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy_       JournalEntry[]            @relation("JournalEntryReversal")
  lines             JournalEntryLine[]
  expensesPosted    Expense[]
  receivablesPosted Receivable[]
  payablesPosted    Payable[]
  creditNotesPosted CreditNote[]
  refundsPosted     Refund[]
  customerPaymentsPosted   CustomerPayment[] @relation("CustomerPaymentJournalEntry")
  customerPaymentsReversed CustomerPayment[] @relation("CustomerPaymentReversalJournalEntry")
  intercompanyFrom  InterCompanyTransaction[] @relation("InterCompanyFromJE")
  intercompanyTo    InterCompanyTransaction[] @relation("InterCompanyToJE")

  @@unique([companyId, journalNumber])
  @@index([companyId])
  @@index([accountingPeriodId])
  @@index([status])
  @@index([transactionDate])
  @@index([companyId, transactionDate, status])
  @@index([accountingPeriodId, status])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String   @id @default(uuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  companyId      String
  divisionId     String?
  branchId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@index([companyId])
  @@index([companyId, accountId, createdAt])
  @@map("journal_entry_lines")
}

// ───────────────────────────────────────────────────────────────────────────────
// CASH ACCOUNTS
// ───────────────────────────────────────────────────────────────────────────────

model CashAccount {
  id                  String          @id @default(uuid())
  companyId           String
  divisionId          String?
  branchId            String?
  linkedBankAccountId String?
  accountName         String
  accountType         CashAccountType @default(CASH_ON_HAND)
  currency            CurrencyCode    @default(TZS)
  openingBalance      Decimal         @default(0) @db.Decimal(18, 2)
  currentBalance      Decimal         @default(0) @db.Decimal(18, 2)
  isActive            Boolean         @default(true)
  notes               String?
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division             Division?             @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  linkedBank           BankAccount?          @relation(fields: [linkedBankAccountId], references: [id], onDelete: SetNull)
  expenses             Expense[]
  fuelShiftCollections FuelShiftCollection[]
  salesOrders          SalesOrder[]          @relation("SalesOrderCashAccount")
  refunds              Refund[]
  customerPayments     CustomerPayment[]

  // Westsides (Milestone 6)
  bankReconciliations BankReconciliation[]

  @@index([companyId])
  @@index([divisionId])
  @@index([branchId])
  @@map("cash_accounts")
}

