// ─── SalesChannel ─────────────────────────────────────────────────────────────
model SalesChannel {
  id          String           @id @default(uuid())
  companyId   String
  branchId    String?
  name        String
  channelType SalesChannelType
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([branchId])
  @@index([channelType])
  @@map("sales_channels")
}

// ─── PriceList ─────────────────────────────────────────────────────────────────
model PriceList {
  id            String          @id @default(uuid())
  companyId     String
  name          String
  priceListType PriceListType
  currency      CurrencyCode    @default(TZS)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        PriceListStatus @default(ACTIVE)
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  company            Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy          User                     @relation("PriceListCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy         User?                    @relation("PriceListApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  items              PriceListItem[]
  customerAgreements CustomerPriceAgreement[]

  @@index([companyId])
  @@index([status])
  @@index([priceListType])
  @@map("price_lists")
}

