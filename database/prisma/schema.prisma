  unit          UnitOfMeasure @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([purchaseOrderId, createdAt])
  @@map("purchase_order_lines")
}

model OperationsAttachment {
  id         String   @id @default(uuid())
  companyId  String
  entityType String
  entityId   String
  documentId String
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, documentId])
  @@index([companyId])
  @@index([entityType, entityId])
  @@map("operations_attachments")
}

// ═══════════════════════════════════════════════════════════════════════════════
// MILESTONE 5 — MWANJALISI OIL PETROLEUM OPERATIONS
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Petroleum Enums ────────────────────────────────────────────────────────

enum FuelTankStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  CLOSED
}

enum FuelPumpStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  CLOSED
}

enum FuelNozzleStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  CLOSED
}

enum FuelPriceStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

enum FuelShiftType {
  DAY
  NIGHT
  CUSTOM
}

enum FuelShiftStatus {
  OPEN
  SUBMITTED
  SUPERVISOR_APPROVED
  MANAGER_APPROVED
  REJECTED
  CLOSED
  VOIDED
}

enum FuelNozzleReadingStatus {
  OPEN
  CLOSED
  DISPUTED
  VOIDED
}

enum FuelTankDipStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  POSTED
}

enum FuelShiftCollectionType {
  CASH
  MOBILE_MONEY
  BANK_CARD
  BANK_DEPOSIT
  CREDIT_SALE
  VOUCHER
  OTHER
}

enum FuelCreditSaleStatus {
  OPEN
  INVOICED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum FuelDeliveryStatus {
  DRAFT
  RECEIVED
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

enum FuelDailyReconciliationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
}

// ─── Petroleum Models ───────────────────────────────────────────────────────

model FuelTank {
  id                 String         @id @default(uuid())
  tankCode           String
  companyId          String
  divisionId         String?
  branchId           String
  productId          String
  tankName           String
  capacityLitres     Decimal        @db.Decimal(18, 2)
  currentBookBalance Decimal        @default(0) @db.Decimal(18, 2)
  lastDipBalance     Decimal?       @db.Decimal(18, 2)
  status             FuelTankStatus @default(ACTIVE)
  installationDate   DateTime?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  nozzles        FuelNozzle[]
  tankDips       FuelTankDip[]
  deliveries     FuelDelivery[]
  pumps          FuelPump[]
  nozzleReadings FuelNozzleReading[]

  @@unique([branchId, tankCode])
  @@index([companyId])
  @@index([branchId])
  @@index([productId])
  @@index([status])
  @@map("fuel_tanks")
}

model FuelPump {
  id               String         @id @default(uuid())
  pumpCode         String
  companyId        String
  divisionId       String?
  branchId         String
  tankId           String?
  pumpName         String
  status           FuelPumpStatus @default(ACTIVE)
  installationDate DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tank     FuelTank? @relation(fields: [tankId], references: [id], onDelete: SetNull)

  nozzles         FuelNozzle[]
  shiftAttendants FuelShiftAttendant[]
  nozzleReadings  FuelNozzleReading[]

  @@unique([branchId, pumpCode])
  @@index([companyId])
  @@index([branchId])
  @@index([tankId])
  @@index([status])
  @@map("fuel_pumps")
}

model FuelNozzle {
  id                  String           @id @default(uuid())
  nozzleCode          String
  companyId           String
  divisionId          String?
  branchId            String
  pumpId              String
  tankId              String
  productId           String
  nozzleName          String?
  openingMeter        Decimal          @default(0) @db.Decimal(18, 3)
  currentMeterReading Decimal          @default(0) @db.Decimal(18, 3)
  status              FuelNozzleStatus @default(ACTIVE)
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  pump     FuelPump  @relation(fields: [pumpId], references: [id], onDelete: Restrict)
  tank     FuelTank  @relation(fields: [tankId], references: [id], onDelete: Restrict)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  nozzleReadings FuelNozzleReading[]

  @@unique([pumpId, nozzleCode])
  @@index([companyId])
  @@index([branchId])
  @@index([pumpId])
  @@index([tankId])
  @@index([productId])
  @@map("fuel_nozzles")
}

model FuelPrice {
  id            String          @id @default(uuid())
  companyId     String
  branchId      String?
  productId     String
  pricePerLitre Decimal         @db.Decimal(18, 4)
  currency      CurrencyCode    @default(TZS)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  status        FuelPriceStatus @default(ACTIVE)
  createdById   String
  approvedById  String?
  approvedAt    DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  product    Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdBy  User    @relation("FuelPriceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("FuelPriceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([branchId])
  @@index([productId])
  @@index([status])
  @@index([effectiveFrom])
  @@map("fuel_prices")
}

model FuelShift {
  id                     String          @id @default(uuid())
  shiftNumber            String
  companyId              String
  divisionId             String?
  branchId               String
  shiftType              FuelShiftType   @default(DAY)
  shiftDate              DateTime        @db.Date
  startTime              DateTime
  endTime                DateTime?
  status                 FuelShiftStatus @default(OPEN)
  openedById             String
  submittedById          String?
  submittedAt            DateTime?
  supervisorApprovedById String?
  supervisorApprovedAt   DateTime?
  managerApprovedById    String?
  managerApprovedAt      DateTime?
  rejectedById           String?
  rejectedAt             DateTime?
  rejectionReason        String?
  notes                  String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  deletedAt              DateTime?

  company            Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division           Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch             Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedBy           User      @relation("ShiftOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  submittedBy        User?     @relation("ShiftSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  supervisorApproved User?     @relation("ShiftSupervisorApprovedBy", fields: [supervisorApprovedById], references: [id], onDelete: SetNull)
  managerApproved    User?     @relation("ShiftManagerApprovedBy", fields: [managerApprovedById], references: [id], onDelete: SetNull)
  rejectedBy         User?     @relation("ShiftRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)

  attendants     FuelShiftAttendant[]
  nozzleReadings FuelNozzleReading[]
  collections    FuelShiftCollection[]
  creditSales    FuelCreditSale[]

  @@unique([companyId, shiftNumber])
  @@index([companyId])
  @@index([branchId])
  @@index([shiftDate])
  @@index([status])
  @@map("fuel_shifts")
}

/// Attendant assignment on a fuel shift. An attendant can be:
///  - A system User (legacy `attendantId`, kept for back-compat)
///  - A payroll Employee (preferred — pump attendants are typically paid via
///    payroll and may not have a system login)
///  - A free-text name (`attendantName`) — for casual / temporary workers not
///    yet on the payroll register
/// The application enforces that at least one of the three is set.
model FuelShiftAttendant {
  id             String   @id @default(uuid())
  fuelShiftId    String
  attendantId    String?
  employeeId     String?
  attendantName  String?
  assignedPumpId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  fuelShift    FuelShift @relation(fields: [fuelShiftId], references: [id], onDelete: Cascade)
  attendant    User?     @relation("ShiftAttendant", fields: [attendantId], references: [id], onDelete: Restrict)
  employee     Employee? @relation("ShiftAttendantEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedPump FuelPump? @relation(fields: [assignedPumpId], references: [id], onDelete: SetNull)

  @@index([fuelShiftId])
  @@index([attendantId])
  @@index([employeeId])
  @@map("fuel_shift_attendants")
}

model FuelNozzleReading {
  id             String                  @id @default(uuid())
  fuelShiftId    String
  companyId      String
  branchId       String
  nozzleId       String
  pumpId         String
  tankId         String
  productId      String
  attendantId    String?
  openingMeter   Decimal                 @db.Decimal(18, 3)
  closingMeter   Decimal?                @db.Decimal(18, 3)
  litresSold     Decimal                 @default(0) @db.Decimal(18, 3)
  pricePerLitre  Decimal                 @db.Decimal(18, 4)
  expectedAmount Decimal                 @default(0) @db.Decimal(18, 2)
  status         FuelNozzleReadingStatus @default(OPEN)
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  fuelShift FuelShift  @relation(fields: [fuelShiftId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  nozzle    FuelNozzle @relation(fields: [nozzleId], references: [id], onDelete: Restrict)
  pump      FuelPump   @relation(fields: [pumpId], references: [id], onDelete: Restrict)
  tank      FuelTank   @relation(fields: [tankId], references: [id], onDelete: Restrict)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  attendant User?      @relation("NozzleReadingAttendant", fields: [attendantId], references: [id], onDelete: SetNull)

  @@index([fuelShiftId])
  @@index([companyId])
  @@index([branchId])
  @@index([nozzleId])
  @@index([tankId])
  @@map("fuel_nozzle_readings")
}

model FuelTankDip {
  id                String            @id @default(uuid())
  dipNumber         String
  companyId         String
  branchId          String
  tankId            String
  productId         String
  dipDate           DateTime          @db.Date
  dipTime           DateTime
  bookBalance       Decimal           @db.Decimal(18, 3)
  physicalDipLitres Decimal           @db.Decimal(18, 3)
  varianceLitres    Decimal           @db.Decimal(18, 3)
  varianceValue     Decimal?          @db.Decimal(18, 2)
  measuredById      String
  approvedById      String?
  approvedAt        DateTime?
  status            FuelTankDipStatus @default(DRAFT)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?

  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  tank       FuelTank @relation(fields: [tankId], references: [id], onDelete: Restrict)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  measuredBy User     @relation("TankDipMeasuredBy", fields: [measuredById], references: [id], onDelete: Restrict)
  approvedBy User?    @relation("TankDipApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([companyId, dipNumber])
  @@index([companyId])
  @@index([branchId])
  @@index([tankId])
  @@index([dipDate])
  @@index([status])
  @@map("fuel_tank_dips")
}

model FuelShiftCollection {
  id             String                  @id @default(uuid())
  fuelShiftId    String
  companyId      String
  branchId       String
  collectionType FuelShiftCollectionType @default(CASH)
  amount         Decimal                 @db.Decimal(18, 2)
  reference      String?
  collectedById  String?
  cashAccountId  String?
  notes          String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  fuelShift   FuelShift    @relation(fields: [fuelShiftId], references: [id], onDelete: Cascade)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashAccount CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)

  @@index([fuelShiftId])
  @@index([companyId])
  @@index([branchId])
  @@index([collectionType])
  @@map("fuel_shift_collections")
}

model FuelCreditSale {
  id               String               @id @default(uuid())
  creditSaleNumber String
  fuelShiftId      String?
  companyId        String
  branchId         String
  customerId       String
  productId        String
  vehicleNumber    String?
  driverName       String?
  litres           Decimal              @db.Decimal(18, 3)
  pricePerLitre    Decimal              @db.Decimal(18, 4)
  totalAmount      Decimal              @db.Decimal(18, 2)
  saleDate         DateTime
  status           FuelCreditSaleStatus @default(OPEN)
  receivableId     String?
  salesOrderId     String?
  notes            String?
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deletedAt        DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  fuelShift  FuelShift?  @relation(fields: [fuelShiftId], references: [id], onDelete: SetNull)
  receivable Receivable? @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("CreditSaleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, creditSaleNumber])
  @@index([companyId])
  @@index([branchId])
  @@index([customerId])
  @@index([saleDate])
  @@index([status])
  @@map("fuel_credit_sales")
}

model FuelDelivery {
  id                 String             @id @default(uuid())
  deliveryNumber     String
  companyId          String
  branchId           String
  supplierId         String
  productId          String
  tankId             String
  purchaseOrderId    String?
  deliveryDate       DateTime
  deliveryNoteNumber String?
  invoiceNumber      String?
  orderedLitres      Decimal?           @db.Decimal(18, 3)
  deliveredLitres    Decimal            @db.Decimal(18, 3)
  acceptedLitres     Decimal            @db.Decimal(18, 3)
  rejectedLitres     Decimal            @default(0) @db.Decimal(18, 3)
  unitCost           Decimal?           @db.Decimal(18, 4)
  totalCost          Decimal?           @db.Decimal(18, 2)
  driverName         String?
  truckNumber        String?
  status             FuelDeliveryStatus @default(DRAFT)
  receivedById       String
  approvedById       String?
  approvedAt         DateTime?
  postedById         String?
  postedAt           DateTime?
  payableId          String?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier      Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  tank          FuelTank       @relation(fields: [tankId], references: [id], onDelete: Restrict)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  receivedBy    User           @relation("DeliveryReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)
  approvedBy    User?          @relation("DeliveryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  postedBy      User?          @relation("DeliveryPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  payable       Payable?       @relation(fields: [payableId], references: [id], onDelete: SetNull)

  @@unique([companyId, deliveryNumber])
  @@index([companyId])
  @@index([branchId])
  @@index([supplierId])
  @@index([tankId])
  @@index([deliveryDate])
  @@index([status])
  @@map("fuel_deliveries")
}

model FuelDailyReconciliation {
  id                        String                        @id @default(uuid())
  reconciliationNumber      String
  companyId                 String
  branchId                  String
  reconciliationDate        DateTime                      @db.Date
  totalLitresSold           Decimal                       @default(0) @db.Decimal(18, 3)
  totalExpectedSales        Decimal                       @default(0) @db.Decimal(18, 2)
  totalCashCollected        Decimal                       @default(0) @db.Decimal(18, 2)
  totalMobileMoneyCollected Decimal                       @default(0) @db.Decimal(18, 2)
  totalBankCardCollected    Decimal                       @default(0) @db.Decimal(18, 2)
  totalCreditSales          Decimal                       @default(0) @db.Decimal(18, 2)
  totalCollections          Decimal                       @default(0) @db.Decimal(18, 2)
  cashShortage              Decimal                       @default(0) @db.Decimal(18, 2)
  cashExcess                Decimal                       @default(0) @db.Decimal(18, 2)
  totalTankVarianceLitres   Decimal                       @default(0) @db.Decimal(18, 3)
  totalTankVarianceValue    Decimal                       @default(0) @db.Decimal(18, 2)
  status                    FuelDailyReconciliationStatus @default(DRAFT)
  preparedById              String
  approvedById              String?
  approvedAt                DateTime?
  postedById                String?
  postedAt                  DateTime?
  notes                     String?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  deletedAt                 DateTime?

  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch     Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  preparedBy User    @relation("ReconciliationPreparedBy", fields: [preparedById], references: [id], onDelete: Restrict)
  approvedBy User?   @relation("ReconciliationApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  postedBy   User?   @relation("ReconciliationPostedBy", fields: [postedById], references: [id], onDelete: SetNull)

  @@unique([branchId, reconciliationDate])
  @@unique([companyId, reconciliationNumber])
  @@index([companyId])
  @@index([branchId])
  @@index([reconciliationDate])
  @@index([status])
  @@map("fuel_daily_reconciliations")
}

model PetroleumAttachment {
  id         String   @id @default(uuid())
  companyId  String
  entityType String
  entityId   String
  documentId String
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, documentId])
  @@index([companyId])
  @@index([entityType, entityId])
  @@map("petroleum_attachments")
}

// ═══════════════════════════════════════════════════════════════════════════════
