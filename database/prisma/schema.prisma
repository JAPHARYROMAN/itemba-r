// ─── StockDamage ──────────────────────────────────────────────────────────────
model StockDamage {
  id             String            @id @default(uuid())
  damageNumber   String
  companyId      String
  branchId       String?
  productId      String
  batchId        String?
  quantity       Decimal           @db.Decimal(18, 4)
  unitId         String
