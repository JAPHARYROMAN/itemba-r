// ─── CustomerPackageBalance ───────────────────────────────────────────────────
model CustomerPackageBalance {
  id                     String   @id @default(uuid())
  companyId              String
  customerId             String
  returnablePackageId    String?
  quantityOwedByCustomer Decimal  @default(0) @db.Decimal(18, 4)
