/// Statutory or company-declared public holiday. Used by the payroll engine to
/// classify a calendar day as a non-working day (overtime rate triggers, leave
/// computation skips holidays, etc.).
///
/// `region` distinguishes Mainland Tanzania from Zanzibar (Zanzibar Revolution
/// Day, Karume Day are Zanzibar-only). `isObserved` lets ops shift e.g. a
/// Sunday holiday to Monday without losing the canonical date.
///
/// `religiousDateApprox = true` flags Islamic holidays whose final date depends
/// on moon sighting; the seeded value should be treated as a planning date and
/// confirmed by the religious authority each year.
model PublicHoliday {
  id                  String        @id @default(uuid())
  companyId           String?
  region              HolidayRegion @default(MAINLAND)
  name                String
  date                DateTime      @db.Date
  observedDate        DateTime?     @db.Date
  isReligious         Boolean       @default(false)
  religiousDateApprox Boolean       @default(false)
  recurring           Boolean       @default(true)
  description         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  deletedAt           DateTime?

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([region, date, name])
  @@index([region, date])
  @@map("public_holidays")
}

/// Sectoral minimum wage as gazetted by the Wages Council. Tanzania publishes
/// distinct minima for sectors (mining, agriculture, services, domestic, etc.)
/// — payroll uses this as the floor for any new contract in that sector.
model MinimumWageRule {
  id             String            @id @default(uuid())
  sectorCode     String
  sectorName     String
  region         HolidayRegion     @default(MAINLAND)
  monthlyMinimum Decimal           @db.Decimal(18, 2)
  currency       CurrencyCode      @default(TZS)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  gazetteRef     String?
  notes          String?
  status         MinimumWageStatus @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([sectorCode, region, effectiveFrom])
  @@index([region, status])
  @@map("minimum_wage_rules")
}

enum HolidayRegion {
  MAINLAND
  ZANZIBAR
  BOTH
}

enum MinimumWageStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

