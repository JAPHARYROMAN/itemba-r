model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model TwoFactorBackupCode {
  id       String    @id @default(uuid())
  userId   String
  codeHash String
  usedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_backup_codes")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  displayName     String
  description     String?
  scope           RoleScope
  /// System roles are seeded and cannot be deleted via the API.
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  userRoles       UserRole[]
  rolePermissions RolePermission[]
  approvalSteps   ApprovalStep[]
  alertRules      AlertRule[]

  @@index([scope])
  @@map("roles")
}

model Permission {
  id             String   @id @default(uuid())
  /// Format: "module.action" e.g. "bank-accounts.read"
  code           String   @unique
  description    String
  module         String
  action         String
  /// Marks permissions that are restricted to GROUP-scoped roles (Group Control layer).
  isGroupControl Boolean  @default(false)
  createdAt      DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([module])
  @@index([isGroupControl])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Assigns a role to a user.
/// Scope (which company/division/branch the role applies to) is tracked
/// separately via UserCompanyAccess / UserDivisionAccess / UserBranchAccess.
model UserRole {
  id           String   @id @default(uuid())
  userId       String
  roleId       String
  assignedAt   DateTime @default(now())
  assignedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

/// Explicitly grants a user access to a specific company at a given access level.
/// Works together with UserRole: role = what you can do, access = where you can do it.
model UserCompanyAccess {
  id          String      @id @default(uuid())
  userId      String
  companyId   String
  accessLevel AccessLevel @default(READ)
  grantedAt   DateTime    @default(now())
  grantedById String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_company_access")
}

/// Explicitly grants a user access to a specific division.
model UserDivisionAccess {
  id          String      @id @default(uuid())
  userId      String
  divisionId  String
  accessLevel AccessLevel @default(READ)
  grantedAt   DateTime    @default(now())
  grantedById String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([userId, divisionId])
  @@index([divisionId])
  @@map("user_division_access")
}

/// Explicitly grants a user access to a specific branch.
model UserBranchAccess {
  id          String      @id @default(uuid())
  userId      String
  branchId    String
  accessLevel AccessLevel @default(READ)
  grantedAt   DateTime    @default(now())
  grantedById String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@map("user_branch_access")
}

