  status            PayableStatus @default(OPEN)
  notes             String?
  journalEntryId    String?
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division       Division?       @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  journalEntry   JournalEntry?   @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  purchaseOrders PurchaseOrder[]
  fuelDeliveries FuelDelivery[]

  @@unique([companyId, payableNumber])
  @@index([companyId])
  @@index([divisionId])
  @@index([branchId])
  @@index([status])
  @@index([dueDate])
  @@index([companyId, supplierId, dueDate, status])
  @@index([companyId, outstandingAmount, status])
  @@map("payables")
}

// ───────────────────────────────────────────────────────────────────────────────
// CREDIT NOTES & REFUNDS (UX Backend Wave 2)
// ───────────────────────────────────────────────────────────────────────────────

/// Lifecycle of a customer credit note.
///   DRAFT  -> editable, not yet posted to the GL.
///   ISSUED -> posted; a balanced reversing journal entry exists.
///   VOID   -> issued then reversed; the GL impact has been unwound.
enum CreditNoteStatus {
  DRAFT
  ISSUED
  VOID
}

/// Lifecycle of a customer cash/bank refund.
///   DRAFT -> PAID (pay/post)   PAID -> VOID (void/reverse)
enum RefundStatus {
  DRAFT
  PAID
  VOID
}

/// Lifecycle of a customer payment (cash receipt) header.
///   COMPLETED -> REVERSED (reversal posts a mirror journal entry and
///   unwinds every allocation against the affected receivables).
enum CustomerPaymentStatus {
  COMPLETED
  REVERSED
}

/// A customer-facing reversal of a prior sale (return, allowance, billing
/// correction). Issuing posts a balanced reversing journal entry that unwinds
/// revenue + output VAT + AR; voiding reverses that entry. Optionally applied
/// against a linked receivable to reduce its outstanding balance.
model CreditNote {
  id               String           @id @default(uuid())
  creditNoteNumber String
  companyId        String
  divisionId       String?
  branchId         String?
  customerId       String?
  customerName     String
  salesOrderId     String?
  receivableId     String?
  reason           String?
  subtotal         Decimal          @db.Decimal(18, 2)
  taxAmount        Decimal          @default(0) @db.Decimal(18, 2)
  totalAmount      Decimal          @db.Decimal(18, 2)
  appliedAmount    Decimal          @default(0) @db.Decimal(18, 2)
  currency         CurrencyCode     @default(TZS)
  issueDate        DateTime
  status           CreditNoteStatus @default(DRAFT)
  notes            String?
  journalEntryId   String?
  createdById      String?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division     Division?     @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  salesOrder   SalesOrder?   @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  receivable   Receivable?   @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("CreditNoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  lines   CreditNoteLine[]
  refunds Refund[]

  @@unique([companyId, creditNoteNumber])
  @@index([companyId])
  @@index([divisionId])
  @@index([branchId])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([receivableId])
  @@index([status])
  @@index([issueDate])
  @@index([companyId, status, issueDate])
  @@map("credit_notes")
}

model CreditNoteLine {
  id           String   @id @default(uuid())
  creditNoteId String
  companyId    String
  productId    String?
  unitId       String?
  description  String
  quantity     Decimal  @db.Decimal(18, 4)
  unitPrice    Decimal  @db.Decimal(18, 2)
  netAmount    Decimal  @db.Decimal(18, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal    Decimal  @db.Decimal(18, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  creditNote CreditNote     @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product    Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  unit       UnitOfMeasure? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@index([creditNoteId])
  @@index([creditNoteId, createdAt])
  @@index([companyId])
  @@index([productId])
  @@map("credit_note_lines")
}

/// A cash/bank refund paid to a customer, backed by either an ISSUED credit
/// note or a receivable-carried customer credit. Paying posts DR AR / CR
/// Cash|Bank; voiding reverses that entry.
model Refund {
  id                      String       @id @default(uuid())
  refundNumber            String
  companyId               String
  divisionId              String?
  branchId                String?
  customerId              String?
  customerName            String?
  creditNoteId            String?
  receivableId            String?
  cashAccountId           String
  amount                  Decimal      @db.Decimal(18, 2)
  currency                CurrencyCode @default(TZS)
  refundDate              DateTime
  status                  RefundStatus @default(DRAFT)
  reason                  String?
  notes                   String?
  journalEntryId          String?
  reversalJournalEntryId  String?
  createdById             String?
  postedById              String?
  postedAt                DateTime?
  voidedAt                DateTime?
  deletedAt               DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division     Division?     @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch       Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  creditNote   CreditNote?   @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)
  receivable   Receivable?   @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  cashAccount  CashAccount   @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation("RefundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, refundNumber])
  @@index([companyId])
  @@index([divisionId])
  @@index([branchId])
  @@index([customerId])
  @@index([creditNoteId])
  @@index([receivableId])
  @@index([cashAccountId])
  @@index([status])
  @@index([refundDate])
  @@index([companyId, status, refundDate])
  @@map("refunds")
}

/// Header for a customer cash receipt. A single payment can be allocated across
/// many open receivables (see PaymentAllocation). `appliedAmount` is the total
/// applied to receivables; `unappliedAmount` (= amount - appliedAmount) is the
/// advance / credit-on-account left sitting on the customer. Recording posts
/// DR Cash|Bank / CR Accounts Receivable for the full `amount`; reversing posts
/// the mirror entry and unwinds every allocation.
model CustomerPayment {
  id                     String                @id @default(uuid())
  paymentNumber          String
  companyId              String
  divisionId             String?
  branchId               String?
  customerId             String
  amount                 Decimal               @db.Decimal(18, 2)
  method                 PaymentMethodGeneral  @default(CASH)
  reference              String?
  paymentDate            DateTime
  appliedAmount          Decimal               @default(0) @db.Decimal(18, 2)
  unappliedAmount        Decimal               @default(0) @db.Decimal(18, 2)
  currency               CurrencyCode          @default(TZS)
  status                 CustomerPaymentStatus @default(COMPLETED)
  cashAccountId          String?
  journalEntryId         String?
  reversalJournalEntryId String?
  notes                  String?
  createdById            String?
  reversedById           String?
  reversedAt             DateTime?
  deletedAt              DateTime?
  createdAt              DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  company             Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division            Division?           @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch              Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer            Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  cashAccount         CashAccount?        @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  journalEntry        JournalEntry?       @relation("CustomerPaymentJournalEntry", fields: [journalEntryId], references: [id], onDelete: SetNull)
  reversalJournalEntry JournalEntry?      @relation("CustomerPaymentReversalJournalEntry", fields: [reversalJournalEntryId], references: [id], onDelete: SetNull)
  createdBy           User?               @relation("CustomerPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reversedBy          User?               @relation("CustomerPaymentReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  allocations PaymentAllocation[]

  @@unique([companyId, paymentNumber])
  @@index([companyId])
  @@index([divisionId])
  @@index([branchId])
  @@index([customerId])
  @@index([cashAccountId])
  @@index([status])
  @@index([paymentDate])
  @@index([companyId, customerId, paymentDate])
  @@index([companyId, status, paymentDate])
  @@map("customer_payments")
}

/// A single application of a CustomerPayment against one open Receivable.
/// `amount` is the portion of the payment applied to that receivable; the sum
/// of a payment's allocations equals its `appliedAmount`.
model PaymentAllocation {
  id                String   @id @default(uuid())
  customerPaymentId String
  receivableId      String
  companyId         String
  amount            Decimal  @db.Decimal(18, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  customerPayment CustomerPayment @relation(fields: [customerPaymentId], references: [id], onDelete: Cascade)
  receivable      Receivable      @relation(fields: [receivableId], references: [id], onDelete: Restrict)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([customerPaymentId])
  @@index([receivableId])
  @@index([companyId])
  @@index([companyId, receivableId])
  @@map("payment_allocations")
}

// ───────────────────────────────────────────────────────────────────────────────
// INTER-COMPANY TRANSACTIONS
// ───────────────────────────────────────────────────────────────────────────────

model InterCompanyTransaction {
  id                        String               @id @default(uuid())
  transactionNumber         String
  fromCompanyId             String
  toCompanyId               String
  transactionType           InterCompanyTxType
  amount                    Decimal              @db.Decimal(18, 2)
  currency                  CurrencyCode         @default(TZS)
  transactionDate           DateTime
  description               String
  status                    InterCompanyTxStatus @default(DRAFT)
  createdById               String
  approvedById              String?
  approvedAt                DateTime?
  rejectedReason            String?
  fromCompanyJournalEntryId String?
  toCompanyJournalEntryId   String?
  postedAt                  DateTime?
  deletedAt                 DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  fromCompany             Company       @relation("InterCompanyTxFrom", fields: [fromCompanyId], references: [id], onDelete: Restrict)
  toCompany               Company       @relation("InterCompanyTxTo", fields: [toCompanyId], references: [id], onDelete: Restrict)
  createdBy               User          @relation("InterCompanyTxCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy              User?         @relation("InterCompanyTxApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  fromCompanyJournalEntry JournalEntry? @relation("InterCompanyFromJE", fields: [fromCompanyJournalEntryId], references: [id], onDelete: SetNull)
  toCompanyJournalEntry   JournalEntry? @relation("InterCompanyToJE", fields: [toCompanyJournalEntryId], references: [id], onDelete: SetNull)

  @@unique([fromCompanyId, transactionNumber])
  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@index([status])
  @@map("intercompany_transactions")
}

// ───────────────────────────────────────────────────────────────────────────────
// FINANCIAL ATTACHMENTS — link finance entities to Documents Vault
// ───────────────────────────────────────────────────────────────────────────────

model FinancialAttachment {
  id         String   @id @default(uuid())
  companyId  String
  entityType String // e.g. 'Expense', 'JournalEntry', 'Receivable', 'Payable', 'InterCompanyTransaction'
  entityId   String
  documentId String
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([entityType, entityId, documentId])
  @@index([companyId])
  @@index([entityType, entityId])
  @@map("financial_attachments")
}

