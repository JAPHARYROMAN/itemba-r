// ─────────────────────────────────────────────────────────────────────────────
// M12 MODELS
// ─────────────────────────────────────────────────────────────────────────────

model KPIIndicator {
  id                 String             @id @default(uuid())
  kpiCode            String             @unique
  name               String
  description        String?
  kpiCategory        KPICategory        @default(CUSTOM)
  calculationType    KPICalculationType @default(SUM)
  sourceEntity       String?
  sourceField        String?
  formula            Json?
  unit               String?
  currency           String?
  isActive           Boolean            @default(true)
  isSensitive        Boolean            @default(false)
  requiredPermission String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  snapshots        KPISnapshot[]
  dashboardWidgets DashboardWidget[]

  @@index([kpiCategory, isActive])
  @@map("kpi_indicators")
}

model KPISnapshot {
  id                     String             @id @default(uuid())
  kpiIndicatorId         String
  companyId              String?
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  snapshotDate           DateTime
  periodType             SnapshotPeriodType @default(MONTHLY)
  periodStart            DateTime
  periodEnd              DateTime
  value                  Decimal
  comparisonValue        Decimal?
  changeAmount           Decimal?
  changePercent          Decimal?
  currency               String?
  metadata               Json?
  createdAt              DateTime           @default(now())

  kpiIndicator KPIIndicator @relation(fields: [kpiIndicatorId], references: [id], onDelete: Cascade)
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([kpiIndicatorId, companyId, periodType, periodStart])
  @@map("kpi_snapshots")
}

model ReportDefinition {
  id                 String         @id @default(uuid())
  reportCode         String         @unique
  name               String
  description        String?
  reportCategory     ReportCategory @default(CUSTOM)
  datasetKey         String
  defaultFilters     Json?
  defaultColumns     Json?
  supportedFilters   Json?
  isSystemReport     Boolean        @default(false)
  isSensitive        Boolean        @default(false)
  requiredPermission String?
  isActive           Boolean        @default(true)
  createdById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  createdBy        User?             @relation("ReportDefinitionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  savedViews       SavedReportView[]
  reportRuns       ReportRun[]
  scheduledReports ScheduledReport[]
  dashboardWidgets DashboardWidget[]

  @@index([reportCategory, isActive])
  @@map("report_definitions")
}

model SavedReportView {
  id                 String    @id @default(uuid())
  reportDefinitionId String
  userId             String
  companyId          String?
  name               String
  filters            Json?
  columns            Json?
  sortConfig         Json?
  chartConfig        Json?
  isDefault          Boolean   @default(false)
  isShared           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  reportDefinition ReportDefinition  @relation(fields: [reportDefinitionId], references: [id], onDelete: Cascade)
  user             User              @relation("SavedReportViewUser", fields: [userId], references: [id], onDelete: Cascade)
  scheduledReports ScheduledReport[]

  @@index([userId, reportDefinitionId])
  @@map("saved_report_views")
}

model ReportRun {
  id                 String          @id @default(uuid())
  reportRunNumber    String          @unique
  reportDefinitionId String
  savedReportViewId  String?
  companyId          String?
  requestedById      String
  filters            Json?
  status             ReportRunStatus @default(REQUESTED)
  rowCount           Int?
  executionTimeMs    Int?
  resultSummary      Json?
  errorMessage       String?
  createdAt          DateTime        @default(now())
  completedAt        DateTime?

  reportDefinition ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Restrict)
  requestedBy      User             @relation("ReportRunRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([reportDefinitionId, status])
  @@index([requestedById, companyId])
  @@map("report_runs")
}

model ScheduledReport {
  id                 String             @id @default(uuid())
  scheduleCode       String             @unique
  reportDefinitionId String
  savedReportViewId  String?
  companyId          String?
  name               String
  description        String?
  frequency          ScheduleFrequency  @default(MONTHLY)
  scheduleConfig     Json?
  recipients         Json
  exportFormat       ReportExportFormat @default(EXCEL)
  isActive           Boolean            @default(true)
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  createdById        String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  reportDefinition ReportDefinition @relation(fields: [reportDefinitionId], references: [id], onDelete: Restrict)
  savedReportView  SavedReportView? @relation(fields: [savedReportViewId], references: [id], onDelete: SetNull)
  createdBy        User             @relation("ScheduledReportCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([reportDefinitionId, isActive])
  @@map("scheduled_reports")
}

model DashboardDefinition {
  id                 String        @id @default(uuid())
  dashboardCode      String        @unique
  name               String
  description        String?
  dashboardType      DashboardType @default(CUSTOM)
  layout             Json
  isSystemDashboard  Boolean       @default(false)
  isSensitive        Boolean       @default(false)
  requiredPermission String?
  createdById        String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  deletedAt          DateTime?

  createdBy       User?                     @relation("DashboardCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  widgets         DashboardWidget[]
  userPreferences UserDashboardPreference[]

  @@index([dashboardType, isSystemDashboard])
  @@map("dashboard_definitions")
}

model DashboardWidget {
  id                    String               @id @default(uuid())
  dashboardDefinitionId String
  widgetCode            String
  title                 String
  widgetType            WidgetType           @default(KPI_CARD)
  dataSourceType        WidgetDataSourceType @default(KPI)
  dataSourceKey         String?
  kpiIndicatorId        String?
  reportDefinitionId    String?
  config                Json?
  position              Json?
  isSensitive           Boolean              @default(false)
  requiredPermission    String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?

  dashboard        DashboardDefinition @relation(fields: [dashboardDefinitionId], references: [id], onDelete: Cascade)
  kpiIndicator     KPIIndicator?       @relation(fields: [kpiIndicatorId], references: [id], onDelete: SetNull)
  reportDefinition ReportDefinition?   @relation(fields: [reportDefinitionId], references: [id], onDelete: SetNull)

  @@unique([dashboardDefinitionId, widgetCode])
  @@map("dashboard_widgets")
}

model UserDashboardPreference {
  id                    String   @id @default(uuid())
  userId                String
  dashboardDefinitionId String
  layoutOverride        Json?
  filters               Json?
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user      User                @relation("UserDashboardPref", fields: [userId], references: [id], onDelete: Cascade)
  dashboard DashboardDefinition @relation(fields: [dashboardDefinitionId], references: [id], onDelete: Cascade)

  @@unique([userId, dashboardDefinitionId])
  @@map("user_dashboard_preferences")
}

/// Per-user UX preferences (Sprint S3). One row per user; lazy-created on
/// first save so existing users keep working without a backfill.
model UserPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  theme             String   @default("system") // system | light | dark
  density           String   @default("comfortable") // compact | comfortable | spacious
  locale            String   @default("en")
  timezone          String   @default("Africa/Dar_es_Salaam")
  dateFormat        String   @default("DD/MM/YYYY") // DD/MM/YYYY | MM/DD/YYYY | YYYY-MM-DD
  numberFormat      String   @default("en-GB")
  defaultCompanyId  String?
  defaultDivisionId String?
  defaultBranchId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User      @relation("UserPrefs", fields: [userId], references: [id], onDelete: Cascade)
  defaultCompany  Company?  @relation("UserPrefDefaultCompany", fields: [defaultCompanyId], references: [id], onDelete: SetNull)
  defaultDivision Division? @relation("UserPrefDefaultDivision", fields: [defaultDivisionId], references: [id], onDelete: SetNull)
  defaultBranch   Branch?   @relation("UserPrefDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)

  @@map("user_preferences")
}

model AnalyticsSnapshotRun {
  id           String             @id @default(uuid())
  runNumber    String             @unique
  runType      AnalyticsRunType   @default(KPI_SNAPSHOT)
  companyId    String
  periodStart  DateTime?
  periodEnd    DateTime?
  status       AnalyticsRunStatus @default(REQUESTED)
  startedById  String?
  startedAt    DateTime?
  completedAt  DateTime?
  errorMessage String?
  metadata     Json?
  createdAt    DateTime           @default(now())

  company   Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  startedBy User?   @relation("SnapshotRunStartedBy", fields: [startedById], references: [id], onDelete: SetNull)

  @@index([companyId, runType, status, createdAt])
  @@index([runType, status, createdAt])
  @@map("analytics_snapshot_runs")
}

model ExecutiveInsight {
  id                     String             @id @default(uuid())
  insightNumber          String             @unique
  companyId              String?
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  insightDate            DateTime
  insightType            InsightType        @default(PERFORMANCE)
  title                  String
