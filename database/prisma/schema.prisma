  division Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  document Document  @relation("HRDocumentBacking", fields: [documentId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@index([companyId, documentCategory, createdAt])
  @@index([divisionId, documentCategory, createdAt])
  @@index([branchId, documentCategory, createdAt])
  @@index([employeeId, documentCategory, createdAt])
