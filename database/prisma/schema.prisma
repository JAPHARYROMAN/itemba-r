// ITEMBA-R — Production Schema v2
// Governance backbone: Group → Company → Division → Branch
// + Legal Entity Profiles + Granular Access Control
// + Group-Controlled Sensitive Records (BankAccount, Loan, Debt, Contract, FixedAsset)
// + Polymorphic Documents + Full AuditLog
// ═══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  output   = "../../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────────────────────────────────────────────────────────
// ENUMS
// ───────────────────────────────────────────────────────────────────────────────

/// Determines what governance layer a role operates at.
/// GROUP roles can access all companies and the Group Control layer.
enum RoleScope {
  GROUP
  COMPANY
  DIVISION
  BRANCH
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum CompanyStatus {
  ACTIVE
  DORMANT
  SUSPENDED
  DISSOLVED
}

enum DivisionType {
  PETROLEUM
  LOGISTICS
  AGRICULTURE
  CONSTRUCTION
  BEVERAGES
  HARDWARE_BUILDING
  TRUCK_PARKING
  RENTAL_SHOPS
  HOSPITALITY
  REAL_ESTATE
  OTHER
}

