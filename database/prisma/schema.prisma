// ───────────────────────────────────────────────────────────────────────────────
// GOVERNANCE HIERARCHY
// ───────────────────────────────────────────────────────────────────────────────

/// Root governance entity. One row in production ("Itemba Group").
model Group {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  address     String?
  phone       String?
  email       String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companies    Company[]
  bankAccounts BankAccount[]
  loans        Loan[]
  contracts    Contract[]
  fixedAssets  FixedAsset[]
  documents    Document[]    @relation("GroupDocuments")

  @@map("groups")
}

/// A BRELA-registered legal entity within the group.
/// Sensitive financial records (bank accounts, loans, etc.) are owned here
/// but may only be accessed via GROUP-scoped permissions.
model Company {
  id                 String        @id @default(uuid())
  groupId            String
  code               String        @unique
  name               String
  industryType       String?
  status             CompanyStatus @default(ACTIVE)
  phone              String?
  email              String?
  website            String?
  logoUrl            String?
  /// Short prefix used by auto-generated entity codes (employees, etc.).
  /// Falls back to the first 4 chars of `code` if null. Convention: 4 upper
  /// chars matching the seeded codes — MWAN / WEST / ITEM.
  employeeCodePrefix String?       @db.VarChar(8)
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  group         Group               @relation(fields: [groupId], references: [id], onDelete: Restrict)
  profile       CompanyProfile?
  divisions     Division[]
  users         User[]
  bankAccounts  BankAccount[]
  loans         Loan[]
  debts         Debt[]
  contracts     Contract[]
  fixedAssets   FixedAsset[]
  documents     Document[]          @relation("CompanyDocuments")
  auditLogs     AuditLog[]
  companyAccess UserCompanyAccess[]

  // Finance (Milestone 3)
  chartOfAccounts      ChartOfAccount[]
  fiscalYears          FiscalYear[]
  accountingPeriods    AccountingPeriod[]
  journalEntries       JournalEntry[]
  journalEntryLines    JournalEntryLine[]
  cashAccounts         CashAccount[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  receivables          Receivable[]
  payables             Payable[]
  creditNotes          CreditNote[]
  refunds              Refund[]
  customerPayments     CustomerPayment[]
  paymentAllocations   PaymentAllocation[]
  interCompanyTxFrom   InterCompanyTransaction[] @relation("InterCompanyTxFrom")
  interCompanyTxTo     InterCompanyTransaction[] @relation("InterCompanyTxTo")
  financialAttachments FinancialAttachment[]

  // Operations (Milestone 4)
  customers             Customer[]
  suppliers             Supplier[]
  productCategories     ProductCategory[]
  productFamilies       ProductFamily[]
  products              Product[]
  inventoryBalances     InventoryBalance[]
  inventoryMovements    InventoryMovement[]
  stockAdjustments      StockAdjustment[]
  salesOrders           SalesOrder[]
  purchaseOrders        PurchaseOrder[]
  operationsAttachments OperationsAttachment[]

  // Petroleum (Milestone 5)
  fuelTanks                FuelTank[]
  fuelPumps                FuelPump[]
  fuelNozzles              FuelNozzle[]
  fuelPrices               FuelPrice[]
  fuelShifts               FuelShift[]
  fuelNozzleReadings       FuelNozzleReading[]
  fuelTankDips             FuelTankDip[]
  fuelShiftCollections     FuelShiftCollection[]
  fuelCreditSales          FuelCreditSale[]
  fuelDeliveries           FuelDelivery[]
  fuelDailyReconciliations FuelDailyReconciliation[]
  petroleumAttachments     PetroleumAttachment[]

  // Westsides (Milestone 6)
  salesChannels           SalesChannel[]
  priceLists              PriceList[]
  customerPriceAgreements CustomerPriceAgreement[]
  productBatches          ProductBatch[]
  stockDamages            StockDamage[]
  returnablePackages      ReturnablePackage[]
  packageMovements        PackageMovement[]
  quotations              Quotation[]
  proformaInvoices        ProformaInvoice[]
  deliveryNotes           DeliveryNote[]
  westsidesAttachments    WestsidesAttachment[]
  customerPackageBalances CustomerPackageBalance[]

  // Itemba (Milestone 7)
  itembaWorkUnits        ItembaWorkUnit[]
  equipmentUsages        EquipmentUsage[]
  laborRecords           LaborRecord[]
  vehicles               Vehicle[]
  driverProfiles         DriverProfile[]
  routes                 Route[]
  trips                  Trip[]
  tripExpenses           TripExpense[]
  tripFuelUsages         TripFuelUsage[]
  vehicleMaintenances    VehicleMaintenance[]
  farms                  Farm[]
  farmFields             FarmField[]
  crops                  Crop[]
  cropSeasons            CropSeason[]
  farmInputApplications  FarmInputApplication[]
  harvestRecords         HarvestRecord[]
  agricultureActivities  AgricultureActivity[]
  constructionProjects   ConstructionProject[]
  constructionSites      ConstructionSite[]
  boqItems               BOQItem[]
  projectMaterialIssues  ProjectMaterialIssue[]
  subcontractorRecords   SubcontractorRecord[]
  projectProgressRecords ProjectProgressRecord[]
  projectBillings        ProjectBilling[]
  projectCostAllocations ProjectCostAllocation[]
  salesCommissions       SalesCommission[]

  // Milestone 8
  licensedBusinessUnits   LicensedBusinessUnit[]
  businessLicenses        BusinessLicense[]
  rentalProperties        RentalProperty[]
  rentalUnits             RentalUnit[]
  tenants                 Tenant[]
  leaseAgreements         LeaseAgreement[]
  rentInvoices            RentInvoice[]
  rentPayments            RentPayment[]
  propertyMaintenances    PropertyMaintenance[]
  parkingFacilities       ParkingFacility[]
  parkingZones            ParkingZone[]
  parkingRates            ParkingRate[]
  parkingSessions         ParkingSession[]
  parkingPayments         ParkingPayment[]
  hospitalityFacilities   HospitalityFacility[]
  rooms                   Room[]
  guests                  Guest[]
  roomBookings            RoomBooking[]
  housekeepingTasks       HousekeepingTask[]
  menuCategories          MenuCategory[]
  menuItems               MenuItem[]
  restaurantTables        RestaurantTable[]
  restaurantOrders        RestaurantOrder[]
  hospitalityPayments     HospitalityPayment[]
  guestFolios             GuestFolio[]
  businessUnitAttachments BusinessUnitAttachment[]

  // Milestone 9 — HR & Payroll
  departments               Department[]
  positions                 Position[]
  employees                 Employee[]
  employeeAssignments       EmployeeAssignment[]
  employmentContracts       EmploymentContract[]
  workShifts                WorkShift[]
  shiftSchedules            ShiftSchedule[]
  attendanceRecords         AttendanceRecord[]
  leaveTypes                LeaveType[]
  leaveRequests             LeaveRequest[]
  leaveBalances             LeaveBalance[]
  allowanceTypes            AllowanceType[]
  deductionTypes            DeductionType[]
  employeeAllowances        EmployeeAllowance[]
  employeeDeductions        EmployeeDeduction[]
  payrollPeriods            PayrollPeriod[]
  payrollRuns               PayrollRun[]
  payrollEntries            PayrollEntry[]
  salaryPayments            SalaryPayment[]
  salaryAdvances            SalaryAdvance[]
  performanceRecords        PerformanceRecord[]
  hrDocuments               HRDocument[]
  // Milestone 10 — Tax, Compliance, Regulatory
  taxRegistrations          CompanyTaxRegistration[]
  taxTransactions           TaxTransaction[]
  taxFilingPeriods          TaxFilingPeriod[]
  taxReturns                TaxReturn[]
  complianceObligations     ComplianceObligation[]
  complianceEvents          ComplianceEvent[]
  complianceDocRequirements ComplianceDocumentRequirement[]
  complianceDocStatuses     ComplianceDocumentStatus[]
  auditEvidencePacks        AuditEvidencePack[]
  dataExportLogs            DataExportLog[]
  approvalWorkflows         ApprovalWorkflow[]
  approvalRequests          ApprovalRequest[]
  approvalDelegations       ApprovalDelegation[]
  notifications             Notification[]
  alertRules                AlertRule[]
  alertEvents               AlertEvent[]
  tasks                     Task[]
  internalControlRules      InternalControlRule[]
  // Milestone 12 — BI & Reporting
  kpiSnapshots              KPISnapshot[]
  analyticsSnapshotRuns     AnalyticsSnapshotRun[]
  executiveInsights         ExecutiveInsight[]
  dataQualityIssues         DataQualityIssue[]

  // Milestone 13 — Integrations
  integrationConnections IntegrationConnection[]
  integrationEvents      IntegrationEvent[]
  webhookEndpoints       WebhookEndpoint[]
  webhookEvents          WebhookEvent[]
  apiClients             ApiClient[]
  apiRequestLogs         ApiRequestLog[]
  deviceRegistrations    DeviceRegistration[]
  mobileSessions         MobileSession[]
  offlineSyncBatches     OfflineSyncBatch[]
  syncCheckpoints        SyncCheckpoint[]
  externalPayments       ExternalPayment[]
  externalMessages       ExternalMessage[]
  messageTemplates       MessageTemplate[]
  integrationMappings    IntegrationMapping[]

  // Milestone 14 — Security & Production
  securityPolicies      SecurityPolicy[]
  securityEvents        SecurityEvent[]
  activeSessions        ActiveSession[]
  systemMetrics         SystemMetric[]
  errorLogs             ErrorLog[]
  retentionPolicies     RetentionPolicy[]
  archiveJobs           DataArchiveJob[]
  disasterRecoveryPlans DisasterRecoveryPlan[]

  // Milestone 14.5 — Advanced Accounting, Procurement, CRM/SRM, Document Templates, Automation
  accountingPostingRules      AccountingPostingRule[]
  postingRuns                 PostingRun[]
  periodCloses                AccountingPeriodClose[]
  accountingLocks             AccountingLock[]
  bankReconciliations         BankReconciliation[]
  depreciationSchedules       DepreciationSchedule[]
  depreciationEntries         DepreciationEntry[]
  loanRepaymentSchedules      LoanRepaymentSchedule[]
  loanRepaymentPayments       LoanRepaymentPayment[]
  financialStatementRuns      FinancialStatementRun[]
  auditAdjustments            AuditAdjustment[]
  purchaseRequisitions        PurchaseRequisition[]
  rfqs                        RequestForQuotation[]
  supplierQuotations          SupplierQuotation[]
  bidComparisons              BidComparison[]
  goodsReceivedNotes          GoodsReceivedNote[]
  supplierInvoices            SupplierInvoice[]
  threeWayMatches             ThreeWayMatch[]
  procurementPlans            ProcurementPlan[]
  contactPersons              ContactPerson[]
  communicationLogs           CommunicationLog[]
  customerCreditProfiles      CustomerCreditProfile[]
  supplierPerformanceProfiles SupplierPerformanceProfile[]
  customerSegments            CustomerSegment[]
  customerStatementRuns       CustomerStatementRun[]
  supplierStatementRuns       SupplierStatementRun[]
  documentTemplates           DocumentTemplate[]
  generatedDocuments          GeneratedDocument[]
  documentNumberSequences     DocumentNumberSequence[]
  automationRules             AutomationRule[]

  backgroundJobs         BackgroundJob[]
  cacheEntries           CacheEntry[]
  performanceTraces      PerformanceTrace[]
  publicHolidays         PublicHoliday[]
  oshaRegistrations      OshaRegistration[]
  medicalExamRecords     MedicalExamRecord[]
  employmentDisputes     EmploymentDispute[]
  disciplinaryActions    DisciplinaryAction[]
  userPreferenceDefaults UserPreference[]     @relation("UserPrefDefaultCompany")

  @@index([groupId])
  @@index([status])
  @@map("companies")
}

/// Legal profile for a Company — BRELA / TRA / regulatory data.
/// 1:1 with Company. Kept separate to avoid bloating the Company model.
model CompanyProfile {
  id                    String        @id @default(uuid())
  companyId             String        @unique
  registeredName        String
  tradingName           String?
  brelaRegNumber        String        @unique
  tin                   String        @unique
  vrn                   String?       @unique // VAT Registration Number (if registered)
  businessLicenseNumber String?
  incorporationDate     DateTime?
  registeredAddress     String
  postalAddress         String?
  taxOffice             String?
  natureOfBusiness      String?
  authorizedCapital     Decimal?      @db.Decimal(18, 2)
  currency              CurrencyCode  @default(TZS)
  status                CompanyStatus @default(ACTIVE)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

/// Business unit / product line within a Company.
model Division {
  id          String       @id @default(uuid())
  companyId   String
  name        String
  code        String
  type        DivisionType
  description String?
  isActive    Boolean      @default(true)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branches       Branch[]
  fixedAssets    FixedAsset[]
  cashAccounts   CashAccount[]
  bankAccounts   BankAccount[]
  loans          Loan[]
  divisionAccess UserDivisionAccess[]
  documents      Document[]           @relation("DivisionDocuments")

  // Operations (Milestone 4)
  customers          Customer[]
  suppliers          Supplier[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  stockAdjustments   StockAdjustment[]
  salesOrders        SalesOrder[]
  purchaseOrders     PurchaseOrder[]
  goodsReceivedNotes GoodsReceivedNote[]

  // Petroleum (Milestone 5)
  fuelTanks   FuelTank[]
  fuelPumps   FuelPump[]
  fuelNozzles FuelNozzle[]
  fuelShifts  FuelShift[]

  // Westsides (Milestone 6)
  quotations       Quotation[]
  proformaInvoices ProformaInvoice[]

  // Itemba (Milestone 7)
  itembaWorkUnits        ItembaWorkUnit[]
  equipmentUsages        EquipmentUsage[]
  laborRecords           LaborRecord[]
  vehicles               Vehicle[]
  driverProfiles         DriverProfile[]
  routes                 Route[]
  trips                  Trip[]
  tripExpenses           TripExpense[]
  tripFuelUsages         TripFuelUsage[]
  vehicleMaintenances    VehicleMaintenance[]
  farms                  Farm[]
  farmFields             FarmField[]
  crops                  Crop[]
  cropSeasons            CropSeason[]
  farmInputApplications  FarmInputApplication[]
  harvestRecords         HarvestRecord[]
  agricultureActivities  AgricultureActivity[]
  constructionProjects   ConstructionProject[]
  constructionSites      ConstructionSite[]
  boqItems               BOQItem[]
  projectMaterialIssues  ProjectMaterialIssue[]
  subcontractorRecords   SubcontractorRecord[]
  projectProgressRecords ProjectProgressRecord[]
  projectBillings        ProjectBilling[]

  // Milestone 8
  licensedBusinessUnits LicensedBusinessUnit[]
  businessLicenses      BusinessLicense[]
  rentalProperties      RentalProperty[]
  parkingFacilities     ParkingFacility[]
  hospitalityFacilities HospitalityFacility[]

  // Milestone 9 — HR & Payroll
  departments         Department[]
  employees           Employee[]
  employeeAssignments EmployeeAssignment[]
  workShifts          WorkShift[]
  shiftSchedules      ShiftSchedule[]
  attendanceRecords   AttendanceRecord[]
  leaveRequests       LeaveRequest[]
  performanceRecords  PerformanceRecord[]
  hrDocuments         HRDocument[]
  employmentDisputes  EmploymentDispute[]

  approvalWorkflows      ApprovalWorkflow[]
  productFamilies        ProductFamily[]    @relation("DivisionProductFamilies")
  products               Product[]          @relation("DivisionProducts")
  userPreferenceDefaults UserPreference[]   @relation("UserPrefDefaultDivision")
  chartOfAccounts        ChartOfAccount[]
  receivables            Receivable[]
  payables               Payable[]
  supplierInvoices       SupplierInvoice[]

  // UX Backend Wave 2
  creditNotes CreditNote[]
  refunds     Refund[]
  customerPayments CustomerPayment[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([type])
  @@map("divisions")
}

/// Operational unit within a Division.
/// Can be a physical branch, project site, farm, warehouse, fuel station, etc.
model Branch {
  id         String     @id @default(uuid())
  divisionId String
  name       String
  code       String
  type       BranchType
  location   String?
  address    String?
  phone      String?
  isActive   Boolean    @default(true)
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  division     Division           @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  fixedAssets  FixedAsset[]
  cashAccounts CashAccount[]
  bankAccounts BankAccount[]
  loans        Loan[]
  branchAccess UserBranchAccess[]
  documents    Document[]         @relation("BranchDocuments")

  // Operations (Milestone 4)
  customers          Customer[]
  suppliers          Supplier[]
  inventoryBalances  InventoryBalance[]
  inventoryMovements InventoryMovement[]
  stockAdjustments   StockAdjustment[]
  salesOrders        SalesOrder[]
  purchaseOrders     PurchaseOrder[]
  businessLicenses   BusinessLicense[]
  goodsReceivedNotes GoodsReceivedNote[]

  // Petroleum (Milestone 5)
  fuelTanks                FuelTank[]
  fuelPumps                FuelPump[]
  fuelNozzles              FuelNozzle[]
  fuelPrices               FuelPrice[]
  fuelShifts               FuelShift[]
  fuelNozzleReadings       FuelNozzleReading[]
  fuelTankDips             FuelTankDip[]
  fuelShiftCollections     FuelShiftCollection[]
  fuelCreditSales          FuelCreditSale[]
  fuelDeliveries           FuelDelivery[]
  fuelDailyReconciliations FuelDailyReconciliation[]

  // Westsides (Milestone 6)
  salesChannels    SalesChannel[]
  productBatches   ProductBatch[]
  stockDamages     StockDamage[]
  deliveryNotes    DeliveryNote[]
  quotations       Quotation[]
  proformaInvoices ProformaInvoice[]

  // Itemba (Milestone 7)
  itembaWorkUnits       ItembaWorkUnit[]
  equipmentUsages       EquipmentUsage[]
  laborRecords          LaborRecord[]
  trips                 Trip[]
  harvestRecords        HarvestRecord[]
  constructionProjects  ConstructionProject[]
  projectMaterialIssues ProjectMaterialIssue[]

  // Milestone 8
  licensedBusinessUnits LicensedBusinessUnit[]
  rentalProperties      RentalProperty[]
  parkingFacilities     ParkingFacility[]
  hospitalityFacilities HospitalityFacility[]

  // Milestone 9 — HR & Payroll
  departments         Department[]
  employees           Employee[]
  employeeAssignments EmployeeAssignment[]
  workShifts          WorkShift[]
  shiftSchedules      ShiftSchedule[]
  attendanceRecords   AttendanceRecord[]
  leaveRequests       LeaveRequest[]
  performanceRecords  PerformanceRecord[]
  hrDocuments         HRDocument[]
  employmentDisputes  EmploymentDispute[]
  oshaRegistrations   OshaRegistration[]

  approvalWorkflows      ApprovalWorkflow[]
  userPreferenceDefaults UserPreference[]   @relation("UserPrefDefaultBranch")
  chartOfAccounts        ChartOfAccount[]
  receivables            Receivable[]
  payables               Payable[]
  supplierInvoices       SupplierInvoice[]

  // UX Backend Wave 2
  creditNotes CreditNote[]
  refunds     Refund[]
  customerPayments CustomerPayment[]

  @@unique([divisionId, code])
  @@index([divisionId])
  @@map("branches")
}

// ───────────────────────────────────────────────────────────────────────────────
// IDENTITY & ACCESS CONTROL
// ───────────────────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String
  fullName            String
  phoneNumber         String?
  title               String?
  status              UserStatus @default(ACTIVE)
  mustChangePassword  Boolean    @default(false)
  lastLoginAt         DateTime?
  passwordChangedAt   DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  /// Primary / home company for users who belong to one company.
  companyId           String?
  avatarUrl           String?
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  company        Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  userRoles      UserRole[]
  companyAccess  UserCompanyAccess[]
  divisionAccess UserDivisionAccess[]
  branchAccess   UserBranchAccess[]
  auditLogs      AuditLog[]
  uploads        Document[]           @relation("DocumentUploader")
  refreshTokens  RefreshToken[]
  preferences    UserPreference?      @relation("UserPrefs")

  // Finance (Milestone 3)
  journalEntriesCreated  JournalEntry[]            @relation("JournalEntryCreatedBy")
  journalEntriesPosted   JournalEntry[]            @relation("JournalEntryPostedBy")
  journalEntriesReversed JournalEntry[]            @relation("JournalEntryReversedBy")
  expensesCreated        Expense[]                 @relation("ExpenseCreatedBy")
  expensesApproved       Expense[]                 @relation("ExpenseApprovedBy")
  expensesPaid           Expense[]                 @relation("ExpensePaidBy")
  intercompanyTxCreated  InterCompanyTransaction[] @relation("InterCompanyTxCreatedBy")
  intercompanyTxApproved InterCompanyTransaction[] @relation("InterCompanyTxApprovedBy")

  // Operations (Milestone 4)
  customersCreated         Customer[]          @relation("CustomerCreatedBy")
  customersUpdated         Customer[]          @relation("CustomerUpdatedBy")
  suppliersCreated         Supplier[]          @relation("SupplierCreatedBy")
  suppliersUpdated         Supplier[]          @relation("SupplierUpdatedBy")
  movementsCreated         InventoryMovement[] @relation("MovementCreatedBy")
  adjustmentsCreated       StockAdjustment[]   @relation("AdjustmentCreatedBy")
