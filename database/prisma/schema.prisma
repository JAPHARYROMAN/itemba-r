model SalaryAdvance {
  id                    String                 @id @default(uuid())
  advanceNumber         String
  companyId             String
  employeeId            String
  requestDate           DateTime
  amount                Decimal                @db.Decimal(18, 2)
  /// Cumulative amount recovered from payroll deductions to date. When
  /// `recoveredAmount >= amount`, the advance status flips to SETTLED.
  recoveredAmount       Decimal                @default(0) @db.Decimal(18, 2)
  currency              String                 @default("TZS")
  repaymentMethod       AdvanceRepaymentMethod @default(ONE_TIME_DEDUCTION)
  installmentAmount     Decimal?               @db.Decimal(18, 2)
  reason                String?
  status                SalaryAdvanceStatus    @default(REQUESTED)
  approvedById          String?
  approvedAt            DateTime?
  paidById              String?
  paidAt                DateTime?
  cashAccountId         String?
  /// FK to the GL journal entry posted when the advance was paid. Set by
  /// SalaryAdvancePostingsService.
  paymentJournalEntryId String?
  notes                 String?
  createdById           String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  company            Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee           Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy          User                    @relation("SalaryAdvanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy         User?                   @relation("SalaryAdvanceApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy             User?                   @relation("SalaryAdvancePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  recoveryDeductions PayrollEntryDeduction[] @relation("AdvanceRecoveryDeductions")

  @@unique([companyId, advanceNumber])
  @@map("salary_advances")
}

model PerformanceRecord {
  id                String                  @id @default(uuid())
  performanceNumber String
  companyId         String
  divisionId        String?
  branchId          String?
  employeeId        String
  reviewDate        DateTime
  reviewPeriodStart DateTime?
  reviewPeriodEnd   DateTime?
  reviewerId        String
  score             Decimal?                @db.Decimal(5, 2)
  rating            PerformanceRating       @default(NOT_RATED)
  strengths         String?
  weaknesses        String?
  recommendations   String?
  status            PerformanceRecordStatus @default(DRAFT)
  /// Optional bonus awarded with this review. When the record transitions to
  /// APPROVED, the performance service auto-creates an EmployeeAllowance
  /// (PERFORMANCE_BONUS type, one-shot, taxable) so the next payroll picks
  /// it up. Null = no bonus, review is informational only.
  bonusAmount       Decimal?                @db.Decimal(18, 2)
  /// FK back to the EmployeeAllowance created when the bonus is granted —
  /// idempotency guard + audit trail.
  bonusAllowanceId  String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer User      @relation("PerformanceReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@unique([companyId, performanceNumber])
  @@index([employeeId, reviewDate])
  @@index([companyId, reviewDate])
  @@index([divisionId, reviewDate])
  @@index([branchId, reviewDate])
  @@index([reviewerId])
  @@map("performance_records")
}

model HRDocument {
