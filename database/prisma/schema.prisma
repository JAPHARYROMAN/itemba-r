// ═══════════════════════════════════════════════════════════════════════════
// MILESTONE 11 MODELS — Approvals, Notifications, Alerts, Tasks, Controls
// ═══════════════════════════════════════════════════════════════════════════

model ApprovalWorkflow {
  id                     String                @id @default(uuid())
  workflowCode           String
  companyId              String?
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  name                   String
  description            String?
  entityType             String
  workflowScope          WorkflowScope         @default(GLOBAL)
  triggerAction          WorkflowTriggerAction @default(SUBMIT)
  minAmount              Decimal?
  maxAmount              Decimal?
  currency               String?
  riskLevel              String?
  isActive               Boolean               @default(true)
  priority               Int                   @default(0)
  createdById            String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?

  company              Company?              @relation(fields: [companyId], references: [id], onDelete: SetNull)
  division             Division?             @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  licensedBusinessUnit LicensedBusinessUnit? @relation(fields: [licensedBusinessUnitId], references: [id], onDelete: SetNull)
  createdBy            User                  @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  steps                ApprovalStep[]
  approvalRequests     ApprovalRequest[]

  @@unique([workflowCode, companyId])
  @@index([entityType, triggerAction, isActive])
  @@map("approval_workflows")
}

model ApprovalStep {
  id                   String       @id @default(uuid())
  workflowId           String
  stepOrder            Int
  stepName             String
  approverType         ApproverType @default(ROLE)
  approverUserId       String?
  approverRoleId       String?
  approverPermission   String?
  minRequiredApprovals Int          @default(1)
  allowSelfApproval    Boolean      @default(false)
  escalationHours      Int?
  escalationUserId     String?
  escalationRoleId     String?
  isFinalStep          Boolean      @default(false)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?

  workflow        ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  approverUser    User?            @relation("StepApproverUser", fields: [approverUserId], references: [id], onDelete: SetNull)
  approverRole    Role?            @relation(fields: [approverRoleId], references: [id], onDelete: SetNull)
  escalationUser  User?            @relation("StepEscalationUser", fields: [escalationUserId], references: [id], onDelete: SetNull)
  approvalActions ApprovalAction[]

  @@index([workflowId, stepOrder])
  @@map("approval_steps")
}

model ApprovalRequest {
  id                     String                    @id @default(uuid())
  approvalRequestNumber  String
  workflowId             String?
  companyId              String?
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  entityType             String
  entityId               String
  actionType             ApprovalRequestActionType @default(SUBMIT)
  amount                 Decimal?
  currency               String?
  riskLevel              String?
  requestedById          String
  currentStepOrder       Int                       @default(1)
  status                 ApprovalRequestStatus     @default(PENDING)
  requestTitle           String
  requestSummary         String?
  oldValue               Json?
  newValue               Json?
  submittedAt            DateTime?
  approvedAt             DateTime?
  rejectedAt             DateTime?
  cancelledAt            DateTime?
  dueAt                  DateTime?
  notes                  String?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  deletedAt              DateTime?

  workflow    ApprovalWorkflow?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  company     Company?             @relation(fields: [companyId], references: [id], onDelete: SetNull)
  requestedBy User                 @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  actions     ApprovalAction[]
  attachments ApprovalAttachment[]

  @@unique([companyId, approvalRequestNumber])
  @@index([entityType, entityId])
  @@index([status, companyId])
  @@index([requestedById])
  @@index([companyId, entityType, entityId, status])
  @@index([requestedById, status, createdAt])
  @@map("approval_requests")
}

model ApprovalAction {
  id                String             @id @default(uuid())
  approvalRequestId String
  stepId            String?
  stepOrder         Int
  actionById        String
  action            ApprovalActionEnum @default(SUBMITTED)
  comment           String?
  reason            String?
  actionAt          DateTime           @default(now())
  oldStatus         String?
  newStatus         String?
  metadata          Json?
  createdAt         DateTime           @default(now())

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  step            ApprovalStep?   @relation(fields: [stepId], references: [id], onDelete: SetNull)
  actionBy        User            @relation("ApprovalActionBy", fields: [actionById], references: [id], onDelete: Restrict)

  @@index([approvalRequestId])
  @@map("approval_actions")
}

model ApprovalDelegation {
  id              String           @id @default(uuid())
  delegatorUserId String
  delegateUserId  String
  companyId       String?
  entityType      String?
  startDate       DateTime
  endDate         DateTime
  reason          String?
  status          DelegationStatus @default(ACTIVE)
  createdById     String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  delegator User     @relation("Delegator", fields: [delegatorUserId], references: [id], onDelete: Restrict)
  delegate  User     @relation("Delegate", fields: [delegateUserId], references: [id], onDelete: Restrict)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User     @relation("DelegationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([delegatorUserId, status])
  @@index([delegateUserId, status])
  @@map("approval_delegations")
}

model ApprovalAttachment {
  id                String   @id @default(uuid())
  approvalRequestId String
  documentId        String
  uploadedById      String
  createdAt         DateTime @default(now())

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  uploadedBy      User            @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@map("approval_attachments")
}

model Notification {
  id                 String               @id @default(uuid())
  notificationNumber String               @unique
  companyId          String?
  recipientUserId    String
  title              String
  message            String
  notificationType   NotificationType     @default(OTHER)
  priority           NotificationPriority @default(NORMAL)
  status             NotificationStatus   @default(UNREAD)
  linkedEntityType   String?
  linkedEntityId     String?
  actionUrl          String?
  createdAt          DateTime             @default(now())
  readAt             DateTime?
  dismissedAt        DateTime?
  expiresAt          DateTime?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  recipient User     @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, status])
  @@index([companyId])
  @@index([recipientUserId, status, createdAt])
  @@index([notificationType, status])
  @@map("notifications")
}

model AlertRule {
  id                     String               @id @default(uuid())
  alertRuleCode          String               @unique
  companyId              String?
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  name                   String
  description            String?
  alertType              AlertType            @default(CUSTOM)
  entityType             String?
  condition              Json
  daysBefore             Int?
  thresholdAmount        Decimal?
  thresholdQuantity      Decimal?
  priority               NotificationPriority @default(NORMAL)
  recipientType          AlertRecipientType   @default(ROLE)
  recipientUserId        String?
  recipientRoleId        String?
  recipientPermission    String?
  frequency              AlertFrequency       @default(DAILY)
  isActive               Boolean              @default(true)
  createdById            String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?

  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  recipientUser User?        @relation("AlertRuleRecipientUser", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientRole Role?        @relation(fields: [recipientRoleId], references: [id], onDelete: SetNull)
  createdBy     User         @relation("AlertRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  alertEvents   AlertEvent[]

  @@map("alert_rules")
}

model AlertEvent {
  id               String               @id @default(uuid())
  alertEventNumber String
  alertRuleId      String?
  companyId        String?
  alertType        AlertType            @default(CUSTOM)
  title            String
  message          String
  linkedEntityType String?
  linkedEntityId   String?
  priority         NotificationPriority @default(NORMAL)
  status           AlertEventStatus     @default(OPEN)
  triggeredAt      DateTime             @default(now())
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  dismissedById    String?
  dismissedAt      DateTime?
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  alertRule      AlertRule? @relation(fields: [alertRuleId], references: [id], onDelete: SetNull)
  company        Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  acknowledgedBy User?      @relation("AlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedBy     User?      @relation("AlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  dismissedBy    User?      @relation("AlertDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)

  @@unique([companyId, alertEventNumber])
  @@index([status, alertType])
  @@map("alert_events")
}

model Task {
  id                     String       @id @default(uuid())
  taskNumber             String
  companyId              String?
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  title                  String
  description            String?
  assignedToId           String?
  assignedById           String?
  taskType               TaskType     @default(CUSTOM)
  priority               TaskPriority @default(NORMAL)
  status                 TaskStatus   @default(TODO)
  dueDate                DateTime?
  linkedEntityType       String?
  linkedEntityId         String?
  completedById          String?
  completedAt            DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  assignedTo  User?    @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy  User?    @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  completedBy User?    @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([companyId, taskNumber])
  @@index([assignedToId, status])
  @@index([companyId, status])
  @@map("tasks")
}

model InternalControlRule {
  id                     String           @id @default(uuid())
  controlCode            String           @unique
  companyId              String?
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  name                   String
  description            String?
  controlType            ControlType      @default(CUSTOM)
  entityType             String?
  condition              Json?
  enforcementLevel       EnforcementLevel @default(WARNING)
  isActive               Boolean          @default(true)
  createdById            String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?

  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdBy User     @relation("ControlRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([entityType, isActive])
  @@map("internal_control_rules")
}

