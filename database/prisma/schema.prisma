/// Payment method used to settle a SalesOrder. Replaces the retired
/// POSPaymentMethod enum — same shape, broader scope.
enum SalesPaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_CARD
  BANK_TRANSFER
  CREDIT
  MIXED
  OTHER
}

enum ProfitCostSource {
  BRANCH_AVERAGE_COST
  DEFAULT_PURCHASE_PRICE
}

/// Commission earned by an employee on a sales order. Created either manually
/// by a sales manager or programmatically (Sprint D) when a SalesOrder hits
/// a paid/closed state.
///
/// Lifecycle:
///   DRAFT      → freshly computed, awaiting review
///   APPROVED   → cleared by sales manager; payroll calculator picks up
///                APPROVED rows whose `paidPayrollEntryId` is null and adds
///                them as a non-statutory allowance ("Sales Commission") on
///                the next pay period.
///   PAID       → settled via a payroll entry; `paidPayrollEntryId` set.
///   CANCELLED  → rejected (e.g. order returned, voided).
///
/// `basis`/`rate`/`amount` snapshot the policy at the time the commission was
/// computed so a later policy change doesn't retroactively re-rate APPROVED
/// rows. `notes` carries free-text justification (manager override, tier,
/// etc.).
model SalesCommission {
  id                 String                @id @default(uuid())
  companyId          String
  employeeId         String
  salesOrderId       String
  basis              SalesCommissionBasis  @default(GROSS)
  /// Decimal rate, e.g. 0.05 for 5%. Stored alongside the resulting amount so
  /// audits can re-derive without recomputing from order totals.
  rate               Decimal               @db.Decimal(8, 4)
  /// Computed amount = basis × rate (rounded to 2dp). Held as the source of
  /// truth for payroll integration — overrides recompute to keep history.
  amount             Decimal               @db.Decimal(18, 2)
  currency           String                @default("TZS")
  status             SalesCommissionStatus @default(DRAFT)
  notes              String?
  approvedById       String?
  approvedAt         DateTime?
  /// FK to the PayrollEntry that paid this commission. Set when payroll picks
  /// it up as an allowance and the run reaches PAID.
  paidPayrollEntryId String?
  createdById        String
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  deletedAt          DateTime?

  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee         Employee                @relation("EmployeeSalesCommissions", fields: [employeeId], references: [id], onDelete: Restrict)
  salesOrder       SalesOrder              @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  approvedBy       User?                   @relation("SalesCommissionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy        User                    @relation("SalesCommissionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  paidPayrollEntry PayrollEntry?           @relation("PayrollEntrySalesCommissions", fields: [paidPayrollEntryId], references: [id], onDelete: SetNull)
  payoutAllowances PayrollEntryAllowance[] @relation("SalesCommissionPayout")

  @@unique([salesOrderId, employeeId])
  @@index([companyId, status])
  @@index([employeeId, status])
  @@index([paidPayrollEntryId])
  @@map("sales_commissions")
}

enum SalesCommissionBasis {
  /// % of subtotal (pre-tax)
  GROSS
  /// % of net (subtotal − discount)
  NET
  /// Flat amount, ignores rate (rate stored as 0)
  FLAT
}

enum SalesCommissionStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

