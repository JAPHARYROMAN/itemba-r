  returnablePackage ReturnablePackage? @relation(fields: [returnablePackageId], references: [id], onDelete: Restrict)
  unit              UnitOfMeasure?     @relation("CustomerPackageBalance_unit_fk", fields: [returnablePackageId], references: [id], onDelete: SetNull, map: "CustomerPackageBalance_unit_fk")

