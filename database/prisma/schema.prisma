// ───────────────────────────────────────────────────────────────────────────────
// RECEIVABLES & PAYABLES
// ───────────────────────────────────────────────────────────────────────────────

model Receivable {
  id                String           @id @default(uuid())
  receivableNumber  String
  companyId         String
  divisionId        String?
  branchId          String?
  customerId        String?
  customerName      String
  sourceType        String?
  sourceId          String?
  amount            Decimal          @db.Decimal(18, 2)
  paidAmount        Decimal          @default(0) @db.Decimal(18, 2)
  outstandingAmount Decimal          @db.Decimal(18, 2)
  currency          CurrencyCode     @default(TZS)
  issueDate         DateTime
  dueDate           DateTime?
  status            ReceivableStatus @default(OPEN)
  notes             String?
  journalEntryId    String?
  /// Timestamp of the most recent overdue reminder emailed to the customer.
  /// Used by the job-worker to throttle reminders to one per receivable per
  /// reminder window (idempotent overdue reminders).
  lastReminderAt    DateTime?
  deletedAt         DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division        Division?        @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  salesOrders     SalesOrder[]
  fuelCreditSales FuelCreditSale[]
  projectBillings ProjectBilling[] @relation("ProjectBillingReceivable")
  trips           Trip[]           @relation("TripReceivable")
  creditNotes     CreditNote[]
  refunds         Refund[]
  paymentAllocations PaymentAllocation[]

  @@unique([companyId, receivableNumber])
  @@index([companyId])
  @@index([divisionId])
  @@index([branchId])
  @@index([status])
  @@index([dueDate])
  @@index([companyId, customerId, dueDate, status])
  @@index([companyId, outstandingAmount, status])
  @@map("receivables")
}

model Payable {
  id                String        @id @default(uuid())
  payableNumber     String
  companyId         String
  divisionId        String?
  branchId          String?
  supplierId        String?
  supplierName      String
  sourceType        String?
  sourceId          String?
  amount            Decimal       @db.Decimal(18, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(18, 2)
  outstandingAmount Decimal       @db.Decimal(18, 2)
  currency          CurrencyCode  @default(TZS)
