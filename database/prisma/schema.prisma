  reference           String?
  status              SalaryPaymentStatus @default(DRAFT)
  paidById            String?
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
