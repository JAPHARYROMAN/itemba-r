/// A running tab for a guest's stay. One folio per RoomBooking — opened on
/// check-in, closed on check-out. Aggregates room nights, restaurant/bar
/// charges, and any manually-posted incidentals into a single bill.
///
/// Lifecycle:
///   OPEN     → guest is in-house, charges accruing
///   CLOSED   → checked-out, settled (paid or routed to a SalesOrder receivable)
///   CANCELLED → booking cancelled before any charges
///
/// `settlementSalesOrderId` is set on close when a paying SalesOrder is
/// created (W5.5 will wire that in); for the MVP it remains null and the
/// folio stands as the audit record.
model GuestFolio {
  id                     String           @id @default(uuid())
  folioNumber            String
  companyId              String
  bookingId              String           @unique
  guestId                String
  status                 GuestFolioStatus @default(OPEN)
  subtotal               Decimal          @default(0) @db.Decimal(18, 2)
  taxAmount              Decimal          @default(0) @db.Decimal(18, 2)
  discountAmount         Decimal          @default(0) @db.Decimal(18, 2)
  totalAmount            Decimal          @default(0) @db.Decimal(18, 2)
  currency               String           @default("TZS")
  openedAt               DateTime         @default(now())
  closedAt               DateTime?
  closedById             String?
  /// FK to the SalesOrder created on check-out settlement (null until W5.5).
  settlementSalesOrderId String?
  notes                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deletedAt              DateTime?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  booking  RoomBooking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  guest    Guest         @relation(fields: [guestId], references: [id], onDelete: Restrict)
  closedBy User?         @relation("FolioClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  charges  FolioCharge[]

  @@unique([companyId, folioNumber])
  @@index([companyId, status])
  @@index([guestId])
  @@map("guest_folios")
}

enum GuestFolioStatus {
  OPEN
  CLOSED
  CANCELLED
}

/// One line on a guest folio's running tab. Polymorphic source — the same
/// charge can come from a room-night (auto-posted on checkout), a restaurant
/// order, a bar order, or a manual entry by the front-desk operator.
model FolioCharge {
  id          String          @id @default(uuid())
  folioId     String
  chargeType  FolioChargeType
  /// Optional opaque pointer to the source record (e.g. RestaurantOrder.id,
  /// RoomBooking.id for the room-night charge). Kept as a free string FK so
  /// new sources can be added without schema changes.
  sourceType  String?
  sourceId    String?
  description String
  quantity    Decimal         @default(1) @db.Decimal(18, 4)
  unitPrice   Decimal         @db.Decimal(18, 4)
  amount      Decimal         @db.Decimal(18, 2)
  taxAmount   Decimal         @default(0) @db.Decimal(18, 2)
  postedAt    DateTime        @default(now())
  postedById  String?
  notes       String?
  createdAt   DateTime        @default(now())

  folio    GuestFolio @relation(fields: [folioId], references: [id], onDelete: Cascade)
  postedBy User?      @relation("FolioChargePostedBy", fields: [postedById], references: [id], onDelete: SetNull)

  @@index([folioId])
  @@map("folio_charges")
}

enum FolioChargeType {
  ROOM
  RESTAURANT
  BAR
  LAUNDRY
  TELEPHONE
  MINIBAR
  OTHER
}

