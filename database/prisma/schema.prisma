// ── Models ───────────────────────────────────────────────────────────────────

model Customer {
  id             String         @id @default(uuid())
  customerCode   String
  companyId      String
  divisionId     String?
  branchId       String?
  customerType   CustomerType   @default(INDIVIDUAL)
  name           String
  legalName      String?
  tin            String?
  vrn            String?
  phone          String?
  email          String?
  address        String?
  contactPerson  String?
  creditLimit    Decimal        @default(0) @db.Decimal(18, 2)
  currentBalance Decimal        @default(0) @db.Decimal(18, 2)
  paymentTerms   String?
  status         CustomerStatus @default(ACTIVE)
  notes          String?
  // Audit fields — nullable so existing data does not need backfilling.
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division        Division?        @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  salesOrders     SalesOrder[]
  fuelCreditSales FuelCreditSale[]
  receivables     Receivable[]
  creditNotes     CreditNote[]
  refunds         Refund[]
  customerPayments CustomerPayment[]

  // Westsides (Milestone 6)
  priceAgreements  CustomerPriceAgreement[]
  packageBalances  CustomerPackageBalance[]
  packageMovements PackageMovement[]
  quotations       Quotation[]
  proformaInvoices ProformaInvoice[]
  deliveryNotes    DeliveryNote[]

  // Itemba (Milestone 7)
  trips                Trip[]
  constructionProjects ConstructionProject[] @relation("ProjectCustomer")
  projectBillings      ProjectBilling[]      @relation("BillingCustomer")

  // Milestone 8
  tenants          Tenant[]
  guests           Guest[]
  parkingSessions  ParkingSession[]
  restaurantOrders RestaurantOrder[] @relation("RestaurantOrderCustomer")

  @@unique([companyId, customerCode])
  @@index([companyId])
  @@index([status])
  @@index([companyId, status, name])
  @@index([companyId, createdAt])
  @@map("customers")
}

model Supplier {
  id             String         @id @default(uuid())
  supplierCode   String
  companyId      String
  divisionId     String?
  branchId       String?
  supplierType   SupplierType   @default(GENERAL_SUPPLIER)
  name           String
  legalName      String?
  tin            String?
  vrn            String?
  phone          String?
  email          String?
  address        String?
  contactPerson  String?
  creditLimit    Decimal        @default(0) @db.Decimal(18, 2)
  currentBalance Decimal        @default(0) @db.Decimal(18, 2)
  paymentTerms   String?
  status         SupplierStatus @default(ACTIVE)
  notes          String?
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company           Company                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division          Division?                 @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch            Branch?                   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy         User?                     @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?                     @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  purchaseOrders    PurchaseOrder[]
  fuelDeliveries    FuelDelivery[]
  payables          Payable[]
  productCategories SupplierProductCategory[]

  // Westsides (Milestone 6)
  productBatches   ProductBatch[]
  packageMovements PackageMovement[]

  // Itemba (Milestone 7)
