  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([userId, status, sessionType, expiresAt])
  @@map("active_sessions")
}

model BackupJob {
  id                     String              @id @default(uuid())
  backupJobCode          String              @unique
  name                   String
  backupType             BackupType
  schedule               BackupSchedule      @default(MANUAL)
  scheduleConfig         Json?
  storageTarget          BackupStorageTarget @default(LOCAL)
  storageConfigEncrypted Json?
  retentionDays          Int?
  status                 BackupJobStatus     @default(ACTIVE)
  lastRunAt              DateTime?
  nextRunAt              DateTime?
  createdById            String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  deletedAt              DateTime?

  createdBy User        @relation("BackupJobCreatedBy", fields: [createdById], references: [id])
  runs      BackupRun[]

  @@index([backupType, status, schedule])
  @@map("backup_jobs")
}

model BackupRun {
  id              String          @id @default(uuid())
  backupRunNumber String          @unique
  backupJobId     String?
  backupType      BackupType
  status          BackupRunStatus @default(REQUESTED)
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  filePath        String?
  fileSizeBytes   BigInt?
  checksum        String?
  errorMessage    String?
  triggeredById   String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  backupJob    BackupJob?    @relation(fields: [backupJobId], references: [id], onDelete: SetNull)
  triggeredBy  User?         @relation("BackupRunTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  restoreTests RestoreTest[]

  @@index([backupJobId, status, backupType, createdAt])
  @@map("backup_runs")
}

model RestoreTest {
  id                String            @id @default(uuid())
  restoreTestNumber String            @unique
  backupRunId       String?
  testDate          DateTime
  testType          RestoreTestType
