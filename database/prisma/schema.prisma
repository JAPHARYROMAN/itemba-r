// ───────────────────────────────────────────────────────────────────────────────
// A. LICENSED BUSINESS UNITS
// ───────────────────────────────────────────────────────────────────────────────

model LicensedBusinessUnit {
  id               String             @id @default(uuid())
  businessUnitCode String
  companyId        String
  divisionId       String?
  branchId         String?
  name             String
  tradingName      String?
  businessUnitType BusinessUnitType
  licenseRequired  Boolean            @default(false)
  primaryLicenseId String?
  status           BusinessUnitStatus @default(ACTIVE)
  location         String?
  managerId        String?
  startDate        DateTime?
  endDate          DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  company               Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division              Division?                @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch                Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager               User?                    @relation("LBUManager", fields: [managerId], references: [id], onDelete: SetNull)
  licenses              BusinessLicense[]        @relation("LBULicenses")
  rentalProperties      RentalProperty[]
  parkingFacilities     ParkingFacility[]
  hospitalityFacilities HospitalityFacility[]
  attachments           BusinessUnitAttachment[]

  // Milestone 9 — HR & Payroll
  departments         Department[]
  employees           Employee[]
  employeeAssignments EmployeeAssignment[]
  workShifts          WorkShift[]
  shiftSchedules      ShiftSchedule[]
  approvalWorkflows   ApprovalWorkflow[]

  @@unique([companyId, businessUnitCode])
  @@map("licensed_business_units")
}

model BusinessLicense {
  id                     String                @id @default(uuid())
  licenseCode            String
  companyId              String
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  licenseType            BusinessLicenseType
  licenseNumber          String
  issuingAuthority       String?
  issueDate              DateTime?
  expiryDate             DateTime?
  renewalDate            DateTime?
  status                 BusinessLicenseStatus @default(ACTIVE)
  documentId             String?
  responsibleUserId      String?
  notes                  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division             Division?             @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  licensedBusinessUnit LicensedBusinessUnit? @relation("LBULicenses", fields: [licensedBusinessUnitId], references: [id], onDelete: SetNull)
  responsibleUser      User?                 @relation("LicenseResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, licenseCode])
  @@index([divisionId])
  @@index([branchId])
  @@index([licensedBusinessUnitId])
  @@map("business_licenses")
}

// ───────────────────────────────────────────────────────────────────────────────
// B. RENTAL / REAL ESTATE MODELS
// ───────────────────────────────────────────────────────────────────────────────

model RentalProperty {
  id                     String               @id @default(uuid())
  propertyCode           String
  companyId              String
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  fixedAssetId           String?
  propertyName           String
  propertyType           RentalPropertyType
  location               String
  ownershipType          RentalOwnershipType
  status                 RentalPropertyStatus @default(ACTIVE)
  managerId              String?
  notes                  String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?

  company              Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division             Division?                @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  licensedBusinessUnit LicensedBusinessUnit?    @relation(fields: [licensedBusinessUnitId], references: [id], onDelete: SetNull)
  manager              User?                    @relation("PropertyManager", fields: [managerId], references: [id], onDelete: SetNull)
  rentalUnits          RentalUnit[]
  leases               LeaseAgreement[]
  maintenances         PropertyMaintenance[]
  rentInvoices         RentInvoice[]            @relation("InvoiceProperty")
  attachments          BusinessUnitAttachment[]

  @@unique([companyId, propertyCode])
  @@map("rental_properties")
}

model RentalUnit {
  id                    String           @id @default(uuid())
  unitCode              String
  companyId             String
  propertyId            String
  unitType              RentalUnitType
  unitNumber            String
  floor                 String?
  sizeDescription       String?
  rentAmount            Decimal          @db.Decimal(18, 2)
  currency              String           @default("TZS")
  billingFrequency      BillingFrequency
  securityDepositAmount Decimal?         @db.Decimal(18, 2)
  status                RentalUnitStatus @default(VACANT)
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  company      Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  property     RentalProperty        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  leases       LeaseAgreement[]
  rentInvoices RentInvoice[]
  maintenances PropertyMaintenance[]

  @@unique([propertyId, unitCode])
  @@map("rental_units")
}

model Tenant {
  id                   String       @id @default(uuid())
  tenantCode           String
  companyId            String
  tenantType           TenantType   @default(INDIVIDUAL)
  name                 String
  legalName            String?
  tin                  String?
  phone                String?
  email                String?
  address              String?
  contactPerson        String?
  identificationType   String?
  identificationNumber String?
  status               TenantStatus @default(ACTIVE)
  customerId           String?
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  deletedAt            DateTime?

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  customer Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  leases   LeaseAgreement[]
  invoices RentInvoice[]
  payments RentPayment[]

  @@unique([companyId, tenantCode])
  @@map("tenants")
}

model LeaseAgreement {
  id                    String           @id @default(uuid())
  leaseCode             String
  companyId             String
  propertyId            String
  rentalUnitId          String
  tenantId              String
  contractId            String?
  startDate             DateTime
  endDate               DateTime?
  rentAmount            Decimal          @db.Decimal(18, 2)
  currency              String           @default("TZS")
  billingFrequency      BillingFrequency
  securityDepositAmount Decimal?         @db.Decimal(18, 2)
  securityDepositPaid   Decimal          @default(0) @db.Decimal(18, 2)
  paymentTerms          String?
  status                LeaseStatus      @default(DRAFT)
  createdById           String
  approvedById          String?
  approvedAt            DateTime?
  notes                 String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  deletedAt             DateTime?

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  property   RentalProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  rentalUnit RentalUnit     @relation(fields: [rentalUnitId], references: [id], onDelete: Restrict)
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  createdBy  User           @relation("LeaseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?          @relation("LeaseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  invoices   RentInvoice[]

  @@unique([companyId, leaseCode])
  @@map("lease_agreements")
}

model RentInvoice {
  id                 String            @id @default(uuid())
  rentInvoiceNumber  String
  companyId          String
  propertyId         String
  rentalUnitId       String
  tenantId           String
  leaseAgreementId   String
  invoiceDate        DateTime
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  rentAmount         Decimal           @db.Decimal(18, 2)
  penaltyAmount      Decimal           @default(0) @db.Decimal(18, 2)
  discountAmount     Decimal           @default(0) @db.Decimal(18, 2)
  taxAmount          Decimal           @default(0) @db.Decimal(18, 2)
  totalAmount        Decimal           @db.Decimal(18, 2)
  paidAmount         Decimal           @default(0) @db.Decimal(18, 2)
  outstandingAmount  Decimal           @db.Decimal(18, 2)
  currency           String            @default("TZS")
  dueDate            DateTime?
  status             RentInvoiceStatus @default(DRAFT)
  receivableId       String?
  createdById        String
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  property       RentalProperty @relation("InvoiceProperty", fields: [propertyId], references: [id], onDelete: Restrict)
  rentalUnit     RentalUnit     @relation(fields: [rentalUnitId], references: [id], onDelete: Restrict)
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  leaseAgreement LeaseAgreement @relation(fields: [leaseAgreementId], references: [id], onDelete: Restrict)
  createdBy      User           @relation("RentInvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  payments       RentPayment[]

  @@unique([companyId, rentInvoiceNumber])
  @@map("rent_invoices")
}

model RentPayment {
  id                String               @id @default(uuid())
  rentPaymentNumber String
  companyId         String
  rentInvoiceId     String
  tenantId          String
  paymentDate       DateTime
  amount            Decimal              @db.Decimal(18, 2)
  currency          String               @default("TZS")
  paymentMethod     PaymentMethodGeneral
  cashAccountId     String?
  reference         String?
  receivedById      String
  notes             String?
  /// Client-supplied idempotency token. Two requests with the same key on the
  /// same company short-circuit to the original payment instead of double-charging.
  idempotencyKey    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rentInvoice RentInvoice @relation(fields: [rentInvoiceId], references: [id], onDelete: Restrict)
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  receivedBy  User        @relation("RentPaymentReceivedBy", fields: [receivedById], references: [id], onDelete: Restrict)

  @@unique([companyId, rentPaymentNumber])
  @@unique([companyId, idempotencyKey])
  @@map("rent_payments")
}

model PropertyMaintenance {
  id                String                    @id @default(uuid())
  maintenanceNumber String
  companyId         String
  propertyId        String
  rentalUnitId      String?
  maintenanceDate   DateTime
  maintenanceType   PropertyMaintenanceType
  description       String
  supplierId        String?
  costAmount        Decimal                   @default(0) @db.Decimal(18, 2)
  currency          String                    @default("TZS")
  status            PropertyMaintenanceStatus @default(REPORTED)
  expenseId         String?
  createdById       String
  completedById     String?
  notes             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  property    RentalProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  rentalUnit  RentalUnit?    @relation(fields: [rentalUnitId], references: [id], onDelete: SetNull)
  supplier    Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy   User           @relation("PropMaintCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy User?          @relation("PropMaintCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([companyId, maintenanceNumber])
  @@map("property_maintenances")
}

// ───────────────────────────────────────────────────────────────────────────────
// C. TRUCK PARKING MODELS
// ───────────────────────────────────────────────────────────────────────────────

model ParkingFacility {
  id                     String                @id @default(uuid())
  facilityCode           String
  companyId              String
  divisionId             String?
  branchId               String?
  licensedBusinessUnitId String?
  facilityName           String
  location               String
  capacityTrucks         Int?
  status                 ParkingFacilityStatus @default(ACTIVE)
  managerId              String?
  notes                  String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?

  company              Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division             Division?             @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch               Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  licensedBusinessUnit LicensedBusinessUnit? @relation(fields: [licensedBusinessUnitId], references: [id], onDelete: SetNull)
