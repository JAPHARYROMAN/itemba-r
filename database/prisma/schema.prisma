  BUG
  QUESTION
  FEATURE_REQUEST
  TRAINING_REQUEST
  ACCESS_REQUEST
  DATA_CORRECTION
  CONFIGURATION
  OTHER
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
  CANCELLED
}

// ---- Models ----

model QATestSuite {
  id          String          @id @default(uuid())
  suiteCode   String          @unique
  name        String
  description String?
  suiteType   QATestSuiteType
  moduleName  String?
  priority    QAPriority      @default(MEDIUM)
  status      QASuiteStatus   @default(DRAFT)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  createdBy User         @relation("QATestSuiteCreatedBy", fields: [createdById], references: [id])
  testCases QATestCase[]
  testRuns  QATestRun[]

  @@index([suiteType])
  @@index([moduleName])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model QATestCase {
  id                  String         @id @default(uuid())
  testCaseCode        String         @unique
  testSuiteId         String
  title               String
  description         String?
  preconditions       String?
  steps               Json
  expectedResult      String
  moduleName          String?
  roleContext         String?
  companyContext      String?
  priority            QAPriority     @default(MEDIUM)
  testType            QATestCaseType @default(MANUAL)
  automationReference String?
  status              QACaseStatus   @default(DRAFT)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  testSuite   QATestSuite    @relation(fields: [testSuiteId], references: [id], onDelete: Restrict)
  testResults QATestResult[]

  @@index([testSuiteId])
  @@index([moduleName])
  @@index([status])
  @@index([priority])
  @@index([testType])
}

model QATestRun {
  id            String               @id @default(uuid())
  testRunNumber String               @unique
  testSuiteId   String?
  runName       String
  runType       QATestRunType        @default(MANUAL)
  environment   QATestRunEnvironment @default(TEST)
  startedById   String
  startedAt     DateTime
  completedAt   DateTime?
  status        QATestRunStatus      @default(PLANNED)
  totalCases    Int                  @default(0)
  passedCases   Int                  @default(0)
  failedCases   Int                  @default(0)
  blockedCases  Int                  @default(0)
  skippedCases  Int                  @default(0)
  resultSummary Json?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  testSuite   QATestSuite?   @relation(fields: [testSuiteId], references: [id], onDelete: SetNull)
  startedBy   User           @relation("QATestRunStartedBy", fields: [startedById], references: [id])
  testResults QATestResult[]

  @@index([testSuiteId])
  @@index([status])
  @@index([environment])
  @@index([startedAt])
  @@index([startedById])
}

model QATestResult {
  id                 String             @id @default(uuid())
  testRunId          String
  testCaseId         String
  status             QATestResultStatus @default(NOT_RUN)
  actualResult       String?
  failureReason      String?
  evidenceDocumentId String?
  screenshotUrl      String?
  executedById       String?
  executedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  testRun    QATestRun  @relation(fields: [testRunId], references: [id], onDelete: Restrict)
  testCase   QATestCase @relation(fields: [testCaseId], references: [id], onDelete: Restrict)
  executedBy User?      @relation("QATestResultExecutedBy", fields: [executedById], references: [id])

  @@index([testRunId])
  @@index([testCaseId])
  @@index([status])
  @@index([executedById])
}

model LaunchBlocker {
  id                   String              @id @default(uuid())
  blockerNumber        String
  title                String
  description          String
  blockerType          LaunchBlockerType
  severity             AuditSeverity       @default(MEDIUM)
  moduleName           String?
  companyId            String?
  relatedEntityType    String?
  relatedEntityId      String?
  status               LaunchBlockerStatus @default(OPEN)
  reportedById         String
  assignedToId         String?
  resolvedById         String?
  resolvedAt           DateTime?
  acceptanceReason     String?
  targetResolutionDate DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  deletedAt            DateTime?

  reportedBy User  @relation("LaunchBlockerReportedBy", fields: [reportedById], references: [id])
  assignedTo User? @relation("LaunchBlockerAssignedTo", fields: [assignedToId], references: [id])
  resolvedBy User? @relation("LaunchBlockerResolvedBy", fields: [resolvedById], references: [id])

  @@unique([companyId, blockerNumber])
  @@index([status])
  @@index([severity])
  @@index([blockerType])
  @@index([moduleName])
  @@index([companyId])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([createdAt])
}

model LaunchReadinessAssessment {
  id                 String                          @id @default(uuid())
  assessmentNumber   String                          @unique
  environment        LaunchReadinessEnvironment
  assessmentDate     DateTime
  status             LaunchReadinessAssessmentStatus @default(DRAFT)
  overallScore       Decimal?                        @db.Decimal(5, 2)
  securityScore      Decimal?                        @db.Decimal(5, 2)
  accountingScore    Decimal?                        @db.Decimal(5, 2)
  dataQualityScore   Decimal?                        @db.Decimal(5, 2)
  performanceScore   Decimal?                        @db.Decimal(5, 2)
  uiUxScore          Decimal?                        @db.Decimal(5, 2)
  documentationScore Decimal?                        @db.Decimal(5, 2)
  trainingScore      Decimal?                        @db.Decimal(5, 2)
  qaScore            Decimal?                        @db.Decimal(5, 2)
  summary            String?
  risks              Json?
  recommendations    Json?
  assessedById       String
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  deletedAt          DateTime?

  assessedBy     User                  @relation("LaunchAssessmentAssessedBy", fields: [assessedById], references: [id])
  approvedBy     User?                 @relation("LaunchAssessmentApprovedBy", fields: [approvedById], references: [id])
  readinessItems LaunchReadinessItem[]

  @@index([status])
  @@index([environment])
  @@index([assessmentDate])
  @@index([assessedById])
}

model LaunchReadinessItem {
  id                 String                      @id @default(uuid())
  assessmentId       String
  category           LaunchReadinessItemCategory
  title              String
  description        String?
  status             LaunchReadinessItemStatus   @default(NOT_STARTED)
  evidenceDocumentId String?
  responsibleUserId  String?
  completedById      String?
  completedAt        DateTime?
  notes              String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  assessment      LaunchReadinessAssessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  responsibleUser User?                     @relation("LaunchItemResponsible", fields: [responsibleUserId], references: [id])
  completedBy     User?                     @relation("LaunchItemCompletedBy", fields: [completedById], references: [id])

  @@index([assessmentId])
  @@index([category])
  @@index([status])
}

model UserManual {
  id            String           @id @default(uuid())
  manualCode    String           @unique
  title         String
  moduleName    String?
  roleName      String?
  manualType    UserManualType
  content       String
  status        UserManualStatus @default(DRAFT)
  version       String
  createdById   String
  reviewedById  String?
  reviewedAt    DateTime?
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  createdBy   User  @relation("UserManualCreatedBy", fields: [createdById], references: [id])
  reviewedBy  User? @relation("UserManualReviewedBy", fields: [reviewedById], references: [id])
  publishedBy User? @relation("UserManualPublishedBy", fields: [publishedById], references: [id])

  @@index([status])
  @@index([manualType])
  @@index([moduleName])
  @@index([roleName])
  @@index([createdAt])
}

model HelpArticle {
  id              String              @id @default(uuid())
  articleCode     String              @unique
  title           String
  category        HelpArticleCategory
  content         String
  tags            Json?
  status          HelpArticleStatus   @default(DRAFT)
  viewCount       Int                 @default(0)
  helpfulCount    Int                 @default(0)
  notHelpfulCount Int                 @default(0)
  createdById     String
  publishedById   String?
  publishedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  createdBy   User  @relation("HelpArticleCreatedBy", fields: [createdById], references: [id])
  publishedBy User? @relation("HelpArticlePublishedBy", fields: [publishedById], references: [id])

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

model TrainingCourse {
  id               String                   @id @default(uuid())
  courseCode       String                   @unique
  title            String
  description      String?
  roleName         String?
  moduleName       String?
  difficulty       TrainingCourseDifficulty @default(BEGINNER)
  status           TrainingCourseStatus     @default(DRAFT)
  estimatedMinutes Int?
  createdById      String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?

  createdBy   User                 @relation("TrainingCourseCreatedBy", fields: [createdById], references: [id])
  lessons     TrainingLesson[]
  enrollments TrainingEnrollment[]

  @@index([status])
  @@index([roleName])
  @@index([moduleName])
  @@index([difficulty])
}

model TrainingLesson {
  id                String               @id @default(uuid())
  trainingCourseId  String
  lessonCode        String               @unique
  title             String
  description       String?
  lessonOrder       Int
  content           String
  lessonType        TrainingLessonType   @default(TEXT)
  walkthroughConfig Json?
  quizConfig        Json?
  status            TrainingLessonStatus @default(DRAFT)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  deletedAt         DateTime?

  trainingCourse   TrainingCourse           @relation(fields: [trainingCourseId], references: [id], onDelete: Restrict)
  lessonProgresses TrainingLessonProgress[]

  @@index([trainingCourseId])
  @@index([lessonOrder])
  @@index([status])
}

model TrainingEnrollment {
  id               String                   @id @default(uuid())
  trainingCourseId String
  userId           String
  assignedById     String?
  status           TrainingEnrollmentStatus @default(ASSIGNED)
  progressPercent  Decimal                  @default(0) @db.Decimal(5, 2)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  trainingCourse   TrainingCourse           @relation(fields: [trainingCourseId], references: [id], onDelete: Restrict)
  user             User                     @relation("TrainingEnrollmentUser", fields: [userId], references: [id])
  assignedBy       User?                    @relation("TrainingEnrollmentAssignedBy", fields: [assignedById], references: [id])
  lessonProgresses TrainingLessonProgress[]

  @@unique([trainingCourseId, userId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model TrainingLessonProgress {
  id                   String                       @id @default(uuid())
  trainingEnrollmentId String
  trainingLessonId     String
  status               TrainingLessonProgressStatus @default(NOT_STARTED)
  score                Decimal?                     @db.Decimal(5, 2)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  trainingEnrollment TrainingEnrollment @relation(fields: [trainingEnrollmentId], references: [id], onDelete: Restrict)
  trainingLesson     TrainingLesson     @relation(fields: [trainingLessonId], references: [id], onDelete: Restrict)

  @@index([trainingEnrollmentId])
  @@index([trainingLessonId])
  @@index([status])
}

model GuidedWalkthrough {
  id              String                  @id @default(uuid())
  walkthroughCode String                  @unique
  title           String
  moduleName      String?
  routePath       String?
  roleName        String?
  description     String?
  steps           Json
  status          GuidedWalkthroughStatus @default(DRAFT)
  createdById     String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?

  createdBy      User                      @relation("GuidedWalkthroughCreatedBy", fields: [createdById], references: [id])
  userProgresses UserWalkthroughProgress[]

  @@index([status])
  @@index([moduleName])
  @@index([roleName])
  @@index([routePath])
}

model UserWalkthroughProgress {
  id                  String                        @id @default(uuid())
  userId              String
  guidedWalkthroughId String
  status              UserWalkthroughProgressStatus @default(NOT_STARTED)
  currentStep         Int                           @default(0)
  completedAt         DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  user              User              @relation("UserWalkthroughProgressUser", fields: [userId], references: [id])
  guidedWalkthrough GuidedWalkthrough @relation(fields: [guidedWalkthroughId], references: [id], onDelete: Restrict)

  @@unique([userId, guidedWalkthroughId])
  @@index([userId])
  @@index([guidedWalkthroughId])
  @@index([status])
}

model TrainingEnvironmentConfig {
  id             String                    @id @default(uuid())
  configCode     String                    @unique
  name           String
  description    String?
  environment    TrainingEnvironmentType
  seedProfile    TrainingSeedProfile       @default(STANDARD)
  resetFrequency TrainingResetFrequency    @default(MANUAL)
  lastResetAt    DateTime?
  status         TrainingEnvironmentStatus @default(ACTIVE)
  createdById    String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  deletedAt      DateTime?

  createdBy User @relation("TrainingEnvCreatedBy", fields: [createdById], references: [id])

  @@index([status])
  @@index([environment])
}

model SupportTicket {
  id           String                @id @default(uuid())
  ticketNumber String
  companyId    String?
  reportedById String
  assignedToId String?
  moduleName   String?
  title        String
  description  String
  ticketType   SupportTicketType     @default(QUESTION)
  priority     SupportTicketPriority @default(NORMAL)
  status       SupportTicketStatus   @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?

  reportedBy User                   @relation("SupportTicketReportedBy", fields: [reportedById], references: [id])
  assignedTo User?                  @relation("SupportTicketAssignedTo", fields: [assignedToId], references: [id])
  resolvedBy User?                  @relation("SupportTicketResolvedBy", fields: [resolvedById], references: [id])
  comments   SupportTicketComment[]

  @@unique([companyId, ticketNumber])
  @@index([status])
  @@index([priority])
  @@index([ticketType])
  @@index([companyId])
  @@index([reportedById])
  @@index([assignedToId])
  @@index([createdAt])
}

model SupportTicketComment {
  id              String    @id @default(uuid())
  supportTicketId String
  userId          String
  comment         String
  internal        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  supportTicket SupportTicket @relation(fields: [supportTicketId], references: [id], onDelete: Restrict)
  user          User          @relation("SupportTicketCommentUser", fields: [userId], references: [id])

  @@index([supportTicketId])
  @@index([userId])
  @@index([internal])
  @@index([createdAt])
}
