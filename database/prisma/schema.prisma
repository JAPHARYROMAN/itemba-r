// ───────────────────────────────────────────────────────────────────────────────
// SECTION 1: SHARED ITEMBA ENUMS & MODELS
// ───────────────────────────────────────────────────────────────────────────────

enum ItembaWorkUnitType {
  LOGISTICS_ROUTE
  AGRICULTURE_FARM
  AGRICULTURE_FIELD
  CONSTRUCTION_PROJECT
  CONSTRUCTION_SITE
  WAREHOUSE
  WORKSHOP
  OTHER
}

enum ItembaWorkUnitStatus {
  ACTIVE
  INACTIVE
  COMPLETED
  SUSPENDED
  CLOSED
}

enum EquipmentUsageContextType {
  LOGISTICS_TRIP
  AGRICULTURE_FIELD
  AGRICULTURE_SEASON
  CONSTRUCTION_PROJECT
  CONSTRUCTION_SITE
  GENERAL
}

enum LaborContextType {
  AGRICULTURE_FIELD
  AGRICULTURE_SEASON
  CONSTRUCTION_PROJECT
  CONSTRUCTION_SITE
  LOGISTICS_TRIP
  GENERAL
}

enum LaborPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model ItembaWorkUnit {
  id           String               @id @default(uuid())
  companyId    String
  divisionId   String
  branchId     String?
  workUnitCode String
  name         String
  workUnitType ItembaWorkUnitType
  status       ItembaWorkUnitStatus @default(ACTIVE)
  location     String?
  managerId    String?
  startDate    DateTime?
  endDate      DateTime?
  notes        String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager  User?    @relation("WorkUnitManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@unique([companyId, workUnitCode])
  @@map("itemba_work_units")
}

model EquipmentUsage {
  id                String                    @id @default(uuid())
  usageNumber       String
  companyId         String
  divisionId        String
  branchId          String?
  fixedAssetId      String?
  equipmentName     String?
  usageContextType  EquipmentUsageContextType @default(GENERAL)
  usageContextId    String?
  usageDate         DateTime                  @db.Date
  startMeterReading Decimal?                  @db.Decimal(18, 2)
  endMeterReading   Decimal?                  @db.Decimal(18, 2)
  hoursUsed         Decimal?                  @db.Decimal(10, 2)
  fuelUsedLitres    Decimal?                  @db.Decimal(10, 2)
  operatorId        String?
  costAmount        Decimal?                  @db.Decimal(18, 2)
  currency          String?
  notes             String?
  createdById       String
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  deletedAt         DateTime?

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division   Division    @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  branch     Branch?     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  fixedAsset FixedAsset? @relation(fields: [fixedAssetId], references: [id], onDelete: SetNull)
  operator   User?       @relation("EquipmentOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  createdBy  User        @relation("EquipmentUsageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, usageNumber])
  @@map("equipment_usages")
}

model LaborRecord {
  id                String             @id @default(uuid())
  laborRecordNumber String
  companyId         String
  divisionId        String
  branchId          String?
  laborContextType  LaborContextType   @default(GENERAL)
  laborContextId    String?
  workerId          String?
  workerName        String?
  laborDate         DateTime           @db.Date
  role              String?
  hoursWorked       Decimal?           @db.Decimal(10, 2)
  dayRate           Decimal?           @db.Decimal(18, 2)
  totalAmount       Decimal            @db.Decimal(18, 2)
  currency          String
  paymentStatus     LaborPaymentStatus @default(UNPAID)
  expenseId         String?
  notes             String?
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division  Division @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  worker    User?    @relation("LaborWorker", fields: [workerId], references: [id], onDelete: SetNull)
  createdBy User     @relation("LaborRecordCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([companyId, laborRecordNumber])
  @@map("labor_records")
}

// ───────────────────────────────────────────────────────────────────────────────
// SECTION 2: LOGISTICS ENUMS & MODELS
// ───────────────────────────────────────────────────────────────────────────────

enum VehicleType {
  TRUCK
  TRAILER
  PICKUP
  VAN
  MOTORCYCLE
  TRACTOR
  HEAVY_EQUIPMENT
  OTHER
}

enum VehicleFuelType {
  DIESEL
  PETROL
  ELECTRIC
  HYBRID
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  UNDER_MAINTENANCE
  SOLD
  DISPOSED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum RouteStatus {
  ACTIVE
  INACTIVE
}

enum TripStatus {
  PLANNED
  DISPATCHED
  IN_TRANSIT
  COMPLETED
  CANCELLED
  CLOSED
}

enum TripExpenseType {
  FUEL
  DRIVER_ALLOWANCE
  TOLL
  PARKING
  MAINTENANCE
  LOADING
  UNLOADING
  FOOD
  ACCOMMODATION
  POLICE_FINE
  OTHER
}

enum FuelSource {
  INTERNAL
  EXTERNAL_STATION
  MWANJALISI_OIL
  OTHER
}

enum MaintenanceType {
  SERVICE
  REPAIR
  INSPECTION
  TYRE
  OIL_CHANGE
  BREAKDOWN
  OTHER
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Vehicle {
  id                    String          @id @default(uuid())
  vehicleCode           String
  companyId             String
  divisionId            String
  fixedAssetId          String?
  registrationNumber    String
  vehicleType           VehicleType
  make                  String?
  model                 String?
  year                  Int?
  capacityDescription   String?
  fuelType              VehicleFuelType @default(DIESEL)
  status                VehicleStatus   @default(ACTIVE)
  currentOdometer       Decimal?        @db.Decimal(12, 2)
  insuranceExpiryDate   DateTime?       @db.Date
  roadLicenseExpiryDate DateTime?       @db.Date
  inspectionExpiryDate  DateTime?       @db.Date
  assignedDriverId      String?         @unique
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  deletedAt             DateTime?

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division       Division       @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  fixedAsset     FixedAsset?    @relation("VehicleFixedAsset", fields: [fixedAssetId], references: [id], onDelete: SetNull)
  assignedDriver DriverProfile? @relation("AssignedVehicle", fields: [assignedDriverId], references: [id], onDelete: SetNull)

  trips              Trip[]
  maintenanceRecords VehicleMaintenance[]
  fuelUsageRecords   TripFuelUsage[]
  driverProfiles     DriverProfile[]      @relation("DriverAssignedVehicle")

  @@unique([companyId, vehicleCode])
  @@unique([companyId, registrationNumber])
  @@map("vehicles")
}

model DriverProfile {
  id                String       @id @default(uuid())
  driverCode        String
  companyId         String
  divisionId        String
  userId            String?
  employeeId        String?
  fullName          String
  phone             String?
  licenseNumber     String?
  licenseClass      String?
  licenseExpiryDate DateTime?    @db.Date
  status            DriverStatus @default(ACTIVE)
  assignedVehicleId String?
  emergencyContact  String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

