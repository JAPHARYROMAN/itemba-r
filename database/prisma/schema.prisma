/// OSHA (Occupational Safety & Health Authority) workplace registration — one
/// per branch / workplace per certificate. Tanzania's OSHA Act, 2003 requires
/// every workplace to be registered and inspected periodically; the
/// certificate has a fixed expiry and must be renewed before lapse.
///
/// Tracking these in-system lets the dashboard surface upcoming expiries the
/// same way contracts and documents do.
model OshaRegistration {
  id                 String                  @id @default(uuid())
  companyId          String
  branchId           String
  certificateNumber  String
  registrationType   OshaRegistrationType    @default(GENERAL)
  issuedAt           DateTime?               @db.Date
  expiresAt          DateTime                @db.Date
  inspectorName      String?
  inspectorContact   String?
  riskClassification OshaRiskClassification?
  status             OshaRegistrationStatus  @default(ACTIVE)
  documentId         String?
  notes              String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([companyId, certificateNumber])
  @@index([branchId])
  @@index([expiresAt])
  @@index([status])
  @@map("osha_registrations")
}

enum OshaRegistrationType {
  GENERAL
  HAZARDOUS_PROCESS
  CHEMICAL_PLANT
  PETROLEUM_FACILITY
  CONSTRUCTION_SITE
  WAREHOUSE
  OFFICE
  OTHER
}

enum OshaRegistrationStatus {
  ACTIVE
  PENDING_RENEWAL
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum OshaRiskClassification {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Periodic medical examination record for an employee. Required annually
/// (or more frequently in hazard sectors — petroleum pump attendants,
/// drivers, mining, food handling) under Tanzanian OSHA / public-health rules.
///
/// `expiresAt` drives renewal alerts and `fitnessStatus` gates whether the
/// employee can be assigned to certain work shifts (e.g. driver rosters skip
/// UNFIT employees).
model MedicalExamRecord {
  id            String               @id @default(uuid())
  companyId     String
  employeeId    String
  examType      MedicalExamType      @default(ANNUAL)
  examDate      DateTime             @db.Date
  expiresAt     DateTime             @db.Date
  fitnessStatus MedicalFitnessStatus @default(FIT)
  doctorName    String?
  facilityName  String?
  hazardSector  Boolean              @default(false)
  restrictions  String?
  documentId    String?
  notes         String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deletedAt     DateTime?

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, expiresAt])
  @@index([companyId, expiresAt])
  @@map("medical_exam_records")
}

enum MedicalExamType {
  PRE_EMPLOYMENT
  ANNUAL
  POST_INCIDENT
  RETURN_TO_WORK
  FITNESS_FOR_DUTY
  HAZARD_SECTOR
  OTHER
}

enum MedicalFitnessStatus {
  FIT
  FIT_WITH_RESTRICTIONS
  TEMPORARILY_UNFIT
  UNFIT
}

/// Employment dispute — grievance, dismissal challenge, wage dispute, etc.
/// Workflow follows Tanzanian Employment & Labour Relations Act, 2004:
///   RAISED → INTERNAL_MEDIATION → CMA_REFERRED → CMA_HEARING → RESOLVED / DISMISSED
///
/// CMA = Commission for Mediation & Arbitration. Cases that don't resolve
/// internally must be filed with CMA within 30 days using Form CMA-F1.
model EmploymentDispute {
  id                 String                       @id @default(uuid())
  disputeNumber      String
  companyId          String
  divisionId         String?
  branchId           String?
  employeeId         String
  raisedById         String
  type               EmploymentDisputeType
  status             EmploymentDisputeStatus      @default(RAISED)
  directToGroupHr    Boolean                      @default(false)
  groupHrNotifiedAt  DateTime?
  raisedAt           DateTime
  summary            String
  initialPosition    String?
  // Internal mediation
  mediatedById       String?
  mediatedAt         DateTime?
  mediationOutcome   String?
  // CMA referral
  cmaReferenceNumber String?
  cmaReferredById    String?
  cmaReferredAt      DateTime?
  cmaArbitrator      String?
  cmaHearingDate     DateTime?
  // Resolution
  resolvedById       String?
  resolvedAt         DateTime?
  resolutionType     EmploymentDisputeResolution?
  resolutionAmount   Decimal?                     @db.Decimal(18, 2)
  resolutionCurrency CurrencyCode                 @default(TZS)
  resolutionNotes    String?
  notes              String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  deletedAt          DateTime?

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  division            Division?            @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  branch              Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  employee            Employee             @relation("DisputeEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  raisedBy            User                 @relation("DisputeRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)
  mediatedBy          User?                @relation("DisputeMediatedBy", fields: [mediatedById], references: [id], onDelete: SetNull)
  cmaReferredBy       User?                @relation("DisputeCmaReferredBy", fields: [cmaReferredById], references: [id], onDelete: SetNull)
  resolvedBy          User?                @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  disciplinaryActions DisciplinaryAction[]

  @@unique([companyId, disputeNumber])
  @@index([employeeId])
  @@index([companyId, status])
  @@index([divisionId, status])
  @@index([branchId, status])
  @@index([directToGroupHr, status])
  @@map("employment_disputes")
}

enum EmploymentDisputeType {
  GRIEVANCE
  WAGE_DISPUTE
  WORKING_CONDITIONS
  HARASSMENT
  DISCRIMINATION
  UNFAIR_TERMINATION
  CONSTRUCTIVE_DISMISSAL
  CONTRACT_BREACH
  OTHER
}

enum EmploymentDisputeStatus {
  RAISED
  INTERNAL_MEDIATION
  CMA_REFERRED
  CMA_HEARING
  RESOLVED
  DISMISSED
  WITHDRAWN
}

enum EmploymentDisputeResolution {
  SETTLED_INTERNALLY
  CMA_AWARD_FOR_EMPLOYEE
  CMA_AWARD_FOR_EMPLOYER
  WITHDRAWN_BY_EMPLOYEE
  ABANDONED
  OTHER
}

/// Disciplinary action — verbal warning, written warning, suspension, etc.
/// May or may not link to an `EmploymentDispute` depending on whether the
/// employee is contesting it.
model DisciplinaryAction {
  id               String                   @id @default(uuid())
  actionNumber     String
  companyId        String
  employeeId       String
  disputeId        String?
  type             DisciplinaryActionType
  status           DisciplinaryActionStatus @default(ACTIVE)
  issuedAt         DateTime
  effectiveFrom    DateTime?
  effectiveTo      DateTime?
  reason           String
  evidence         String?
  employeeResponse String?
  issuedById       String
  hrApprovedById   String?
  hrApprovedAt     DateTime?
  gmApprovedById   String?
  gmApprovedAt     DateTime?
  approvedById     String?
  approvedAt       DateTime?
  /// Optional financial fine attached to the action. When set and the action
  /// is APPROVED/ACTIVE, the disciplinary service creates a one-shot
  /// EmployeeDeduction (DISCIPLINARY type) so the next payroll deducts it
  /// from the employee's pay. Null = no fine, action is non-monetary.
  fineAmount       Decimal?                 @db.Decimal(18, 2)
  /// FK back to the EmployeeDeduction created when the fine is applied —
  /// idempotency guard for re-application + audit traceability.
  fineDeductionId  String?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  deletedAt        DateTime?

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee   Employee           @relation("DisciplinaryEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  dispute    EmploymentDispute? @relation(fields: [disputeId], references: [id], onDelete: SetNull)
  issuedBy   User               @relation("DisciplinaryIssuedBy", fields: [issuedById], references: [id], onDelete: Restrict)
  approvedBy User?              @relation("DisciplinaryApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([companyId, actionNumber])
  @@index([employeeId])
  @@index([companyId, status])
  @@map("disciplinary_actions")
}

enum DisciplinaryActionType {
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  SUSPENSION_WITH_PAY
  SUSPENSION_WITHOUT_PAY
  DEMOTION
  TERMINATION
  OTHER
}

enum DisciplinaryActionStatus {
  PENDING_HR_APPROVAL
  PENDING_GM_APPROVAL
  ACTIVE
  EXPIRED
  OVERTURNED
  WITHDRAWN
}

