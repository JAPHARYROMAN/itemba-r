model AuditAdjustment {
  id                     String                @id @default(uuid())
  adjustmentNumber       String                @unique
  companyId              String
  fiscalYearId           String?
  accountingPeriodId     String?
  description            String
  reason                 String
  journalEntryId         String?
  /// When the adjustment is reversed, this points at the reversing JE so the
  /// pair can be presented together. Reversal preserves traceability — both
  /// original and reversal stay in the audit trail.
  reversalJournalEntryId String?
  reversedAt             DateTime?
  reversedById           String?
  reversalReason         String?
  status                 AuditAdjustmentStatus @default(DRAFT)
  createdById            String
  approvedById           String?
  approvedAt             DateTime?
  postedById             String?
  postedAt               DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  deletedAt              DateTime?

  company          Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  fiscalYear       FiscalYear?           @relation(fields: [fiscalYearId], references: [id], onDelete: SetNull)
  accountingPeriod AccountingPeriod?     @relation(fields: [accountingPeriodId], references: [id], onDelete: SetNull)
  createdBy        User                  @relation("AuditAdjCreatedBy", fields: [createdById], references: [id])
  approvedBy       User?                 @relation("AuditAdjApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  postedBy         User?                 @relation("AuditAdjPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reversedBy       User?                 @relation("AuditAdjReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  lines            AuditAdjustmentLine[]

  @@index([companyId, status])
  @@map("audit_adjustments")
}

model AuditAdjustmentLine {
  id                String   @id @default(uuid())
  auditAdjustmentId String
  accountId         String
  description       String?
  /// Amount to post on the debit side of the original entry (0 if this is a credit line).
  debit             Decimal  @default(0) @db.Decimal(18, 2)
  /// Amount to post on the credit side of the original entry (0 if this is a debit line).
  credit            Decimal  @default(0) @db.Decimal(18, 2)
  createdAt         DateTime @default(now())

  auditAdjustment AuditAdjustment @relation(fields: [auditAdjustmentId], references: [id], onDelete: Cascade)
  account         ChartOfAccount  @relation("AuditAdjustmentLineAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@index([auditAdjustmentId])
  @@map("audit_adjustment_lines")
}

