/// Persisted record of payroll cost allocated to a construction project.
///
/// Created by `ConstructionLabourCostService.allocateForRun()` when a payroll
/// run is paid: each (payrollEntry, project) pair gets one row with the
/// proportional gross + employer-side statutory cost. Idempotent on the
/// composite unique key — re-running allocation on the same run upserts.
///
/// Powers project P&L without re-running the read-only labour-cost report
/// against historical payroll data.
model ProjectCostAllocation {
  id                         String   @id @default(uuid())
  companyId                  String
  projectId                  String
  payrollEntryId             String
  payrollRunId               String
  employeeId                 String
  /// Number of overlap days driving this allocation (audit / re-derive).
  days                       Int
  /// Allocated portion of the entry's gross pay.
  allocatedGross             Decimal  @db.Decimal(18, 2)
  /// Allocated portion of the employer-side statutory contribution
  /// (NSSF/PSSSF + WCF + SDL + employer NHIF).
  allocatedEmployerStatutory Decimal  @db.Decimal(18, 2)
  /// Sum of the two — the project's labour cost line for this entry.
  allocatedTotalCost         Decimal  @db.Decimal(18, 2)
  currency                   String
  /// Optional FK to the journal entry that booked the project-level expense.
  /// Null until the optional GL re-classification step runs.
  journalEntryId             String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  company      Company             @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project      ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  payrollEntry PayrollEntry        @relation(fields: [payrollEntryId], references: [id], onDelete: Cascade)
  payrollRun   PayrollRun          @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee     Employee            @relation("EmployeeCostAllocations", fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([payrollEntryId, projectId])
  @@index([companyId, projectId])
  @@index([payrollRunId])
  @@map("project_cost_allocations")
}

