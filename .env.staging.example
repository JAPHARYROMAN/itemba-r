# ITEMBA-R staging environment
# Copy to .env.staging and replace every placeholder before deployment.

POSTGRES_DB=itemba_r_staging
POSTGRES_USER=itemba_staging
POSTGRES_PASSWORD=

REDIS_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
REFRESH_TOKEN_PEPPER=
APP_ENCRYPTION_KEY=

JWT_ACCESS_EXPIRES_IN=never
JWT_REFRESH_EXPIRES_IN=never
AUTH_COOKIE_MAX_AGE_SECONDS=315360000
SEED_ADMIN_EMAIL=admin@itembagrouptz.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=true
JOB_WORKER_ENABLED=true
STORAGE_LOCAL_PATH=/app/storage
BACKUP_STORAGE_PATH=/app/backups
BACKUPS_DIR=/app/backups
EXPORTS_DIR=/app/exports

FRONTEND_URL=https://staging.itembagrouptz.com
APP_URL=https://staging.itembagrouptz.com
CORS_ORIGIN=https://staging.itembagrouptz.com
NEXT_PUBLIC_API_URL=https://api-staging.itembagrouptz.com/api/v1
NEXT_PUBLIC_WEBSITE_URL=https://itembagrouptz.com
BACKEND_INTERNAL_URL=http://backend:3001/api/v1
FUELGRID_APP_URL=https://fuelgrid-staging.itembagrouptz.com
FUELGRID_HEALTH_URL=
APP_HOST=staging.itembagrouptz.com
API_HOST=api-staging.itembagrouptz.com
WEBSITE_HOST=staging-www.itembagrouptz.com
WEBSITE_WWW_HOST=www-staging.itembagrouptz.com
ACME_EMAIL=info@itembagrouptz.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@itembagrouptz.com

# External integration live smoke tests.
# Recommended deployment gate:
# npm run smoke:external-integrations:live -- --staging
EXTERNAL_SMOKE_REQUIRE=LIVE,SMTP
EXTERNAL_SMOKE_EMAIL_TO=
EXTERNAL_SMOKE_SEND_EMAIL=true
EXTERNAL_SMOKE_HTTP_TARGETS=

# Optional SMS and mobile-money provider credentials.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
TIGOPESA_USERNAME=
TIGOPESA_PASSWORD=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
