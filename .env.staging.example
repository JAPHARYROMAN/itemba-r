# ITEMBA-R staging environment
# Copy to .env.staging and replace every placeholder before deployment.

POSTGRES_DB=itemba_r_staging
POSTGRES_USER=itemba_staging
POSTGRES_PASSWORD=

REDIS_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
