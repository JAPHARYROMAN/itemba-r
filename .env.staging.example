REFRESH_TOKEN_PEPPER=
APP_ENCRYPTION_KEY=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JOB_WORKER_ENABLED=true

FRONTEND_URL=
CORS_ORIGIN=
NEXT_PUBLIC_API_URL=
