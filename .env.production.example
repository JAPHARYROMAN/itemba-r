# ITEMBA-R production environment
# Copy to .env.production and replace every placeholder before deployment.

POSTGRES_DB=itemba_r
POSTGRES_USER=itemba_user
POSTGRES_PASSWORD=

REDIS_PASSWORD=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=
REFRESH_TOKEN_PEPPER=
APP_ENCRYPTION_KEY=

JWT_ACCESS_EXPIRES_IN=never
JWT_REFRESH_EXPIRES_IN=never
AUTH_COOKIE_MAX_AGE_SECONDS=315360000
SEED_ADMIN_EMAIL=admin@itembagrouptz.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_DATA=true
JOB_WORKER_ENABLED=true
STORAGE_LOCAL_PATH=/app/storage
BACKUP_STORAGE_PATH=/app/backups
BACKUPS_DIR=/app/backups
EXPORTS_DIR=/app/exports

FRONTEND_URL=https://app.itembagrouptz.com
APP_URL=https://app.itembagrouptz.com
CORS_ORIGIN=https://app.itembagrouptz.com,https://itembagrouptz.com,https://www.itembagrouptz.com
NEXT_PUBLIC_API_URL=https://api.itembagrouptz.com/api/v1
NEXT_PUBLIC_WEBSITE_URL=https://itembagrouptz.com
BACKEND_INTERNAL_URL=http://backend:3001/api/v1
FUELGRID_APP_URL=https://fuelgrid.itembagrouptz.com
FUELGRID_HEALTH_URL=https://api.fuelgrid.itembagrouptz.com/readyz
# If you provide DATABASE_URL directly instead of the compose-built value,
# include connection_limit=20&pool_timeout=30 for small VPS deployments.
APP_HOST=app.itembagrouptz.com
API_HOST=api.itembagrouptz.com
WEBSITE_HOST=itembagrouptz.com
WEBSITE_WWW_HOST=www.itembagrouptz.com
FUELGRID_APP_HOST=fuelgrid.itembagrouptz.com
FUELGRID_API_HOST=api.fuelgrid.itembagrouptz.com
SHARED_EDGE_NETWORK=itemba_shared_edge
ACME_EMAIL=info@itembagrouptz.com

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@itembagrouptz.com

# External integration live smoke tests.
# Recommended deployment gate:
# npm run smoke:external-integrations:live -- --production
EXTERNAL_SMOKE_REQUIRE=LIVE,SMTP
EXTERNAL_SMOKE_EMAIL_TO=
EXTERNAL_SMOKE_SEND_EMAIL=true
# JSON array, for example:
# [{"name":"provider-health","url":"https://provider.example/health","expectedStatus":200}]
EXTERNAL_SMOKE_HTTP_TARGETS=

# Optional SMS and mobile-money provider credentials. These are passed through
# to the backend and/or smoke scripts only when real provider adapters are used.
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
TIGOPESA_USERNAME=
TIGOPESA_PASSWORD=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=

# Msaidizi stays disabled/read-only in the ordinary production deployment.
# Signed promotion is a separate workflow. If that workflow provisions an
# external file, set only its operator-owned HOST_PATH below; production Compose
# derives the immutable /run/... container path and mounts exactly that file
# read-only. Never put key or certificate contents in this env file.
# MSAIDIZI_PROVIDER_CONTRACT_ATTESTATION_HOST_PATH=/etc/itemba-r/msaidizi/provider-contract/attestation.json
# MSAIDIZI_PROVIDER_CONTRACT_PUBLIC_KEY_HOST_PATH=/etc/itemba-r/msaidizi/provider-contract/public.pem
# MSAIDIZI_ACTION_SIGNING_KEY_HOST_PATH=/etc/itemba-r/msaidizi/secrets/action-es256.pem
# MSAIDIZI_UPDATE_SIGNING_KEY_HOST_PATH=/etc/itemba-r/msaidizi/secrets/update-es256.pem
# MSAIDIZI_RECOVERY_SIGNING_KEY_HOST_PATH=/etc/itemba-r/msaidizi/secrets/recovery-es256.pem
# MSAIDIZI_EVALUATOR_KEY_ALLOWLIST_HOST_PATH=/etc/itemba-r/msaidizi/evaluator/keys.json
# MSAIDIZI_EVALUATOR_MTLS_SERVER_KEY_HOST_PATH=/etc/itemba-r/msaidizi/evaluator/server-key.pem
# MSAIDIZI_EVALUATOR_MTLS_SERVER_CERT_HOST_PATH=/etc/itemba-r/msaidizi/evaluator/server-cert.pem
# MSAIDIZI_EVALUATOR_MTLS_CLIENT_CA_HOST_PATH=/etc/itemba-r/msaidizi/evaluator/client-ca.pem
# MSAIDIZI_DIRECT_MTLS_SERVER_KEY_HOST_PATH=/etc/itemba-r/msaidizi/device/server-key.pem
# MSAIDIZI_DIRECT_MTLS_SERVER_CERT_HOST_PATH=/etc/itemba-r/msaidizi/device/server-cert.pem
# MSAIDIZI_DIRECT_MTLS_CLIENT_CA_HOST_PATH=/etc/itemba-r/msaidizi/device/client-ca.pem
# MSAIDIZI_DIRECT_MTLS_PORT=3443
# MSAIDIZI_DIRECT_MTLS_HOST_BIND_ADDRESS=127.0.0.1
# MSAIDIZI_DIRECT_MTLS_CONTAINER_BIND_ADDRESS=0.0.0.0
# Autonomous update rollout remains disabled unless the backend flag is enabled
# and this deployment-owned ceiling is set explicitly to 0, 5, 25, or 100.
# MSAIDIZI_UPDATE_AUTOMATIC_MAX_RING=-1
# MSAIDIZI_CRUD_EVIDENCE_HOST_PATH=/etc/itemba-r/msaidizi/evidence/crud-evidence.json
# MSAIDIZI_CRUD_EVIDENCE_PUBLIC_KEY_HOST_PATH=/etc/itemba-r/msaidizi/evidence/crud-evidence-public.pem
# The protected ring-promotion script writes the following release-specific
# host path and accepted coordinates into its immutable promotion.env. Do not
# hand-author them in the ordinary production environment.
# MSAIDIZI_PRODUCTION_PROMOTION_INVENTORY_HOST_PATH=/opt/itemba-msaidizi-releases/<accepted-inventory-sha256>/promotion-inventory.json
