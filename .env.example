# ─────────────────────────────────────────────────────────────
# ITEMBA-R Root Environment
# Copy to .env and fill in values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL (consumed by docker-compose)
POSTGRES_USER=itemba
POSTGRES_PASSWORD=itemba_dev_password
POSTGRES_DB=itemba_r
POSTGRES_PORT=5432
