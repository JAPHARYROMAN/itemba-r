# ─────────────────────────────────────────────────────────────
# ITEMBA-R Root Environment
# Optional: docker-compose.yml already defaults to these values, so you only
# need to copy this to .env to change them. backend/.env.example points at the
# defaults below (host port 5433), so keep the two in step.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL (consumed by docker-compose; local development only)
POSTGRES_USER=itemba
POSTGRES_PASSWORD=itemba_dev_password
POSTGRES_DB=itemba_r
# Host port for Postgres. To publish on loopback only, use 127.0.0.1:5433.
POSTGRES_PORT=5433
