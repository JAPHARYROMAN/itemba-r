{
	email {$ACME_EMAIL:info@itembagrouptz.com}
}

{$APP_HOST:app.itembagrouptz.com} {
	encode zstd gzip
	reverse_proxy frontend:3000
}

{$API_HOST:api.itembagrouptz.com} {
	encode zstd gzip
	reverse_proxy backend:3001
}

{$WEBSITE_HOST:itembagrouptz.com}, {$WEBSITE_WWW_HOST:www.itembagrouptz.com} {
	encode zstd gzip
	reverse_proxy website:3001
}

{$FUELGRID_APP_HOST:fuelgrid.itembagrouptz.com} {
	encode zstd gzip
	reverse_proxy fuelgrid-web:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$FUELGRID_API_HOST:api.fuelgrid.itembagrouptz.com} {
	encode zstd gzip
	reverse_proxy fuelgrid-api:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
